{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'install handled inside the build script (after vendoring)'",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "packages/scratch-gui/build",
  "framework": null,
  "headers": [
    {
      "source": "/chunks/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:name.:hash([0-9a-f]{8}).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/static/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/static/blocks-media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
