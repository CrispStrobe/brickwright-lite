<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- iOS-only keys. Tauri merges both `Info.plist` and `Info.ios.plist` from
       this directory into the generated iOS bundle plist; `Info.plist` carries
       the keys shared with macOS, this file carries what only iOS needs.

       These used to be applied by PlistBuddy inside .github/workflows/mobile.yml,
       which meant only CI builds had them — a local `tauri ios build`, or anyone
       opening gen/apple in Xcode, produced an app missing ATS and the MFi
       protocol list. Keeping them here makes every build identical.

       The usage strings are deliberately repeated from Info.plist rather than
       relied on: iOS kills the app outright on first camera/mic access if the
       string is absent, so it is worth being explicit rather than depending on
       merge order. -->

  <!-- The web VM's Scratch-Link client (scratch-link-websocket.js) dials
       ws://127.0.0.1:20111 for the local ScratchLink server, and bridge-mode
       hardware is reached over ws:// on the LAN. Both are cleartext, so ATS has
       to permit local networking or the sockets never open. Android needs the
       same thing via usesCleartextTraffic in its manifest. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <!-- Bluetooth Classic (RFCOMM) on iOS goes through MFi ExternalAccessory, and
       an accessory is invisible to EAAccessoryManager unless its protocol is
       declared here. These cover the EV3 and NXT; BLE hubs do not need this. -->
  <key>UISupportedExternalAccessoryProtocols</key>
  <array>
    <string>COM.LEGO.MINDSTORMS.EV3</string>
    <string>com.lego.les</string>
  </array>

  <!-- CoreBluetooth (btleplug / tauri-plugin-blec) permission prompt. -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Brickwright uses Bluetooth to connect to LEGO hubs (SPIKE, Boost, WeDo, Powered-Up, and more).</string>
  <key>NSBluetoothPeripheralUsageDescription</key>
  <string>Brickwright uses Bluetooth to connect to LEGO hubs (SPIKE, Boost, WeDo, Powered-Up, and more).</string>

  <!-- getUserMedia: Video Sensing (camera), the loudness/sound blocks and
       "record a sound" (microphone), and the Speech-to-Text extension. wry's
       WKWebView UI delegate grants the in-page request, but iOS still requires
       these strings or it terminates the app on first access. -->
  <key>NSCameraUsageDescription</key>
  <string>Brickwright uses the camera for the Video Sensing blocks and to let you photograph costumes.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Brickwright uses the microphone for the loudness/sound blocks and to record sounds.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Brickwright uses speech recognition for the Speech-to-Text extension.</string>
</dict>
</plist>
