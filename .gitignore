node_modules/
# the SLASHLESS form too: a node_modules SYMLINK is invisible to the
# trailing-slash rule, and one committed from a Mac (absolute target)
# broke CI's module census — the same trap bw-board fixed at de7c51e
node_modules
# Vendored permissive sources (populated by `npm run vendor`). Kept out of git initially;
# once you start editing a component, `git add -f packages/<name>` to own it in-tree.
packages/scratch-gui/
packages/scratch-vm/
packages/scratch-blocks/
packages/scratch-paint/
packages/scratch-render/
packages/scratch-audio/
packages/scratch-storage/
packages/scratch-svg-renderer/
build/
!overlay/scratch-gui/static/microbit-sim/build/
dist/
/tmp/
*.tgz
.vercel

# micro:bit firmware build outputs
out/

# Agent context (local only)
CLAUDE.md
.claude/
.last-run.json

# Gate output — screenshots, rendered schematic corpora. Written by
# scripts/verify-*.mjs and render-schematic.mjs, never an input to anything.
# Ignored specifically so it cannot be swept in by a `git add -A`: that is how
# a 21 MB wasm blob got committed in bw-board (LABWIRED-BRIDGE.md §7), and this
# directory now collects PNGs on every browser-gate run.
/artifacts/
