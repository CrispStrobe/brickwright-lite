# Spike Prime hub — offline virtual face.
#
# This is the in-app faceplate shown when no hub is connected. It
# visualizes the same device the spikeprime extension drives:
#   - 5x5 LED matrix (displayImage / displayText / setPixel)
#   - Motor on port A (getPosition / getSpeed / motorRunFor)
#   - Distance sensor on port D (getDistance)
#   - Color sensor on port C (getColor)
#
# A program written with the spikeprime extension blocks maps onto this
# face 1:1: the extension writes spike_display / spike_position_A /
# spike_distance_D / spike_color_C, and the face reads them.
#
# The matrix widget reads a 25-bit row-major bitmask (bit = row*5+col).
# The extension's displayImage uses a 25-char binary string internally;
# the program converts to a bitmask for the widget. On a real hub the
# runtime driver does this conversion.
#
# Variable naming matches the extension's block opcodes:
#   spike_display     <- displayImage (25-bit bitmask for the face)
#   spike_position_A  <- getPosition A (degrees, -180..180)
#   spike_distance_D  <- getDistance D (cm, 0..200)
#   spike_color_C     <- getColor C (Lego color ID 0..10)
#
# No DEVICE line: the Spike Prime dialect is not yet in the .bw compiler.
# When it lands, add DEVICE SPIKE_PRIME and replace variable writes with
# actual extension blocks. The face bindings stay identical.
#
# 5x5 bit layout (row-major, bit = row*5+col):
#   row 0: bits  0- 4  (top)
#   row 1: bits  5- 9
#   row 2: bits 10-14
#   row 3: bits 15-19
#   row 4: bits 20-24  (bottom)

# Precomputed display frames (25-bit bitmasks):
# Frame 0: heart      01101 11111 11111 01110 00100
# Frame 1: smiley     11111 10001 00000 10001 01110
# Frame 2: X          10001 01010 00100 01010 10001
# Frame 3: bar        00000 00000 11111 00000 00000
TABLE frames = 14679492, 33063470, 18157905, 31744

WHEN flag clicked:
  set variable spike_display to 0
  set variable spike_position_A to 0
  set variable spike_distance_D to 100
  set variable spike_color_C to 0
  set variable frame to 0
  set variable sweep to 0
  set variable sweep_dir to 3
  FOREVER:
    # Cycle display through 4 patterns (heart, smiley, X, bar)
    set variable spike_display to frames[frame mod 4]
    change frame by 1

    # Sweep motor A position: -180 -> +180 -> -180, step 3
    change sweep by sweep_dir
    IF sweep > 180 THEN:
      set variable sweep_dir to -3
      set variable sweep to 180
    IF sweep < -180 THEN:
      set variable sweep_dir to 3
      set variable sweep to -180
    set variable spike_position_A to sweep

    # Distance sensor D: triangle wave 10..190 cm
    set variable spike_distance_D to 100 + sweep * 90 / 180

    # Color sensor C: cycle through Lego color IDs 0..10
    # (0=black 1=magenta 2=violet 3=blue 4=cyan 5=green
    #  6=yellow 7=orange 8=red 9=white 10=none)
    set variable spike_color_C to frame mod 11

    wait 200 ms
