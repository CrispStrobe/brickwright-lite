DEVICE MICROBIT

# micro:bit radio demo — send a counter on button press
WHEN flag clicked:
  radio on group 1 power 6
  set variable count to 0
  show text "Ready"

WHEN flag clicked:
  FOREVER:
    if read button_a then
      change variable count by 1
      radio send number count
      show text count
      wait 0.3 seconds
