DEVICE STC12C5A60S2
CLOCK 11059200
PIN led0 = P1.0 OUTPUT ACTIVE LOW
PIN led1 = P1.1 OUTPUT ACTIVE LOW
PIN led2 = P1.2 OUTPUT ACTIVE LOW
PIN led3 = P1.3 OUTPUT ACTIVE LOW
PIN led4 = P1.4 OUTPUT ACTIVE LOW
PIN led5 = P1.5 OUTPUT ACTIVE LOW
PIN led6 = P1.6 OUTPUT ACTIVE LOW
PIN led7 = P1.7 OUTPUT ACTIVE LOW
PIN pot = P2.0 ANALOG INPUT

GLOBAL level

STAGE:
  # LED bargraph showcase: 8-LED level meter driven by a pot.
  WHEN flag clicked:
    FOREVER:
      set level to read pot / 128
      turn off led0
      turn off led1
      turn off led2
      turn off led3
      turn off led4
      turn off led5
      turn off led6
      turn off led7
      if level > 0
        turn on led0
      if level > 1
        turn on led1
      if level > 2
        turn on led2
      if level > 3
        turn on led3
      if level > 4
        turn on led4
      if level > 5
        turn on led5
      if level > 6
        turn on led6
      if level > 7
        turn on led7
      wait 0.1 seconds
