<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <meta name="description" content="Build with blocks, read and edit as Python or JavaScript, and drive real LEGO bricks and robots.">
    <meta name="theme-color" content="#22c3d6">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Brickwright">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="icon" type="image/svg+xml" href="static/images/brick-robot.svg">
    <link rel="apple-touch-icon" href="static/images/apple-touch-icon.png">
    <link rel="manifest" href="static/manifest.webmanifest">
    <title><%= htmlWebpackPlugin.options.title %></title>
  </head>
  <body>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('sw.js').catch(function () { /* PWA offline is best-effort */ });
        });
      }

      /* Recover from a stale build, once.
       *
       * The service worker now serves the document network-first, so a fresh
       * load always names the current entry. But a tab that was ALREADY open
       * across a deploy still holds the old entry in memory, and its lazy
       * imports point at chunk hashes the deploy removed. The user sees
       * "Loading chunk NNN failed" and no amount of clicking fixes it, because
       * the code doing the asking is the stale code.
       *
       * So: on a chunk-load failure, drop every cache, unregister the worker
       * and reload — exactly once per tab. The sessionStorage guard matters
       * more than it looks: without it, a chunk that is genuinely missing from
       * the server turns this into an infinite reload loop, which is a worse
       * failure than the one being fixed. Once is a recovery; twice is a bug we
       * would rather see reported. */
      (function () {
        var KEY = 'bw-chunk-recovery';
        function looksLikeStaleBuild(message) {
          return /Loading chunk \S+ failed|ChunkLoadError|error loading dynamically imported module/i.test(String(message || ''));
        }
        function recover(message) {
          if (!looksLikeStaleBuild(message)) return false;
          if (sessionStorage.getItem(KEY)) return false;   // already tried; let the error surface
          console.error('[bw-chunk-recovery] stale build detected, clearing caches and reloading. Trigger:', message);
          sessionStorage.setItem(KEY, '1');
          var done = function () { location.reload(); };
          Promise.resolve()
            .then(function () { return caches && caches.keys().then(function (k) { return Promise.all(k.map(function (n) { return caches.delete(n); })); }); })
            .then(function () {
              return navigator.serviceWorker && navigator.serviceWorker.getRegistrations()
                .then(function (rs) { return Promise.all(rs.map(function (r) { return r.unregister(); })); });
            })
            .then(done, done);
          return true;
        }
        window.addEventListener('error', function (e) { recover(e && e.message); });
        window.addEventListener('unhandledrejection', function (e) {
          recover(e && e.reason && (e.reason.message || e.reason));
        });

        /* Reachable by code that CATCHES its own import failure.
         *
         * The two listeners above only see failures nobody handled. A component
         * that does `await import(...)` inside a try/catch and renders its own
         * "failed to load" message is invisible to them — the rejection WAS
         * handled, so it is never unhandled. That is not hypothetical: it is
         * how "The circuit designer failed to load: Loading chunk 783 failed"
         * reached a user as a permanently dead panel while this recovery sat
         * here, correct and never called.
         *
         * Returns true if recovery started (the caller should show a reloading
         * state, not an error), false if this is not a stale build or the
         * one-shot is already spent. */
        window.__bwRecoverFromStaleBuild = recover;
      }());
    </script>
  </body>
</html>
