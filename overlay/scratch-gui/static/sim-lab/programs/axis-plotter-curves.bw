# Axis Plotter — original-curves
# Reset Robot Lab to the supplied model pose before starting a new plot.
# Targets are unwrapped encoder angles; each move reads fresh feedback.
# The motor controllers determine completion. Waits only settle the pen.
# A missed target greater than 2 degrees holds all motors and stops the plot.
DEVICE SPIKE

WHEN flag clicked:
  lab start
  lab stop motor A hold
  lab stop motor B hold
  lab stop motor C hold
  # 1. Pen up
  broadcast "axis plotter phase 00001" and wait
  # 2. Let pen settle
  wait 0.15 seconds
  # 3. Travel with pen up
  broadcast "axis plotter phase 00003" and wait
  # 4. Pen down
  broadcast "axis plotter phase 00004" and wait
  # 5. Let pen settle
  wait 0.15 seconds
  # 6. Draw
  broadcast "axis plotter phase 00006" and wait
  # 7. Draw
  broadcast "axis plotter phase 00007" and wait
  # 8. Draw
  broadcast "axis plotter phase 00008" and wait
