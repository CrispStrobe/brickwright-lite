# ORION — Double Cardan joint laboratory.
# Open orion-cardan.ldr in Robot Lab, select Plain, Reset, then Run.
# Motor A drives the input. The two remaining shafts are passive bodies.
# Compare the intermediate shaft's speed ripple with the restored output.
# The full sequence includes both directions, a restart, and input return.
# Requested waits are nominal; actual Scratch scheduling is recorded separately.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL stage
GLOBAL driveSpeed
GLOBAL inputEncoder
GLOBAL measuredMotorSpeed
GLOBAL returnDegrees

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set driveSpeed to 0
  set inputEncoder to 0
  set measuredMotorSpeed to 0
  set returnDegrees to 0
  IF ((lab status) = "no-model") or ((lab status) = "not-open") THEN:
    set failed to 1
    say "Open Orion in Robot Lab, select Plain, then Reset and Run."
    stop all
  lab start
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 3 THEN:
    set failed to 1
    say "Reset the complete Orion model before this demonstration."
    stop all
  reset timer
  broadcast "Orion observe"
  broadcast "Orion watchdog"
  set stage to 1
  say "Rest: compare the three shaft markers."
  wait 3 seconds
  set stage to 2
  say "Changing input speed gradually."
  repeat 12:
    change driveSpeed by 15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 180
  lab run motor A at driveSpeed degrees per second
  set stage to 3
  say "Forward: the intermediate shaft pulses; the output stays even."
  wait 8 seconds
  set stage to 4
  say "Changing input speed gradually."
  repeat 8:
    change driveSpeed by 15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 300
  lab run motor A at driveSpeed degrees per second
  set stage to 5
  say "Faster forward: compare the same speed-ripple relationship."
  wait 8 seconds
  set stage to 6
  say "Changing input speed gradually."
  repeat 8:
    change driveSpeed by -15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 180
  lab run motor A at driveSpeed degrees per second
  set stage to 7
  say "Forward medium again: the joint relationship repeats."
  wait 8 seconds
  set stage to 8
  say "Changing input speed gradually."
  repeat 12:
    change driveSpeed by -15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 0
  lab stop motor A hold
  set stage to 9
  say "Rest before reversing the input."
  wait 3 seconds
  set stage to 10
  say "Changing input speed gradually."
  repeat 12:
    change driveSpeed by -15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to -180
  lab run motor A at driveSpeed degrees per second
  set stage to 11
  say "Reverse: the same pair of joints carries motion backward."
  wait 8 seconds
  set stage to 12
  say "Changing input speed gradually."
  repeat 12:
    change driveSpeed by 15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 0
  lab stop motor A hold
  set stage to 13
  say "Rest before the forward restart."
  wait 3 seconds
  set stage to 14
  say "Changing input speed gradually."
  repeat 12:
    change driveSpeed by 15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 180
  lab run motor A at driveSpeed degrees per second
  set stage to 15
  say "Restart: compare the intermediate and output shafts again."
  wait 8 seconds
  set stage to 16
  say "Changing input speed gradually."
  repeat 12:
    change driveSpeed by -15
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 0
  lab stop motor A hold
  set stage to 17
  say "Stop before returning the input to its starting angle."
  wait 3 seconds
  set stage to 18
  say "Returning the input through the same joints."
  set returnDegrees to (0 - (lab motor A angle))
  lab run motor A for returnDegrees degrees at 180 degrees per second
  lab stop motor A hold
  wait 1 seconds
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "The input return did not finish. Inspect the model and Reset."
    stop all
  set stage to 19
  say "Final rest: all three shaft markers return."
  wait 3 seconds
  set completed to 1
  say "Orion complete: ripple, cancellation, reverse, restart and return. Reset to repeat."

WHEN I receive "Orion observe":
  repeat until completed = 1:
    set inputEncoder to (lab motor A angle)
    set measuredMotorSpeed to (lab motor A speed)
    wait 0.05 seconds

WHEN I receive "Orion watchdog":
  repeat until completed = 1:
    IF timer > 180 THEN:
      set failed to 1
      lab stop motor A hold
      say "Orion stopped after its time limit. Inspect the model and Reset."
      stop all
    wait 0.05 seconds
