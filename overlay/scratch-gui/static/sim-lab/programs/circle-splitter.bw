// Circle Splitter: a fixed sun and two carried gears split a circle into two straight strokes.
// Only the stationary Motor A drives the carrier through a real20T/60T mesh.
// Passive planet phase and both visible tips are independently observed.
// Record five seconds of free coast, then explicitly home with a fresh encoder.
DEVICE SPIKE

WHEN flag clicked:
  set complete to 0
  set fault to 0
  set phase to 0
  set moving to 0
  set targetA to 0
  set speedA to 60
  set coastAngle to 0
  reset timer
  broadcast "Circle watchdog"
  lab start
  wait 5 seconds
  set coastAngle to (lab motor A angle)
  set moving to 1
  set phase to -1
  set targetA to 0
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 1: carrier increment 90 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 1
  set targetA to 270
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 2: carrier increment 180 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 2
  set targetA to 540
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 3: carrier increment 270 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 3
  set targetA to 810
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 4: carrier increment 360 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 4
  set targetA to 1080
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 5: carrier increment 270 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 5
  set targetA to 810
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 6: carrier increment 180 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 6
  set targetA to 540
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 7: carrier increment 90 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 7
  set targetA to 270
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 8: carrier increment 0 degrees from its authored reference, at 20 degrees/second.
  set moving to 1
  set phase to 8
  set targetA to 0
  set speedA to 60
  broadcast "Position Circle input" and wait
  // Hold 9: carrier increment 90 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 9
  set targetA to 270
  set speedA to 90
  broadcast "Position Circle input" and wait
  // Hold 10: carrier increment 180 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 10
  set targetA to 540
  set speedA to 90
  broadcast "Position Circle input" and wait
  // Hold 11: carrier increment 270 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 11
  set targetA to 810
  set speedA to 90
  broadcast "Position Circle input" and wait
  // Hold 12: carrier increment 360 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 12
  set targetA to 1080
  set speedA to 90
  broadcast "Position Circle input" and wait
  // Hold 13: carrier increment 270 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 13
  set targetA to 810
  set speedA to 90
  broadcast "Position Circle input" and wait
  // Hold 14: carrier increment 180 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 14
  set targetA to 540
  set speedA to 90
  broadcast "Position Circle input" and wait
  // Hold 15: carrier increment 90 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 15
  set targetA to 270
  set speedA to 90
  broadcast "Position Circle input" and wait
  // Hold 16: carrier increment 0 degrees from its authored reference, at 30 degrees/second.
  set moving to 1
  set phase to 16
  set targetA to 0
  set speedA to 90
  broadcast "Position Circle input" and wait
  set complete to 1

WHEN I receive "Position Circle input":
  set moving to 1
  lab run motor A for (targetA - (lab motor A angle)) degrees at speedA degrees per second
  lab stop motor A hold
  wait 0.25 seconds
  if (abs of ((lab motor A angle) - targetA)) > 0.5 then:
    set fault to 1
    stop all
  set moving to 0
  wait 0.5 seconds

WHEN I receive "Circle watchdog":
  repeat until complete = 1:
    if timer > 95 then:
      set fault to 1
      lab stop motor A hold
      stop all
    wait 0.02 seconds
