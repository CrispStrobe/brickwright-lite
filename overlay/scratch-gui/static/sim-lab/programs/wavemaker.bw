# WaveMaker — extract the ripple
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Bounded-feedback structure adapted from original Concertina/SineShuttle/TwinTempo.
# Generated by build/build_program.py from the frozen experiment config.
# Config SHA-256: e29facdcf328c2f7352ec8b447f897c709cc120b4019262530ebe2f0563bdbc7
# Model SHA-256: 630832507bda4faf28d875996b5d98d37b723c9bbeeab555499c5b405c392d6e
# One SPIKE hub and motor A; the Cardan branches, carrier and pointer are passive.
# Robot Lab simulation code, not SPIKE hardware firmware.
# Load the matching LDR and manually Reset before a fresh experiment.
# Absolute unwrapped A targets: 0 -> 720 -> 1440 -> 0 degrees.
# Positive speed magnitudes; direction comes from target minus fresh encoder angle.
# Main leg speeds: 30, 60, 60 degrees/s.
# Two input turns contain four predicted pointer cycles; the output is not commanded.
# Startup: strict saved-datum admission; no recovery motion.
# Input envelope: -5 through 1445 degrees.
# Stage 0 verifies datum; 1 slow, 2 fast, 3 reverse, 4 complete.
# homed=1 only after the guarded 0.5 s datum hold; settled=0 in motion.
# settled=1 marks a guarded hold, not independent proof of mechanical settling.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL settled = 0
GLOBAL homed = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL targetA = 0
GLOBAL speedA = 30
GLOBAL correctionAttempts = 0

WHEN flag clicked:
  set stage to 0
  set settled to 0
  set homed to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set speedA to 30
  set correctionAttempts to 0
  reset timer
  lab start
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    say "WaveMaker is outside its saved-start allowance. Reset before running."
    stop all
  broadcast "WaveMaker watchdog"
  broadcast "WaveMaker verified hold" and wait
  set homed to 1
  set settled to 0
  set stage to 1
  set targetA to 720
  set speedA to 30
  broadcast "WaveMaker move" and wait
  broadcast "WaveMaker verified hold" and wait
  set settled to 0
  set stage to 2
  set targetA to 1440
  set speedA to 60
  broadcast "WaveMaker move" and wait
  broadcast "WaveMaker verified hold" and wait
  set settled to 0
  set stage to 3
  set targetA to 0
  set speedA to 60
  broadcast "WaveMaker move" and wait
  broadcast "WaveMaker verified hold" and wait
  lab stop motor A hold
  set stage to 4
  set settled to 1
  set completed to 1
  say "WaveMaker complete: compare pointer rocking, speed and the correctly phased control."

WHEN I receive "WaveMaker move":
  set settled to 0
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at (speedA) degrees per second
  lab stop motor A hold
  set correctionAttempts to 0
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      change correctionAttempts by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 12 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  broadcast "WaveMaker arrival guard" and wait

WHEN I receive "WaveMaker verified hold":
  broadcast "WaveMaker arrival guard" and wait
  set settled to 1
  wait 0.5 seconds
  broadcast "WaveMaker arrival guard" and wait
  set settled to 0

WHEN I receive "WaveMaker arrival guard":
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    set settled to 0
    lab stop motor A hold
    set failed to 1
    say "WaveMaker missed or drifted from its encoder target. Inspect and reset."
    stop all

WHEN I receive "WaveMaker watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 90 THEN:
      set settled to 0
      lab stop motor A hold
      set failed to 1
      say "WaveMaker: 90 second watchdog stopped the experiment. Reset before retrying."
      stop all
    wait 0.1 seconds
