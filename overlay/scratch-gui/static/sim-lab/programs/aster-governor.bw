# ASTER — Centrifugal governor.
# Open aster-governor.ldr in Robot Lab, select Plain, Reset, then Run.
# Motor A turns the spindle. Flyweights and collar are passive stock bodies.
# Slow input ramps demonstrate gravity/inertia response at three speeds,
# decreasing speed, a medium-speed restart, and gravity return.
# A requested wait is nominal: actual Scratch scheduling is recorded separately.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL stage
GLOBAL driveSpeed
GLOBAL spindleEncoder
GLOBAL measuredMotorSpeed

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set driveSpeed to 0
  set spindleEncoder to 0
  set measuredMotorSpeed to 0
  IF ((lab status) = "no-model") or ((lab status) = "not-open") THEN:
    set failed to 1
    say "Open Aster in Robot Lab, select Plain, then Reset and Run."
    stop all
  lab start
  lab stop motor A hold
  reset timer
  broadcast "Aster observe"
  broadcast "Aster watchdog"
  set stage to 1
  say "Rest: gravity draws the flyweights inward."
  wait 6 seconds
  set stage to 2
  say "Changing spindle speed gradually."
  repeat 135:
    change driveSpeed by 5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 675
  lab run motor A at driveSpeed degrees per second
  set stage to 3
  say "Low speed: observe the collar."
  wait 5 seconds
  set stage to 4
  say "Changing spindle speed gradually."
  repeat 10:
    change driveSpeed by 5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 725
  lab run motor A at driveSpeed degrees per second
  set stage to 5
  say "Medium speed: watch the weights move outward."
  wait 5 seconds
  set stage to 6
  say "Changing spindle speed gradually."
  repeat 15:
    change driveSpeed by 5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 800
  lab run motor A at driveSpeed degrees per second
  set stage to 7
  say "High speed: maximum demonstrated deployment."
  wait 5 seconds
  set stage to 8
  say "Changing spindle speed gradually."
  repeat 15:
    change driveSpeed by -5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 725
  lab run motor A at driveSpeed degrees per second
  set stage to 9
  say "Medium speed again: decreasing speed."
  wait 5 seconds
  set stage to 10
  say "Changing spindle speed gradually."
  repeat 10:
    change driveSpeed by -5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 675
  lab run motor A at driveSpeed degrees per second
  set stage to 11
  say "Low speed again: decreasing speed."
  wait 5 seconds
  set stage to 12
  say "Changing spindle speed gradually."
  repeat 135:
    change driveSpeed by -5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 0
  lab stop motor A hold
  set stage to 13
  say "Rest: gravity returns the collar."
  wait 6 seconds
  set stage to 14
  say "Changing spindle speed gradually."
  repeat 145:
    change driveSpeed by 5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 725
  lab run motor A at driveSpeed degrees per second
  set stage to 15
  say "Restart at medium speed: observe repeatable deployment."
  wait 5 seconds
  set stage to 16
  say "Changing spindle speed gradually."
  repeat 145:
    change driveSpeed by -5
    lab run motor A at driveSpeed degrees per second
    wait 0.1 seconds
  set driveSpeed to 0
  lab stop motor A hold
  set stage to 17
  say "Final rest: the passive mechanism returns."
  wait 6 seconds
  set completed to 1
  say "Aster complete: speed response, repeatability and gravity return. Reset to repeat."

WHEN I receive "Aster observe":
  repeat until completed = 1:
    set spindleEncoder to (lab motor A angle)
    set measuredMotorSpeed to (lab motor A speed)
    wait 0.05 seconds

WHEN I receive "Aster watchdog":
  repeat until completed = 1:
    IF timer > 180 THEN:
      set failed to 1
      lab stop motor A hold
      say "Aster stopped after its time limit. Inspect the model and Reset."
      stop all
    wait 0.05 seconds
