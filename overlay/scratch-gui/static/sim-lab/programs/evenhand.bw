# Evenhand — two independent joints, nine held configurations.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Load a complete fresh model before each comparison. Same source for both scenes.
# A is the shoulder; B is the elbow. All targets are actual relative joint angles.
# Counterweights cancel gravity mechanically. This program only requests poses.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL targetB = 0
GLOBAL stage = 0
GLOBAL phase = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL arrivals = 0
GLOBAL hold_start = 0
GLOBAL hold_end = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set phase to 0
  set arrivals to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Load Evenhand before running. Reload the complete scene for each comparison."
    stop all
  lab stop motor A hold
  lab stop motor B hold
  set motor stop action A hold
  set motor stop action B hold
  lab start
  reset timer
  broadcast "Evenhand watchdog"
  IF (abs of (lab motor A angle)) > 3 THEN:
    broadcast "Evenhand fault" and wait
  IF (abs of (lab motor B angle)) > 3 THEN:
    broadcast "Evenhand fault" and wait
  set targetA to 0
  set targetB to 0
  broadcast "Evenhand pose" and wait
  say "The same arm visits nine poses. Watch the two counterweights rise as the links fall."
  set stage to 1
  set targetA to -20
  set targetB to -30
  broadcast "Evenhand pose" and wait
  set stage to 2
  set targetA to -20
  set targetB to 0
  broadcast "Evenhand pose" and wait
  set stage to 3
  set targetA to -20
  set targetB to 30
  broadcast "Evenhand pose" and wait
  set stage to 4
  set targetA to 0
  set targetB to 30
  broadcast "Evenhand pose" and wait
  set stage to 5
  set targetA to 0
  set targetB to 0
  broadcast "Evenhand pose" and wait
  set stage to 6
  set targetA to 0
  set targetB to -30
  broadcast "Evenhand pose" and wait
  set stage to 7
  set targetA to 20
  set targetB to -30
  broadcast "Evenhand pose" and wait
  set stage to 8
  set targetA to 20
  set targetB to 0
  broadcast "Evenhand pose" and wait
  set stage to 9
  set targetA to 20
  set targetB to 30
  broadcast "Evenhand pose" and wait
  set stage to 10
  set targetA to 0
  set targetB to 0
  broadcast "Evenhand pose" and wait
  lab stop motor A hold
  lab stop motor B hold
  set phase to 3
  set completed to 1
  say "Nine poses and return complete. Reload the comparison model to move the same weights inward."

WHEN I receive "Evenhand pose":
  set phase to 1
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 20 degrees per second
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "Evenhand fault" and wait
  IF (abs of (targetB - (lab motor B angle))) > 0.1 THEN:
    lab run motor B for (targetB - (lab motor B angle)) degrees at 25 degrees per second
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "Evenhand fault" and wait
  IF (abs of (targetB - (lab motor B angle))) > 1 THEN:
    broadcast "Evenhand fault" and wait
  set phase to 2
  set hold_start to (timer)
  wait 1.2 seconds
  set hold_end to (timer)
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "Evenhand fault" and wait
  IF (abs of (targetB - (lab motor B angle))) > 1 THEN:
    broadcast "Evenhand fault" and wait
  change arrivals by 1
  set phase to 0

WHEN I receive "Evenhand watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 50 THEN:
      broadcast "Evenhand fault" and wait
    IF (abs of (lab motor A angle)) > 27 THEN:
      broadcast "Evenhand fault" and wait
    IF (abs of (lab motor B angle)) > 38 THEN:
      broadcast "Evenhand fault" and wait
    wait 0.02 seconds

WHEN I receive "Evenhand fault":
  set failed to 1
  lab stop motor A hold
  lab stop motor B hold
  say "Pose guard or watchdog failed. Reload the saved Evenhand model."
  stop all
