# Equal Share - a passive whippletree sharing unequal spring loads.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Only motor A moves the common centre pivot. The equalizer and shocks are passive.
# Absolute input route: 15,25,35,15,0 degrees; positive angles compress the shocks.
# Fresh encoder deltas, bounded slow corrections, five 2-second held dwells,
# an 80-second watchdog, motor envelope [-3,38] degrees, and final hold.
# Automatic move completion must hold against the springs between VM frames.
# Start with Robot Lab's Run button, which connects this model's virtual SPIKE.
# Native Robot Lab experiment; not downloadable physical-hub firmware.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL stage = 0
GLOBAL dwelling = 0
GLOBAL arrivals = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set targetA to 0
  set stage to 0
  set dwelling to 0
  set arrivals to 0
  set completed to 0
  set failed to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Import Equal Share in Robot Lab before running."
    stop all
  reset timer
  lab start
  set motor stop action A hold
  lab stop motor A hold
  wait 0.25 seconds
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Reload the saved Equal Share pose before running."
    stop all
  broadcast "Equal Share watchdog"
  set stage to 1
  set targetA to 15
  broadcast "Equal Share stage" and wait
  set stage to 2
  set targetA to 25
  broadcast "Equal Share stage" and wait
  set stage to 3
  set targetA to 35
  broadcast "Equal Share stage" and wait
  set stage to 4
  set targetA to 15
  broadcast "Equal Share stage" and wait
  set stage to 5
  set targetA to 0
  broadcast "Equal Share stage" and wait
  lab stop motor A hold
  set stage to 6
  set completed to 1
  say "Complete: compare the held shock compressions and the return to zero."

WHEN I receive "Equal Share stage":
  set dwelling to 0
  IF (abs of (targetA - (lab motor A angle))) > 40 THEN:
    set failed to 1
    lab stop motor A hold
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 0.001 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 8 degrees per second
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      lab run motor A for (targetA - (lab motor A angle)) degrees at 2 degrees per second
      wait 0.05 seconds
  lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The crank did not reach its target. Inspect and reload."
    stop all
  set dwelling to 1
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    set dwelling to 0
    lab stop motor A hold
    say "The held crank drifted. Inspect and reload."
    stop all
  change arrivals by 1
  set dwelling to 0

WHEN I receive "Equal Share watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 80 THEN:
      set failed to 1
      set dwelling to 0
      lab stop motor A hold
      say "80 second watchdog: crank stopped and holding. Reload before retrying."
      stop all
    IF (lab motor A angle) > 38 THEN:
      set failed to 1
      set dwelling to 0
      lab stop motor A hold
      stop all
    IF (lab motor A angle) < -3 THEN:
      set failed to 1
      set dwelling to 0
      lab stop motor A hold
      stop all
    wait 0.05 seconds
