# Spiral Scribe — one motor makes the arm turn and the rack feed outward.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Bounded feedback idiom adapted from the BSD-3-Clause SineShuttle example.
# Robot Lab simulation program; this file is not SPIKE hardware firmware.
# Load the matching LDR at its saved pose before starting. No scene reset here.
# A: stationary carrier drive, 20T:60T. Negative encoder turns feed outward.
# Saved datum: A=0, marker radius56.5mm. 24T sun/24T planet,12T rack pinion.
# Each -1080-degree input excursion gives one carrier turn and37.699mm feed.
# Run one slow and one faster excursion; return to datum after each.
# Targets[-1080,0]; qualified envelope[-1085,5]; these are not physical stops.
# Fresh unwrapped encoder feedback, at most two trims, finite90s watchdog.
DEVICE SPIKE
GLOBAL phase = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL targetA = 0
GLOBAL speedA = 60
GLOBAL cycle = 0
GLOBAL trims = 0

WHEN flag clicked:
  set phase to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set cycle to 0
  reset timer
  lab start
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    say "Load Spiral Scribe at its saved pose before running."
    stop all
  broadcast "Spiral watchdog"
  REPEAT 2:
    change cycle by 1
    set speedA to (60 * cycle)
    set targetA to 0
    REPEAT 4:
      change phase by 1
      change targetA by -270
      broadcast "Spiral move" and wait
      wait 0.4 seconds
      broadcast "Spiral arrival" and wait
    change phase by 1
    set targetA to 0
    set speedA to 120
    broadcast "Spiral move" and wait
    wait 0.4 seconds
    broadcast "Spiral arrival" and wait
  lab stop motor A hold
  set completed to 1
  say "Spiral Scribe complete. Compare the two speeds and the measured radial feed."

WHEN I receive "Spiral move":
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at (speedA) degrees per second
  lab stop motor A hold
  set trims to 0
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      change trims by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 12 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  broadcast "Spiral arrival" and wait

WHEN I receive "Spiral arrival":
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "Spiral Scribe missed its encoder target. Inspect the mechanism and reload."
    stop all

WHEN I receive "Spiral watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 90 THEN:
      lab stop motor A hold
      set failed to 1
      say "Spiral Scribe watchdog stopped the experiment. Reload before retrying."
      stop all
    wait 0.1 seconds
