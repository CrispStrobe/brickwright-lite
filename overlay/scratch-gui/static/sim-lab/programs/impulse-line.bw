# Impulse Line - passive contact transmission through three pendulums.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Motor A operates a separate coaxial pusher; every pendulum is passive.
# Saved pusher geometry is +30 degrees and its native encoder datum is zero.
# A=-24.5423968763 degrees preloads the first bob to about -12 degrees by real contact.
# Returning A to zero withdraws the pusher; the bob response is not commanded.
# A bounded 25% duty lead-in overcomes the short move's normal acceleration ramp.
# Run with Robot Lab's toolbar Run, which connects the same virtual SPIKE hub.
# Native experiment only; this file is not physical-hub firmware.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL speedA = 0
GLOBAL stage = 0
GLOBAL loaded = 0
GLOBAL released = 0
GLOBAL observing = 0
GLOBAL arrivals = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL pulsing = 0
GLOBAL pulseStarted = 0

WHEN flag clicked:
  set targetA to 0
  set speedA to 0
  set stage to 0
  set loaded to 0
  set released to 0
  set observing to 0
  set arrivals to 0
  set completed to 0
  set failed to 0
  set pulsing to 0
  set pulseStarted to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Import Impulse Line in Robot Lab before running."
    stop all
  reset timer
  lab start
  set motor stop action A hold
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Reload the saved Impulse Line pose before running."
    stop all
  broadcast "Impulse Line watchdog"
  set stage to 1
  set targetA to -24.5423968763
  set speedA to 15
  broadcast "Impulse Line move" and wait
  set stage to 2
  set loaded to 1
  wait 0.5 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The preload drifted. Inspect and reload."
    stop all
  set loaded to 0
  set released to 1
  set observing to 1
  set stage to 3
  set targetA to 0
  set speedA to 300
  set pulseStarted to (timer)
  set pulsing to 1
  start motor A at 25 % power
  REPEAT UNTIL (lab motor A angle) > -21:
    IF ((timer) - pulseStarted) > 0.10 THEN:
      set failed to 1
      lab stop motor A hold
      say "Withdrawal pulse timed out. Inspect and reload."
      stop all
    wait 0.001 seconds
  IF ((timer) - pulseStarted) > 0.10 THEN:
    set failed to 1
    lab stop motor A hold
    say "Withdrawal pulse exceeded its time bound. Inspect and reload."
    stop all
  set pulsing to 0
  broadcast "Impulse Line move" and wait
  set stage to 4
  wait 2 seconds
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    say "The pusher did not remain home. Inspect and reload."
    stop all
  set observing to 0
  set stage to 5
  set completed to 1
  say "Complete: the pusher is held home; passive bobs may still ring down."

WHEN I receive "Impulse Line move":
  IF (abs of (targetA - (lab motor A angle))) > 35 THEN:
    set failed to 1
    lab stop motor A hold
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 0.001 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at (speedA) degrees per second
  wait 0.1 seconds
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.25 THEN:
      lab run motor A for (targetA - (lab motor A angle)) degrees at 2 degrees per second
      wait 0.1 seconds
  lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    set failed to 1
    say "The pusher did not reach its target. Inspect and reload."
    stop all
  change arrivals by 1

WHEN I receive "Impulse Line watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 20 THEN:
      set failed to 1
      lab stop motor A hold
      say "20 second watchdog: pusher stopped and holding. Reload before retrying."
      stop all
    IF (lab motor A angle) > 2 THEN:
      set failed to 1
      lab stop motor A hold
      stop all
    IF (lab motor A angle) < -27 THEN:
      set failed to 1
      lab stop motor A hold
      stop all
    wait 0.05 seconds
