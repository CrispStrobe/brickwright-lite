# TwistSpan — two fixed cords and one freely twisting payload.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Load either saved TwistSpan model afresh before each run.
# A moves only the yellow upper bar. The orange payload is never actuated.
# Stage 1 holds the upper bar at 20 degrees for 18 seconds of free oscillation.
# Stage 2 returns A to zero slowly; the passive payload may keep ringing down.
# Fresh target-minus-unwrapped-encoder moves; degrees/second, not percent.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL speedA = 60
GLOBAL stage = 0
GLOBAL held = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set held to 0
  IF (lab status) = "no-model" THEN:
    say "Load TwistSpan or its inner-tie comparison before starting."
    stop all
  lab start
  lab stop motor A hold
  reset timer
  broadcast "TwistSpan watchdog"
  wait 1 seconds
  IF (abs of (lab motor A angle)) > 1 THEN:
    broadcast "TwistSpan fault" and wait
  set stage to 1
  set targetA to 20
  set speedA to 60
  say "Upper bar holds 20 degrees. Count the orange beam's free twists."
  broadcast "TwistSpan move" and wait
  wait 18 seconds
  IF (abs of (20 - (lab motor A angle))) > 1 THEN:
    broadcast "TwistSpan fault" and wait
  set stage to 2
  set targetA to 0
  set speedA to 10
  broadcast "TwistSpan move" and wait
  wait 6 seconds
  IF (abs of (lab motor A angle)) > 1 THEN:
    broadcast "TwistSpan fault" and wait
  set completed to 1
  say "Complete. A holds zero; the passive beam is free to keep ringing down."

WHEN I receive "TwistSpan move":
  set held to 0
  IF (abs of (lab motor A angle)) > 23 THEN:
    broadcast "TwistSpan fault" and wait
  IF (abs of (targetA - (lab motor A angle))) > 22 THEN:
    broadcast "TwistSpan fault" and wait
  lab run motor A for (targetA - (lab motor A angle)) degrees at speedA degrees per second
  lab stop motor A hold
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      lab run motor A for (targetA - (lab motor A angle)) degrees at 8 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "TwistSpan fault" and wait
  set held to 1

WHEN I receive "TwistSpan watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 40 THEN:
      broadcast "TwistSpan fault" and wait
    wait 0.05 seconds

WHEN I receive "TwistSpan fault":
  set failed to 1
  set held to 0
  lab stop motor A hold
  say "Input guard or 40-second watchdog failed. Reload the saved pose."
  stop all
