# Watt's Line — an approximate straight-line linkage.
# Original program, Copyright (c) 2026 CrispStrobe.
# SPDX-License-Identifier: BSD-3-Clause
# Import the supplied watt-line.ldr before running. Reset/reload its saved pose
# before rerunning after manual movement. The starting encoder datum is zero.
# One input on A. The coupler midpoint is passive; this program never places it.
# Two finite cycles: 0 -> +20 -> -20 -> 0 degrees, then hold at datum.
# Speeds are degrees per second. Motor targets use fresh unwrapped feedback.
# Nominal motion time is 13 1/3 seconds; the complete experiment has a 40 s guard.
# GLOBAL stage identifies six commanded moves; completed=1 only on success.
# Up to two slow feedback corrections are allowed at each target.
# Bounded moves finish in the native controller's brake mode. Allow that mode
# between moves; an immediate hold command caused a reversal transient in testing.
# Arrival and post-settling encoder checks prove completion. Final mode is hold.
# This is a Robot Lab simulation program, not hardware firmware.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set targetA to 0
  set stage to 0
  set completed to 0
  set failed to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Import Watt's Line in Robot Lab before running."
    stop all
  reset timer
  lab start
  lab stop motor A hold
  wait 0.25 seconds
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    say "Saved datum failed. Reset or reload Watt's Line and check port A."
    lab stop motor A hold
    stop all
  broadcast "Watt watchdog"
  REPEAT 2:
    change stage by 1
    set targetA to 20
    broadcast "Watt move A" and wait
    change stage by 1
    set targetA to -20
    broadcast "Watt move A" and wait
    change stage by 1
    set targetA to 0
    broadcast "Watt move A" and wait
  lab stop motor A hold
  set stage to 7
  set completed to 1
  say "Complete: two sweeps, midpoint observed, input datum held."

WHEN I receive "Watt move A":
  IF (abs of (targetA - (lab motor A angle))) > 0.001 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 12 degrees per second
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.4 THEN:
      lab run motor A for (targetA - (lab motor A angle)) degrees at 3 degrees per second
      wait 0.05 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "Motor A missed its target. Inspect the linkage and reset."
    stop all
  wait 0.4 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "Motor A did not retain its target. Inspect the linkage and reset."
    stop all

WHEN I receive "Watt watchdog":
  REPEAT UNTIL (completed = 1):
    IF (abs of (lab motor A angle)) > 21 THEN:
      set failed to 1
      lab stop motor A hold
      say "Input exceeded its permitted experiment range. Inspect and reset."
      stop all
    IF (timer) > 40 THEN:
      set failed to 1
      lab stop motor A hold
      say "40 second watchdog: stopped and holding. Inspect and reset."
      stop all
    wait 0.05 seconds
