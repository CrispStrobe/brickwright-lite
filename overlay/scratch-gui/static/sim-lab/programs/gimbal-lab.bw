DEVICE SPIKE
# Gimbal Lab — CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Import/reset the supplied model first. Native lab speeds are degrees/s.
# A yaw; B pitch; C roll. The supplied bearing topology makes positive motor B positive geometric pitch.
# At B=+90, A=+20 and C=-20 cancel at the physical marker.
# Finite commands move real hinges. No frame or output pose is assigned.
GLOBAL targetA = 0
GLOBAL targetB = 0
GLOBAL targetC = 0
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set stage to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set targetB to 0
  set targetC to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Import Gimbal Lab into Robot Lab first."
    stop all
  lab start
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    say "Reset the model to its saved pose before running."
    stop all
  lab stop motor B hold
  IF (abs of (lab motor B angle)) > 1 THEN:
    set failed to 1
    say "Reset the model to its saved pose before running."
    stop all
  lab stop motor C hold
  IF (abs of (lab motor C angle)) > 1 THEN:
    set failed to 1
    say "Reset the model to its saved pose before running."
    stop all
  reset timer
  broadcast "Gimbal watchdog"
  set stage to 1010
  set targetA to 0
  set targetB to 0
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 10
  say "Three independent axes: yaw and roll point in different directions."
  wait 1.5 seconds
  set stage to 1011
  set targetA to 20
  set targetB to 0
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 11
  say "Yaw alone: the whole cradle turns."
  wait 1.5 seconds
  set stage to 1012
  set targetA to 0
  set targetB to 0
  set targetC to -20
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 12
  say "Roll alone: only the coloured marker turns."
  wait 1.5 seconds
  set stage to 1020
  set targetA to 0
  set targetB to 60
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 20
  say "Middle tilt 60 degrees: the outer and inner axes approach alignment."
  wait 1.5 seconds
  set stage to 1021
  set targetA to 20
  set targetB to 60
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 21
  say "Yaw still moves the full tilted cradle."
  wait 1.5 seconds
  set stage to 1022
  set targetA to 0
  set targetB to 60
  set targetC to -20
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 22
  say "Roll is now closer to yaw, but the axes remain independent."
  wait 1.5 seconds
  set stage to 1030
  set targetA to 0
  set targetB to 90
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 30
  say "Middle tilt 90 degrees: the first and third axes align."
  wait 1.5 seconds
  set stage to 1031
  set targetA to 20
  set targetB to 90
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 31
  say "Yaw still turns. Gimbal lock does not mean a jammed bearing."
  wait 1.5 seconds
  set stage to 1032
  set targetA to 0
  set targetB to 90
  set targetC to -20
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 32
  say "Roll turns about the same physical line, in the other direction."
  wait 1.5 seconds
  set stage to 1130
  set targetA to 0
  set targetB to 90
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 130
  say "Return to the aligned reference pose."
  wait 1.5 seconds
  set stage to 1033
  set targetA to 20
  set targetB to 90
  set targetC to -20
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 33
  say "Two motors moved, but the marker returned to its reference orientation."
  wait 1.5 seconds
  set stage to 1140
  set targetA to 0
  set targetB to 90
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 140
  say "Bring yaw and roll home before lowering the pitch frame."
  wait 1.5 seconds
  set stage to 1040
  set targetA to 0
  set targetB to 0
  set targetC to 0
  broadcast "Gimbal pose" and wait
  wait 0.5 seconds
  broadcast "Gimbal trim" and wait
  wait 0.5 seconds
  broadcast "Gimbal validate" and wait
  set stage to 40
  say "All three motors are home. The experiment is complete."
  wait 1.5 seconds
  set completed to 1
  set stage to 99
  say "Complete: all motors hold at home. Reset before repeating."

WHEN I receive "Gimbal pose":
  IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 15 degrees per second
    lab stop motor A hold

WHEN I receive "Gimbal trim":
  IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 5 degrees per second
    lab stop motor A hold

WHEN I receive "Gimbal validate":
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    set failed to 1
    broadcast "Gimbal fault" and wait
    stop all

WHEN I receive "Gimbal pose":
  IF (abs of (targetB - (lab motor B angle))) > 0.5 THEN:
    lab run motor B for (targetB - (lab motor B angle)) degrees at 15 degrees per second
    lab stop motor B hold

WHEN I receive "Gimbal trim":
  IF (abs of (targetB - (lab motor B angle))) > 0.5 THEN:
    lab run motor B for (targetB - (lab motor B angle)) degrees at 5 degrees per second
    lab stop motor B hold

WHEN I receive "Gimbal validate":
  IF (abs of (targetB - (lab motor B angle))) > 1 THEN:
    set failed to 1
    broadcast "Gimbal fault" and wait
    stop all

WHEN I receive "Gimbal pose":
  IF (abs of (targetC - (lab motor C angle))) > 0.5 THEN:
    lab run motor C for (targetC - (lab motor C angle)) degrees at 15 degrees per second
    lab stop motor C hold

WHEN I receive "Gimbal trim":
  IF (abs of (targetC - (lab motor C angle))) > 0.5 THEN:
    lab run motor C for (targetC - (lab motor C angle)) degrees at 5 degrees per second
    lab stop motor C hold

WHEN I receive "Gimbal validate":
  IF (abs of (targetC - (lab motor C angle))) > 1 THEN:
    set failed to 1
    broadcast "Gimbal fault" and wait
    stop all

WHEN I receive "Gimbal fault":
  lab stop motor A hold
  lab stop motor B hold
  lab stop motor C hold
  say "A motor missed its target. Inspect the build and reset before retrying."

WHEN I receive "Gimbal watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 120 THEN:
      set failed to 1
      broadcast "Gimbal fault" and wait
      stop all
    wait 0.1 seconds
