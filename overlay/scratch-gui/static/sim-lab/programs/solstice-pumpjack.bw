# SOLSTICE — Walking Beam Pump.
# Open solstice-pumpjack.ldr in Robot Lab, select Plain, Reset, then Run.
# One motor drives the full-turn crank. The walking beam, connecting rods
# and guided pump piston are entirely passive mechanical bodies.
# Four slow quarter-turn checkpoints show one cycle, followed by faster
# reverse, forward and reverse whole cycles, ending at the original pose.
# Reset the complete model before every run. Use the supplied settings.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL stage
GLOBAL moving
GLOBAL inputEncoder
GLOBAL inputCrankDegrees
GLOBAL targetDegrees
GLOBAL targetCrankDegrees
GLOBAL moveDegrees

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set moving to 0
  set inputEncoder to 0
  set inputCrankDegrees to 0
  set targetDegrees to 0
  set targetCrankDegrees to 0
  set moveDegrees to 0
  IF ((lab status) = "no-model") or ((lab status) = "not-open") THEN:
    set failed to 1
    say "Open Solstice in Robot Lab, select Plain, then Reset and Run."
    stop all
  lab start
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 3 THEN:
    set failed to 1
    say "Reset the complete Solstice model before this demonstration."
    stop all
  reset timer
  broadcast "Solstice observe"
  broadcast "Solstice watchdog"
  say "At home: one crank drives the passive beam and pump piston."
  wait 3 seconds
  set stage to 1
  set targetCrankDegrees to 90
  set targetDegrees to 90
  set moving to 1
  say "Slow cycle: quarter-turn checkpoint 1 of 4."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 30 degrees per second
  lab stop motor A hold
  set moving to 0
  wait 3 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The crank missed its checkpoint. Inspect Solstice and Reset."
    stop all
  set stage to 2
  set targetCrankDegrees to 180
  set targetDegrees to 180
  set moving to 1
  say "Slow cycle: quarter-turn checkpoint 2 of 4."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 30 degrees per second
  lab stop motor A hold
  set moving to 0
  wait 3 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The crank missed its checkpoint. Inspect Solstice and Reset."
    stop all
  set stage to 3
  set targetCrankDegrees to 270
  set targetDegrees to 270
  set moving to 1
  say "Slow cycle: quarter-turn checkpoint 3 of 4."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 30 degrees per second
  lab stop motor A hold
  set moving to 0
  wait 3 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The crank missed its checkpoint. Inspect Solstice and Reset."
    stop all
  set stage to 4
  set targetCrankDegrees to 360
  set targetDegrees to 360
  set moving to 1
  say "Slow cycle: quarter-turn checkpoint 4 of 4."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 30 degrees per second
  lab stop motor A hold
  set moving to 0
  wait 3 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The crank missed its checkpoint. Inspect Solstice and Reset."
    stop all
  set stage to 5
  set targetCrankDegrees to 0
  set targetDegrees to 0
  set moving to 1
  say "Full reverse cycle: return home."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 60 degrees per second
  lab stop motor A hold
  set moving to 0
  wait 3 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The crank missed its checkpoint. Inspect Solstice and Reset."
    stop all
  set stage to 6
  set targetCrankDegrees to 360
  set targetDegrees to 360
  set moving to 1
  say "Full forward cycle: one complete pump stroke."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 60 degrees per second
  lab stop motor A hold
  set moving to 0
  wait 3 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The crank missed its checkpoint. Inspect Solstice and Reset."
    stop all
  set stage to 7
  set targetCrankDegrees to 0
  set targetDegrees to 0
  set moving to 1
  say "Full reverse cycle: return home."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 60 degrees per second
  lab stop motor A hold
  set moving to 0
  wait 3 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The crank missed its checkpoint. Inspect Solstice and Reset."
    stop all
  set completed to 1
  say "Solstice complete: slow cycle, reverse, repeat and home. Reset to repeat."

WHEN I receive "Solstice observe":
  repeat until completed = 1:
    set inputEncoder to (lab motor A angle)
    set inputCrankDegrees to (inputEncoder * 1)
    wait 0.05 seconds

WHEN I receive "Solstice watchdog":
  repeat until completed = 1:
    IF timer > 150 THEN:
      set failed to 1
      lab stop motor A hold
      say "Solstice stopped after its time limit. Inspect the model and Reset."
      stop all
    wait 0.05 seconds
