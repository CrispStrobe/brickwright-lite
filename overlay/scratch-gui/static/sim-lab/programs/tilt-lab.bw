DEVICE SPIKE

# TILT LAB — two-axis powered marble maze.
# Reset/load the model at its saved LEVEL datum before running.
# Remove the loose ball for the first mechanism-clearance check.
# A turns the outer gimbal; B tilts the tray in that moving frame.
# Demonstration only: this program does not locate the ball or solve the maze.
# Keep edits within +/-12 degrees from the level datum on EACH motor.
# CrispStrobe / BSD-3-Clause. Two fixed support stops bound cold startup.
WHEN flag clicked:
  set motor stop action A hold
  set motor stop action B hold
  set motor speed A 3
  set motor speed B 3
  run motor A to position 0
  run motor B to position 0
  wait 2 seconds
  run motor A clockwise 6 degrees
  wait 2 seconds
  run motor A counterclockwise 6 degrees
  wait 1 seconds
  run motor B clockwise 10 degrees
  wait 2 seconds
  run motor B counterclockwise 10 degrees
  wait 1 seconds
  run motor A counterclockwise 6 degrees
  wait 2 seconds
  run motor A clockwise 6 degrees
  wait 1 seconds
  run motor B counterclockwise 10 degrees
  wait 2 seconds
  run motor B clockwise 10 degrees
  wait 1 seconds
  run motor A clockwise 6 degrees
  run motor B clockwise 8 degrees
  wait 2 seconds
  run motor B counterclockwise 8 degrees
  run motor A counterclockwise 6 degrees
  run motor A to position 0
  run motor B to position 0
  wait 2 seconds
