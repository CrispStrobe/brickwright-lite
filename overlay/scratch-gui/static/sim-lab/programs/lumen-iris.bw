# LUMEN — Six-leaf iris.
# Open lumen-iris.ldr in Robot Lab, select Plain, Reset, then Run.
# Motor A drives the ring mechanism. All six leaves follow through
# actual stock gears and hinges; no output motion is scripted.
# Cycle 1 visits quarter, half, three-quarter and full input travel,
# then returns through the same checkpoints. Cycle 2 opens and closes
# directly at the second supplied speed.
# Reset the complete model before every run. Use the supplied speeds.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL stage
GLOBAL cycle
GLOBAL inputDegrees
GLOBAL targetDegrees
GLOBAL moveDegrees

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set cycle to 0
  set inputDegrees to 0
  set targetDegrees to 0
  set moveDegrees to 0
  IF ((lab status) = "no-model") or ((lab status) = "not-open") THEN:
    set failed to 1
    say "Open Lumen in Robot Lab, select Plain, then Reset and Run."
    stop all
  lab start
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of (lab motor A angle)) > 3 THEN:
    set failed to 1
    say "Reset the complete Lumen model before this demonstration."
    stop all
  reset timer
  broadcast "Lumen observe"
  broadcast "Lumen watchdog"
  set stage to 1
  set cycle to 1
  set targetDegrees to -13.8042
  say "Cycle 1: opening the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 2
  set cycle to 1
  set targetDegrees to -27.6084
  say "Cycle 1: opening the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 3
  set cycle to 1
  set targetDegrees to -41.4126
  say "Cycle 1: opening the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 4
  set cycle to 1
  set targetDegrees to -55.2168
  say "Cycle 1: opening the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 5
  set cycle to 1
  set targetDegrees to -41.4126
  say "Cycle 1: closing the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 6
  set cycle to 1
  set targetDegrees to -27.6084
  say "Cycle 1: closing the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 7
  set cycle to 1
  set targetDegrees to -13.8042
  say "Cycle 1: closing the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 8
  set cycle to 1
  set targetDegrees to -0
  say "Cycle 1: closing the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 15 degrees per second
  lab stop motor A hold
  wait 0.65 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 9
  set cycle to 2
  set targetDegrees to -55.2168
  say "Cycle 2: open the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 30 degrees per second
  lab stop motor A hold
  wait 1 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 10
  set cycle to 2
  set targetDegrees to 0
  say "Cycle 2: close the iris."
  set moveDegrees to (targetDegrees - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 30 degrees per second
  lab stop motor A hold
  wait 1 seconds
  IF (abs of ((lab motor A angle) - targetDegrees)) > 2 THEN:
    set failed to 1
    say "The input missed its checkpoint. Inspect Lumen and Reset."
    stop all
  set stage to 11
  set completed to 1
  say "Lumen complete: two open-close cycles. Reset to repeat."

WHEN I receive "Lumen observe":
  repeat until completed = 1:
    set inputDegrees to (lab motor A angle)
    wait 0.05 seconds

WHEN I receive "Lumen watchdog":
  repeat until completed = 1:
    IF timer > 44 THEN:
      set failed to 1
      lab stop motor A hold
      say "Lumen stopped after its time limit. Inspect the model and Reset."
      stop all
    wait 0.05 seconds
