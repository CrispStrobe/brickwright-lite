# Tipline — equal loads, different ballast heights.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Freshly load tipline.ldr or tipline-swapped.ldr before every run.
# A tilts only the deck. Both loads remain independent, unpowered contact bodies.
# Observe each load's FIRST instability. Later catch contact is not the threshold.
# Speeds are degrees per second. The deck returns; the free loads are not reset.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL speedA = 2
GLOBAL stage = 0
GLOBAL held = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set held to 0
  IF (lab status) = "no-model" THEN:
    say "Load Tipline or its exchanged-ballast comparison first."
    stop all
  lab start
  lab stop motor A hold
  reset timer
  broadcast "Tipline watchdog"
  IF (abs of (lab motor A angle)) > 2 THEN:
    broadcast "Tipline fault" and wait
  set targetA to 0
  set speedA to 2
  broadcast "Tipline move" and wait
  wait 0.75 seconds
  set stage to 1
  set targetA to 23.5
  set speedA to 1
  say "Watch the two loads: which tips, and which slides first?"
  broadcast "Tipline move" and wait
  set stage to 2
  wait 0.3 seconds
  set stage to 3
  set targetA to 0
  set speedA to 3
  broadcast "Tipline move" and wait
  wait 2 seconds
  IF (abs of (lab motor A angle)) > 1 THEN:
    broadcast "Tipline fault" and wait
  set stage to 4
  set completed to 1
  say "Deck returned. Reload the model before comparing the ballast swap."

WHEN I receive "Tipline move":
  set held to 0
  IF (lab motor A angle) < -2 THEN:
    broadcast "Tipline fault" and wait
  IF (lab motor A angle) > 26 THEN:
    broadcast "Tipline fault" and wait
  IF (abs of (targetA - (lab motor A angle))) > 26 THEN:
    broadcast "Tipline fault" and wait
  lab run motor A for (targetA - (lab motor A angle)) degrees at speedA degrees per second
  lab stop motor A hold
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.4 THEN:
      lab run motor A for (targetA - (lab motor A angle)) degrees at 2 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "Tipline fault" and wait
  set held to 1

WHEN I receive "Tipline watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 60 THEN:
      broadcast "Tipline fault" and wait
    wait 0.05 seconds

WHEN I receive "Tipline fault":
  set failed to 1
  set held to 0
  lab stop motor A hold
  say "Input guard or watchdog failed. Reload the saved model."
  stop all
