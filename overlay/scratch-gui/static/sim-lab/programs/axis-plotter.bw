WHEN I receive "axis plotter phase 00001":
  lab run motor C for (0 - (lab motor C angle)) degrees at 60 degrees per second
  lab stop motor C hold
  IF (abs of (0 - (lab motor C angle))) > 2 THEN:
    lab stop motor A hold
    lab stop motor B hold
    lab stop motor C hold
    stop all

WHEN I receive "axis plotter phase 00003":
  lab run motor A for (28.64789 - (lab motor A angle)) degrees at 60.77135134060465 degrees per second
  lab stop motor A hold
  IF (abs of (28.64789 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    lab stop motor B hold
    lab stop motor C hold
    stop all

WHEN I receive "axis plotter phase 00003":
  lab run motor B for (28.64789 - (lab motor B angle)) degrees at 60.77135134060465 degrees per second
  lab stop motor B hold
  IF (abs of (28.64789 - (lab motor B angle))) > 2 THEN:
    lab stop motor A hold
    lab stop motor B hold
    lab stop motor C hold
    stop all

