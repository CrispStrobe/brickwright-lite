# Poise - a passive Roberval balance with two equal moving weights.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Import the matching model at its saved zero datum before running.
# Motors A and B rotate only the horizontal pan weights; the balance is passive.
# Robot Lab speeds are degrees per second. This is a native Lab experiment,
# not downloadable physical-hub firmware.
# Absolute unwrapped target pairs: (180,0), (180,90), (90,90), (90,180), (0,0).
# Fresh encoder deltas, at most two slow corrections, 2-second held dwells,
# angle envelopes [-4,184], a 100-second watchdog, and final hold on both motors.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL targetB = 0
GLOBAL stage = 0
GLOBAL dwelling = 0
GLOBAL arrivals = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set targetA to 0
  set targetB to 0
  set stage to 0
  set dwelling to 0
  set arrivals to 0
  set completed to 0
  set failed to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Import Poise in Robot Lab before running."
    stop all
  reset timer
  lab start
  lab stop motor A hold
  lab stop motor B hold
  wait 0.25 seconds
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Reload the saved Poise pose before running."
    stop all
  IF (abs of (lab motor B angle)) > 2 THEN:
    set failed to 1
    say "Reload the saved Poise pose before running."
    stop all
  broadcast "Poise watchdog"
  set stage to 1
  set targetA to 180
  set targetB to 0
  broadcast "Poise stage" and wait
  set stage to 2
  set targetA to 180
  set targetB to 90
  broadcast "Poise stage" and wait
  set stage to 3
  set targetA to 90
  set targetB to 90
  broadcast "Poise stage" and wait
  set stage to 4
  set targetA to 90
  set targetB to 180
  broadcast "Poise stage" and wait
  set stage to 5
  set targetA to 0
  set targetB to 0
  broadcast "Poise stage" and wait
  lab stop motor A hold
  lab stop motor B hold
  set stage to 6
  set completed to 1
  say "Complete: compare the five held balance observations and the returned weights."

WHEN I receive "Poise stage":
  set dwelling to 0
  broadcast "Poise move both" and wait
  lab stop motor A hold
  lab stop motor B hold
  set dwelling to 1
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    set dwelling to 0
    lab stop motor A hold
    lab stop motor B hold
    say "Weight A drifted from its target. Inspect and reload."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 2 THEN:
    set failed to 1
    set dwelling to 0
    lab stop motor A hold
    lab stop motor B hold
    say "Weight B drifted from its target. Inspect and reload."
    stop all
  change arrivals by 1
  set dwelling to 0

WHEN I receive "Poise move both":
  IF (abs of (targetA - (lab motor A angle))) > 188 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 0.001 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 15 degrees per second
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      lab run motor A for (targetA - (lab motor A angle)) degrees at 5 degrees per second
      wait 0.05 seconds
  lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    say "Weight A did not reach its target. Inspect and reload."
    stop all

WHEN I receive "Poise move both":
  IF (abs of (targetB - (lab motor B angle))) > 188 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 0.001 THEN:
    lab run motor B for (targetB - (lab motor B angle)) degrees at 15 degrees per second
  REPEAT 2:
    IF (abs of (targetB - (lab motor B angle))) > 0.5 THEN:
      lab run motor B for (targetB - (lab motor B angle)) degrees at 5 degrees per second
      wait 0.05 seconds
  lab stop motor B hold
  IF (abs of (targetB - (lab motor B angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    say "Weight B did not reach its target. Inspect and reload."
    stop all

WHEN I receive "Poise watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 100 THEN:
      set failed to 1
      set dwelling to 0
      lab stop motor A hold
      lab stop motor B hold
      say "100 second watchdog: both weights stopped and holding. Reload before retrying."
      stop all
    IF (lab motor A angle) > 184 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    IF (lab motor A angle) < -4 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    IF (lab motor B angle) > 184 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    IF (lab motor B angle) < -4 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    wait 0.05 seconds

