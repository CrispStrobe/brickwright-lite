# Dune Strider — CrispStrobe, BSD-3-Clause.
# Saved zero is a physical crank datum. Do not reset the encoder after load.
# Speeds below are Robot Lab degrees per second, not hub percent.
# Stage 1 homes from bounded cold drift; 2 is forward; 3 is return; 4 is finished.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL correction = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  reset timer
  lab start
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 180 THEN:
    set failed to 1
    say "Reset the model to its saved pose before running."
    stop all
  broadcast "watchdog"
  set stage to 1
  set targetA to 0
  broadcast "move A" and wait
  wait 0.5 seconds
  set stage to 2
  set targetA to 720
  broadcast "move A" and wait
  wait 0.5 seconds
  set stage to 3
  set targetA to 0
  broadcast "move A" and wait
  wait 0.5 seconds
  lab stop motor A hold
  set stage to 4
  set completed to 1

WHEN I receive "move A":
  set correction to 0
  REPEAT UNTIL ((abs of (targetA - (lab motor A angle))) < 0.4) OR (correction = 3):
    lab run motor A for (targetA - (lab motor A angle)) degrees at 36 degrees per second
    change correction by 1
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "The crank did not reach its target. Inspect the linkage and reset."
    stop all
  lab stop motor A hold

WHEN I receive "watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 85 THEN:
      lab stop motor A hold
      set failed to 1
      say "The gait experiment timed out. Inspect the linkage and reset."
      stop all
    wait 0.1 seconds
