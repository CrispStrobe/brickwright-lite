DEVICE SPIKE

# A and B drive the mirrored rear motors; C steers the front bogie. Operate C within +/-20 degrees.
# Reset the model before repeating the experiment.
WHEN flag clicked:
  set motor stop action C hold
  set motor speed C 15
  run motor C to position 0
  run motor C clockwise 20 degrees
  set motor speed A 15
  set motor speed B 15
  start motor A counterclockwise
  start motor B clockwise
  wait 3 seconds
  stop motor A
  stop motor B
  run motor C counterclockwise 40 degrees
  start motor A counterclockwise
  start motor B clockwise
  wait 3 seconds
  stop motor A
  stop motor B
  run motor C clockwise 20 degrees
