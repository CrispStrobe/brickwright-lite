# Oblique — adjustable-angle trammel. CrispStrobe, BSD-3-Clause.
# Reset/reload the complete model to the saved physical pose before running.
# A turns the bar; B changes the passive guide angle while A is at home.
# Robot Lab speeds are degrees/second. No marker coordinates are commanded.
# Each bounded move uses its absolute target minus a fresh encoder value.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL speedA = 0
GLOBAL stageSpeedA = 0
GLOBAL correctionA = 0
GLOBAL targetB = 0
GLOBAL speedB = 0
GLOBAL stageSpeedB = 0
GLOBAL correctionB = 0
GLOBAL stage = 0
GLOBAL settled = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set settled to 0
  reset timer
  lab start
  lab stop motor A hold
  lab stop motor B hold
  IF (abs of (lab motor A angle)) > 5 THEN:
    broadcast "fail all" and wait
    say "Reset the complete model to its saved pose before running."
    stop all
  IF (abs of (lab motor B angle)) > 5 THEN:
    broadcast "fail all" and wait
    say "Reset the complete model to its saved pose before running."
    stop all
  broadcast "watchdog"
  # Stage 1: saved physical datum
  set settled to 0
  set stage to 1
  set targetA to 0
  set stageSpeedA to 6
  set targetB to 0
  set stageSpeedB to 6
  broadcast "move A" and wait
  broadcast "move B" and wait
  set settled to 1
  wait 0.5 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  # Stage 2: perpendicular ellipse, forward turn
  set settled to 0
  set stage to 2
  set targetA to 360
  set stageSpeedA to 24
  set targetB to 0
  set stageSpeedB to 6
  broadcast "move A" and wait
  broadcast "move B" and wait
  set settled to 1
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  # Stage 3: perpendicular ellipse, reverse turn
  set settled to 0
  set stage to 3
  set targetA to 0
  set stageSpeedA to 36
  set targetB to 0
  set stageSpeedB to 6
  broadcast "move A" and wait
  broadcast "move B" and wait
  set settled to 1
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  # Stage 4: set passive guide to 60 degrees with bar home
  set settled to 0
  set stage to 4
  set targetA to 0
  set stageSpeedA to 6
  set targetB to -90
  set stageSpeedB to 24
  broadcast "move A" and wait
  broadcast "move B" and wait
  set settled to 1
  wait 0.75 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  # Stage 5: oblique ellipse, forward turn
  set settled to 0
  set stage to 5
  set targetA to 360
  set stageSpeedA to 24
  set targetB to -90
  set stageSpeedB to 6
  broadcast "move A" and wait
  broadcast "move B" and wait
  set settled to 1
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  # Stage 6: oblique ellipse, reverse turn
  set settled to 0
  set stage to 6
  set targetA to 0
  set stageSpeedA to 36
  set targetB to -90
  set stageSpeedB to 6
  broadcast "move A" and wait
  broadcast "move B" and wait
  set settled to 1
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  # Stage 7: return passive guide to 90 degrees with bar home
  set settled to 0
  set stage to 7
  set targetA to 0
  set stageSpeedA to 6
  set targetB to 0
  set stageSpeedB to 24
  broadcast "move A" and wait
  broadcast "move B" and wait
  set settled to 1
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "An axis moved during the hold. Inspect the mechanism and reset."
    stop all
  lab stop motor A hold
  lab stop motor B hold
  set stage to 8
  set completed to 1

WHEN I receive "move A":
  set correctionA to 0
  REPEAT UNTIL ((abs of (targetA - (lab motor A angle))) < 0.4) OR (correctionA = 3):
    set speedA to 6
    IF (correctionA) = 0 THEN:
      set speedA to stageSpeedA
    lab run motor A for (targetA - (lab motor A angle)) degrees at speedA degrees per second
    lab stop motor A hold
    wait 0.05 seconds
    change correctionA by 1
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "Axis A did not reach its target. Inspect the mechanism and reset."
    stop all
  lab stop motor A hold

WHEN I receive "move B":
  set correctionB to 0
  REPEAT UNTIL ((abs of (targetB - (lab motor B angle))) < 0.4) OR (correctionB = 3):
    set speedB to 6
    IF (correctionB) = 0 THEN:
      set speedB to stageSpeedB
    lab run motor B for (targetB - (lab motor B angle)) degrees at speedB degrees per second
    lab stop motor B hold
    wait 0.05 seconds
    change correctionB by 1
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    broadcast "fail all" and wait
    say "Axis B did not reach its target. Inspect the mechanism and reset."
    stop all
  lab stop motor B hold

WHEN I receive "watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 95 THEN:
      broadcast "fail all" and wait
      say "The ellipse comparison timed out. Inspect the mechanism and reset."
      stop all
    wait 0.1 seconds

WHEN I receive "fail all":
  lab stop motor A hold
  lab stop motor B hold
  set failed to 1
