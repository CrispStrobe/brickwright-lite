# Quiet Partner — continuous finite excitation of two passive rotors.
# Copyright (c) 2026 Christian Ströbele (CrispStrobe). SPDX-License-Identifier: BSD-3-Clause.
# Load either matching saved model: coupled or no-absorber-bands control.
# The exact same program is used for both. Reload before every experiment.
# A drives only the blue input. The orange primary and green partner are passive.
# phase: 0 startup, 1 continuing drive, 2 return, 3 held observation, 4 complete, -1 fault.
# No scene reset, encoder reset, passive-body command, or hidden actuator is used.
DEVICE SPIKE
GLOBAL phase = 0
GLOBAL cycle = 0
GLOBAL half = 0
GLOBAL target = 0
GLOBAL complete = 0
GLOBAL fault = 0

WHEN flag clicked:
  set phase to 0
  set cycle to 0
  set half to 0
  set complete to 0
  set fault to 0
  lab start
  lab stop motor A hold
  reset timer
  broadcast "Quiet Partner watchdog"
  wait 0.5 seconds
  IF (abs of (lab motor A angle)) > 0.5 THEN:
    broadcast "Quiet Partner fault" and wait
    say "Reload the saved Quiet Partner model before running."
    stop all
  set phase to 1
  set target to 2
  broadcast "Quiet Partner rock" and wait
  REPEAT 16:
    change cycle by 1
    set half to -1
    set target to -2
    broadcast "Quiet Partner rock" and wait
    set half to 1
    set target to 2
    broadcast "Quiet Partner rock" and wait
  set phase to 2
  set half to 0
  set target to 0
  broadcast "Quiet Partner rock" and wait
  lab stop motor A hold
  set phase to 3
  wait 8 seconds
  IF (abs of (lab motor A angle)) > 0.5 THEN:
    broadcast "Quiet Partner fault" and wait
    say "The input drifted during the held observation. Reload before retrying."
    stop all
  set phase to 4
  set complete to 1
  say "Complete. Compare the primary motion with and without the partner bands. Reload before the other run."

WHEN I receive "Quiet Partner rock":
  IF (abs of (target - (lab motor A angle))) > 4.5 THEN:
    broadcast "Quiet Partner fault" and wait
    say "Input excursion exceeds the declared range. Reload before retrying."
    stop all
  lab run motor A for (target - (lab motor A angle)) degrees at 13 degrees per second
  lab stop motor A hold
  IF (abs of (target - (lab motor A angle))) > 0.5 THEN:
    broadcast "Quiet Partner fault" and wait
    say "Input missed its target. Reload before retrying."
    stop all

WHEN I receive "Quiet Partner fault":
  set fault to 1
  set phase to -1
  lab stop motor A hold

WHEN I receive "Quiet Partner watchdog":
  REPEAT UNTIL (complete = 1):
    IF (timer) > 50 THEN:
      broadcast "Quiet Partner fault" and wait
      say "Quiet Partner timed out. Reload before retrying."
      stop all
    wait 0.1 seconds
