# Afterturn - a closed internal motion cycle and a passive platform heading.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Robot Lab toolbar Run connects the same virtual SPIKE hub before starting.
# Motor A turns the reaction rotor. Motor B changes the two mass radii.
# Fresh unwrapped targets; ordinary supported default hold at every finite arrival.
# One closed cycle, then its inverse. The yaw bearing is never actuated.
# Source-derived 900-degree reaction stroke; one cycle and one inverse, no repeated accumulation.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL targetB = 0
GLOBAL activePort = 0
GLOBAL stage = 0
GLOBAL checkpoint = 0
GLOBAL moving = 0
GLOBAL dwelling = 0
GLOBAL arrivals = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set targetA to 0
  set targetB to 0
  set activePort to 0
  set stage to 0
  set checkpoint to 0
  set moving to 0
  set dwelling to 0
  set arrivals to 0
  set completed to 0
  set failed to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Import Afterturn in Robot Lab before running."
    stop all
  reset timer
  lab start
  set motor stop action A hold
  set motor stop action B hold
  lab stop motor A hold
  lab stop motor B hold
  wait 0.25 seconds
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Reload the saved Afterturn pose before running."
    stop all
  IF (abs of (lab motor B angle)) > 2 THEN:
    set failed to 1
    say "Reload the saved Afterturn pose before running."
    stop all
  broadcast "Afterturn watchdog"
  set stage to 1
  set activePort to 2
  set targetB to 70
  broadcast "Afterturn stage" and wait
  set stage to 2
  set activePort to 1
  set targetA to 900
  broadcast "Afterturn stage" and wait
  set stage to 3
  set activePort to 2
  set targetB to 0
  broadcast "Afterturn stage" and wait
  set stage to 4
  set activePort to 1
  set targetA to 0
  broadcast "Afterturn stage" and wait
  set stage to 5
  set activePort to 1
  set targetA to 900
  broadcast "Afterturn stage" and wait
  set stage to 6
  set activePort to 2
  set targetB to 70
  broadcast "Afterturn stage" and wait
  set stage to 7
  set activePort to 1
  set targetA to 0
  broadcast "Afterturn stage" and wait
  set stage to 8
  set activePort to 2
  set targetB to 0
  broadcast "Afterturn stage" and wait
  set completed to 1
  say "Complete: compare first-cycle and inverse-cycle platform headings. Both internal coordinates are home."

WHEN I receive "Afterturn stage":
  set checkpoint to 0
  set dwelling to 0
  set moving to 1
  IF activePort = 1 THEN:
    IF (abs of (targetA - (lab motor A angle))) > 904 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    lab run motor A for (targetA - (lab motor A angle)) degrees at 90 degrees per second
    REPEAT 2:
      IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
        lab run motor A for (targetA - (lab motor A angle)) degrees at 10 degrees per second
        wait 0.05 seconds
  IF activePort = 2 THEN:
    IF (abs of (targetB - (lab motor B angle))) > 74 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    lab run motor B for (targetB - (lab motor B angle)) degrees at 60 degrees per second
    REPEAT 2:
      IF (abs of (targetB - (lab motor B angle))) > 0.5 THEN:
        lab run motor B for (targetB - (lab motor B angle)) degrees at 10 degrees per second
        wait 0.05 seconds
  set moving to 0
  set dwelling to 1
  IF stage = 4 THEN:
    set checkpoint to 1
  IF stage = 8 THEN:
    set checkpoint to 2
  wait 0.5 seconds
  IF checkpoint > 0 THEN:
    wait 0.5 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    say "Reaction rotor failed to hold its target. Inspect and reload."
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    say "Mass-shape drive failed to hold its target. Inspect and reload."
    stop all
  change arrivals by 1
  set dwelling to 0

WHEN I receive "Afterturn watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 60 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      say "60-second watchdog: both internal motors are holding. Reload before retrying."
      stop all
    IF (lab motor A angle) > 904 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    IF (lab motor A angle) < -4 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    IF (lab motor B angle) > 74 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    IF (lab motor B angle) < -4 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    wait 0.05 seconds
