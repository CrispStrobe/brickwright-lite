# PointWeaver — coordinated two-motor five-bar path tracer
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 CrispStrobe
# Finite one-cycle experiment for models/pointweaver.ldr.
# Reload/reset the model to its saved lower-left pose before Run.
# Motors A and B must each begin within 1.5 degrees of zero.
# Targets are absolute fresh unwrapped encoder angles. Speeds are degrees per second.
# Each edge uses precomputed positive speeds so both axes nominally finish in 2.0 seconds.
# Programmed route (A,B): (0,0) -> (-8.106818,-8.106818) ->
# (-31.598600,6.733691) -> (-14.840510,23.491782) -> (0,0).
# Analytical/manual bounds: A=-34..2 degrees; B=-11..26 degrees.
# These software bounds are not physical stops.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL targetB = 0
GLOBAL speedA = 4.053409
GLOBAL speedB = 4.053409
GLOBAL axisDoneA = 0
GLOBAL axisDoneB = 0
GLOBAL phase = 0
GLOBAL done = 0
GLOBAL fault = 0
WHEN flag clicked:
  set targetA to 0
  set targetB to 0
  set speedA to 4.053409
  set speedB to 4.053409
  set axisDoneA to 0
  set axisDoneB to 0
  set phase to 0
  set done to 0
  set fault to 0
  IF (lab status) = "no-model" THEN:
    set fault to 1
    say "Load PointWeaver and reset its saved lower-left pose before running."
    stop all
  lab start
  IF (abs of (lab motor A angle)) > 1.5 THEN:
    set fault to 1
    broadcast "PointWeaver fault" and wait
    stop all
  IF (abs of (lab motor B angle)) > 1.5 THEN:
    set fault to 1
    broadcast "PointWeaver fault" and wait
    stop all
  lab stop motor A hold
  lab stop motor B hold
  reset timer
  broadcast "PointWeaver watchdog"
  wait 0.25 seconds
  set phase to 1
  set targetA to -8.106818
  set targetB to -8.106818
  set speedA to 4.053409
  set speedB to 4.053409
  broadcast "PointWeaver coordinated move" and wait
  wait 0.4 seconds
  set phase to 2
  set targetA to -31.5986
  set targetB to 6.733691
  set speedA to 11.745891
  set speedB to 7.420255
  broadcast "PointWeaver coordinated move" and wait
  wait 0.4 seconds
  set phase to 3
  set targetA to -14.84051
  set targetB to 23.491782
  set speedA to 8.379045
  set speedB to 8.379045
  broadcast "PointWeaver coordinated move" and wait
  wait 0.4 seconds
  set phase to 4
  set targetA to 0
  set targetB to 0
  set speedA to 7.420255
  set speedB to 11.745891
  broadcast "PointWeaver coordinated move" and wait
  lab stop motor A hold
  lab stop motor B hold
  wait 0.25 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    set fault to 1
    broadcast "PointWeaver fault" and wait
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    set fault to 1
    broadcast "PointWeaver fault" and wait
    stop all
  set phase to 99
  set done to 1
  say "PointWeaver loop complete. Compare the dashed straight edges with the endpoint path, then reset before repeating."
WHEN I receive "PointWeaver coordinated move":
  set axisDoneA to 0
  set axisDoneB to 0
  broadcast "PointWeaver move A"
  broadcast "PointWeaver move B"
  REPEAT UNTIL ((axisDoneA + axisDoneB) = 2):
    wait 0.02 seconds
  IF (fault) = 1 THEN:
    stop all
WHEN I receive "PointWeaver move A":
  lab run motor A for (targetA - (lab motor A angle)) degrees at speedA degrees per second
  lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 4 degrees per second
    lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    set fault to 1
    broadcast "PointWeaver fault" and wait
    stop all
  set axisDoneA to 1
WHEN I receive "PointWeaver move B":
  lab run motor B for (targetB - (lab motor B angle)) degrees at speedB degrees per second
  lab stop motor B hold
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    lab run motor B for (targetB - (lab motor B angle)) degrees at 4 degrees per second
    lab stop motor B hold
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    set fault to 1
    broadcast "PointWeaver fault" and wait
    stop all
  set axisDoneB to 1
WHEN I receive "PointWeaver fault":
  lab stop motor A brake
  lab stop motor B brake
  say "A motor missed its permitted pose or time. Inspect both pivot axles and all four links, then reload the saved model."
WHEN I receive "PointWeaver watchdog":
  REPEAT UNTIL (done = 1):
    IF (timer) > 45 THEN:
      set fault to 1
      broadcast "PointWeaver fault" and wait
      stop all
    wait 0.05 seconds
