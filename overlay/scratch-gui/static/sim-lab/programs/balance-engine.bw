# Balance Engine — regenerated edition, 22 October 2026.
# Robot Lab experiment; import the matching LDR and reset its saved pose first.
# Two motors drive inline slider cranks on a passive band-centred carrier.
# A and B rotate about the same world axis; two real bands centre the carrier.
# Three trials: B leads A by 0, 90, then 180 degrees; four turns per trial.
# Each trial returns to its starting phase. Both inputs finish at encoder zero.
# Lab speeds are degrees/second. This is simulator code, not hub firmware.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL targetB = 0
GLOBAL commandSpeed = 60
GLOBAL phase = 0
GLOBAL experiment = 0
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set stage to 0
  set completed to 0
  set failed to 0
  set experiment to 0
  set phase to 0
  reset timer
  lab start
  lab stop motor A hold
  lab stop motor B hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    set stage to -1
    say "Reset the model to its saved pose before running."
    stop all
  IF (abs of (lab motor B angle)) > 1 THEN:
    set failed to 1
    set stage to -1
    say "Reset the model to its saved pose before running."
    stop all
  broadcast "balance watchdog"
  REPEAT 3:
    set experiment to (experiment + 1)
    set phase to ((experiment - 1) * 90)
    set stage to 1
    set targetA to 0
    set targetB to phase
    set commandSpeed to 60
    broadcast "balance move" and wait
    wait 0.5 seconds
    set stage to 2
    set targetA to 1440
    set targetB to (1440 + phase)
    set commandSpeed to 180
    broadcast "balance move" and wait
    set stage to 3
    wait 0.5 seconds
    set stage to 4
    set targetA to 0
    set targetB to phase
    set commandSpeed to 180
    broadcast "balance move" and wait
    wait 0.5 seconds
  set stage to 5
  set targetA to 0
  set targetB to 0
  set commandSpeed to 60
  broadcast "balance move" and wait
  lab stop motor A hold
  lab stop motor B hold
  set stage to 6
  set completed to 1
  say "Finished: 0, 90 and 180 degree trials; both cranks home."

WHEN I receive "balance move":
  IF (abs of (targetA - (lab motor A angle))) > 0.2 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at commandSpeed degrees per second
  lab stop motor A hold
  wait 0.1 seconds
  REPEAT 3:
    IF (abs of (targetA - (lab motor A angle))) > 0.2 THEN:
      lab run motor A for (targetA - (lab motor A angle)) degrees at 5 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
    lab stop motor A hold
    lab stop motor B hold
    set failed to 1
    set stage to -1
    say "Crank A missed its target. Inspect and reset the model."
    stop all

WHEN I receive "balance move":
  IF (abs of (targetB - (lab motor B angle))) > 0.2 THEN:
    lab run motor B for (targetB - (lab motor B angle)) degrees at commandSpeed degrees per second
  lab stop motor B hold
  wait 0.1 seconds
  REPEAT 3:
    IF (abs of (targetB - (lab motor B angle))) > 0.2 THEN:
      lab run motor B for (targetB - (lab motor B angle)) degrees at 5 degrees per second
      lab stop motor B hold
      wait 0.1 seconds
  IF (abs of (targetB - (lab motor B angle))) > 0.5 THEN:
    lab stop motor A hold
    lab stop motor B hold
    set failed to 1
    set stage to -1
    say "Crank B missed its target. Inspect and reset the model."
    stop all

WHEN I receive "balance watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 85 THEN:
      lab stop motor A hold
      lab stop motor B hold
      set failed to 1
      set stage to -1
      say "Experiment timed out. Inspect and reset the model."
      stop all
    wait 0.1 seconds
