# TwinTempo — three-to-one hoist
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Load the supplied LDR and reset it to its saved pose before running.
# One motor, port A. Both suspended payloads remain passive and independent.
# This is a Robot Lab simulation program, not uploaded SPIKE firmware.
# Encoder targets are absolute, unwrapped degrees; speeds are degrees/second.
# Main path: 0 -> 720 -> 0. Each move uses a fresh encoder difference.
# The native degree command waits for controller completion. Holding captures
# the attained angle, so two bounded correction attempts precede each guard.
# Startup tolerance: 1 degree. Move/held-return tolerance: 1.5 degrees.
# A concurrent 60 second watchdog stops and holds if any command stalls.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL targetA = 0
GLOBAL correctionAttempts = 0

WHEN flag clicked:
  set stage to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set correctionAttempts to 0
  reset timer
  lab start
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    say "Reset TwinTempo to its saved pose before running."
    stop all
  broadcast "TwinTempo watchdog"
  set stage to 1
  set targetA to 720
  broadcast "TwinTempo move" and wait
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "TwinTempo drifted at the observation stop. Inspect and reset."
    stop all
  set stage to 2
  set targetA to 0
  broadcast "TwinTempo move" and wait
  wait 1 seconds
  IF (abs of (lab motor A angle)) > 1.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "TwinTempo did not hold its return datum. Inspect and reset."
    stop all
  lab stop motor A hold
  set stage to 3
  set completed to 1
  say "TwinTempo complete: compare both payload strokes and their return."

WHEN I receive "TwinTempo move":
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 60 degrees per second
  lab stop motor A hold
  set correctionAttempts to 0
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      change correctionAttempts by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 12 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "TwinTempo missed its encoder target. Inspect and reset."
    stop all

WHEN I receive "TwinTempo watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 60 THEN:
      lab stop motor A hold
      set failed to 1
      say "TwinTempo: 60 second watchdog stopped the experiment. Reset before retrying."
      stop all
    wait 0.1 seconds
