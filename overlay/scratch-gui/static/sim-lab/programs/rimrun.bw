# RimRun — one physical release gate, two free rolling inertia loads.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Reload the saved model before every run. Use the same source for both lane orders.
# Robot Lab's toolbar Run connects the normal virtual SPIKE hub before this flag.
# Only the gate motor is commanded. The rollers move through native gravity/contact.
# A bounded powered home restores the gate after cold gravity drift. No encoder reset.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL fresh_angle = 0
GLOBAL command_degrees = 0
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL arrivals = 0
GLOBAL homed = 0
GLOBAL home_start = 0
GLOBAL home_end = 0
GLOBAL release_start = 0
GLOBAL release_end = 0
GLOBAL observe_start = 0
GLOBAL observe_end = 0
GLOBAL return_start = 0
GLOBAL return_end = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set arrivals to 0
  set homed to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Load RimRun before running. Reload it before each lane comparison."
    stop all
  lab start
  set motor stop action A hold
  lab stop motor A hold
  reset timer
  broadcast "RimRun watchdog"
  IF (abs of (lab motor A angle)) > 25 THEN:
    broadcast "RimRun fault" and wait
  set targetA to 0
  set fresh_angle to (lab motor A angle)
  set command_degrees to (targetA - fresh_angle)
  set home_start to (timer)
  lab run motor A for command_degrees degrees at 60 degrees per second
  set home_end to (timer)
  wait 1.5 seconds
  IF (abs of (lab motor A angle)) > 0.5 THEN:
    broadcast "RimRun fault" and wait
  set homed to 1
  set stage to 1
  set targetA to 100
  set fresh_angle to (lab motor A angle)
  set command_degrees to (targetA - fresh_angle)
  set release_start to (timer)
  lab run motor A for command_degrees degrees at 400 degrees per second
  set release_end to (timer)
  change arrivals by 1
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "RimRun fault" and wait
  set stage to 2
  set observe_start to (timer)
  say "The gate holds open. Compare the free rollers on the same slope."
  wait 3 seconds
  set observe_end to (timer)
  set stage to 3
  set targetA to 0
  set fresh_angle to (lab motor A angle)
  set command_degrees to (targetA - fresh_angle)
  set return_start to (timer)
  lab run motor A for command_degrees degrees at 120 degrees per second
  set return_end to (timer)
  change arrivals by 1
  IF (abs of (lab motor A angle)) > 1 THEN:
    broadcast "RimRun fault" and wait
  wait 0.5 seconds
  lab stop motor A hold
  set stage to 4
  set completed to 1
  say "Gate returned. Reload the model before running the swapped lane order."

WHEN I receive "RimRun watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 12 THEN:
      broadcast "RimRun fault" and wait
    IF (lab motor A angle) > 108 THEN:
      broadcast "RimRun fault" and wait
    IF (lab motor A angle) < -3 THEN:
      broadcast "RimRun fault" and wait
    wait 0.02 seconds

WHEN I receive "RimRun fault":
  set failed to 1
  lab stop motor A hold
  say "Gate input guard or watchdog failed. Reload the saved RimRun model."
  stop all
