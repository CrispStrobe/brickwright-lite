# Obliquity Orrery control (turned axis) - same sweep; midsummer moves to lambda = 135 deg.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# One SPIKE medium motor on A turns the crank axle 1:1.
# Saved pose = crank angle 45 deg; encoder datum 0. Targets are motor degrees
# equal to (lambda - 45); lambda is measured from markers, never from the encoder.
# Outbound stations every 11.25 deg (lambda 45..135), then two return stations.
# Each station: feedback move, hold, at most three slow trims, still-window guard,
# then a 1.2 s settled window that the measurement judge averages.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL settled = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL targetA = 0
GLOBAL speedA = 12
GLOBAL trims = 0
GLOBAL a0 = 0

WHEN flag clicked:
  set stage to 0
  set settled to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set speedA to 12
  set trims to 0
  set a0 to 0
  reset timer
  lab start
  lab stop motor A hold
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Load the Obliquity Orrery and reset its saved pose before running."
    stop all
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Orrery: reset to the saved pose first (encoder datum is not zero)."
    stop all
  broadcast "Orrery watchdog"
  set stage to 1
  set targetA to 0
  broadcast "Orrery station" and wait
  set stage to 2
  set targetA to -11.25
  broadcast "Orrery station" and wait
  set stage to 3
  set targetA to -22.5
  broadcast "Orrery station" and wait
  set stage to 4
  set targetA to -33.75
  broadcast "Orrery station" and wait
  set stage to 5
  set targetA to -45
  broadcast "Orrery station" and wait
  set stage to 6
  set targetA to -56.25
  broadcast "Orrery station" and wait
  set stage to 7
  set targetA to -67.5
  broadcast "Orrery station" and wait
  set stage to 8
  set targetA to -78.75
  broadcast "Orrery station" and wait
  set stage to 9
  set targetA to -90
  broadcast "Orrery station" and wait
  set stage to 11
  set targetA to -45
  set speedA to 20
  broadcast "Orrery station" and wait
  set stage to 12
  set targetA to 0
  broadcast "Orrery station" and wait
  lab stop motor A hold
  wait 0.2 seconds
  set stage to 99
  set completed to 1
  say "Orrery complete: compare the measured declination with sin(delta)=sin(22.5)*cos(lambda-135)."

WHEN I receive "Orrery station":
  set settled to 0
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at speedA degrees per second
  lab stop motor A hold
  set trims to 0
  REPEAT 3:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      change trims by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 8 degrees per second
      lab stop motor A hold
      wait 0.15 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    set failed to 1
    say "Orrery: the crank cannot reach a station (jam or singular pose)."
    stop all
  wait 0.35 seconds
  set a0 to (lab motor A angle)
  wait 0.2 seconds
  IF (abs of ((lab motor A angle) - a0)) > 0.2 THEN:
    lab stop motor A hold
    set failed to 1
    say "Orrery: a station did not hold still; inspect the mechanism and reset."
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 0.75 THEN:
    lab stop motor A hold
    set failed to 1
    say "Orrery: a station missed its permitted encoder angle."
    stop all
  set settled to 1
  wait 1.2 seconds
  set settled to 0
  wait 0.3 seconds

WHEN I receive "Orrery watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 80 THEN:
      lab stop motor A hold
      set failed to 1
      set settled to 0
      say "Orrery: 80 s watchdog stopped the sweep."
      stop all
    wait 0.05 seconds
