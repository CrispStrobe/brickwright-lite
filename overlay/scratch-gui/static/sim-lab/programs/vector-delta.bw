# VECTOR — three-axis parallel Delta robot, one 13-waypoint XYZ demonstration.
# Open matching vector-delta.ldr in Robot Lab, choose Plain, Reset, then Run.
# Three base-mounted motors A/B/C drive 8T/24T shoulder reductions of 3:1.
# Upper arms: 120 LDU (48 mm); paired lower steering links: 140 LDU (56 mm).
# Shoulder circle radius 200 LDU; platform joint circle radius 60 LDU.
# The controller solves inverse kinematics from XYZ, then runs three finite
# motor commands concurrently. It never poses the platform or passive rods.
# Coordinates are LDU in the model: +Y downward, all relative to shoulder plane.
# Plain-mat display coordinates are centimetres: world(X,Y,Z)=source(Z,-Y,X).
# A 3 mm coarse part-reporter guard detects wrong models and failed moves;
# separate native geometry qualification uses full-precision physical pivots.
# Reset the complete model before repeating. This saved shoulder datum is 35 deg.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL waypoint
GLOBAL atTarget
GLOBAL targetX
GLOBAL targetY
GLOBAL targetZ
GLOBAL phi
GLOBAL radial
GLOBAL D
GLOBAL q2
GLOBAL rho
GLOBAL K
GLOBAL theta
GLOBAL thetaA
GLOBAL thetaB
GLOBAL thetaC
GLOBAL targetA
GLOBAL targetB
GLOBAL targetC
GLOBAL deltaA
GLOBAL deltaB
GLOBAL deltaC
GLOBAL speedA
GLOBAL speedB
GLOBAL speedC
GLOBAL maxDelta
GLOBAL homeX
GLOBAL homeY
GLOBAL homeZ
GLOBAL measuredX
GLOBAL measuredY
GLOBAL measuredZ
GLOBAL actualError

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set waypoint to -1
  set atTarget to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Open Vector in Robot Lab, select Plain, then Reset and Run."
    stop all
  reset timer
  broadcast "Vector watchdog"
  lab start
  lab stop motor A hold
  lab stop motor B hold
  lab stop motor C hold
  wait 0.5 seconds
  IF (((abs of (lab motor A angle)) > 5) or ((abs of (lab motor B angle)) > 5)) or ((abs of (lab motor C angle)) > 5) THEN:
    set failed to 1
    say "Saved-angle guard: Reset the complete Vector model before running."
    stop all
  set homeX to ((lab part "tool_star" x) - (lab part "hub" x))
  set homeY to ((lab part "tool_star" y) - (lab part "hub" y))
  set homeZ to ((lab part "tool_star" z) - (lab part "hub" z))
  # 0: home
  set atTarget to 0
  set waypoint to 0
  set targetX to 0.000000000000
  set targetY to 202.474088674589
  set targetZ to 0.000000000000
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.5 seconds
  # 1: lift
  set atTarget to 0
  set waypoint to 1
  set targetX to 0.000000000000
  set targetY to 177.474088674589
  set targetZ to 0.000000000000
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 2: station 1 above
  set atTarget to 0
  set waypoint to 2
  set targetX to -24.000000000000
  set targetY to 177.474088674589
  set targetZ to 0.000000000000
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 3: station 1 down
  set atTarget to 0
  set waypoint to 3
  set targetX to -24.000000000000
  set targetY to 192.474088674589
  set targetZ to 0.000000000000
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.6 seconds
  # 4: station 1 lift
  set atTarget to 0
  set waypoint to 4
  set targetX to -24.000000000000
  set targetY to 177.474088674589
  set targetZ to 0.000000000000
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 5: station 2 above
  set atTarget to 0
  set waypoint to 5
  set targetX to 12.000000000000
  set targetY to 177.474088674589
  set targetZ to 20.784609690827
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 6: station 2 down
  set atTarget to 0
  set waypoint to 6
  set targetX to 12.000000000000
  set targetY to 192.474088674589
  set targetZ to 20.784609690827
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.6 seconds
  # 7: station 2 lift
  set atTarget to 0
  set waypoint to 7
  set targetX to 12.000000000000
  set targetY to 177.474088674589
  set targetZ to 20.784609690827
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 8: station 3 above
  set atTarget to 0
  set waypoint to 8
  set targetX to 12.000000000000
  set targetY to 177.474088674589
  set targetZ to -20.784609690827
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 9: station 3 down
  set atTarget to 0
  set waypoint to 9
  set targetX to 12.000000000000
  set targetY to 192.474088674589
  set targetZ to -20.784609690827
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.6 seconds
  # 10: station 3 lift
  set atTarget to 0
  set waypoint to 10
  set targetX to 12.000000000000
  set targetY to 177.474088674589
  set targetZ to -20.784609690827
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 11: center above
  set atTarget to 0
  set waypoint to 11
  set targetX to 0.000000000000
  set targetY to 177.474088674589
  set targetZ to 0.000000000000
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.2 seconds
  # 12: home return
  set atTarget to 0
  set waypoint to 12
  set targetX to 0.000000000000
  set targetY to 202.474088674589
  set targetZ to 0.000000000000
  broadcast "Vector solve" and wait
  broadcast "Vector schedule" and wait
  broadcast "Vector move" and wait
  wait 0.35 seconds
  broadcast "Vector measure" and wait
  set atTarget to 1
  wait 0.5 seconds
  set completed to 1
  lab stop motor A hold
  lab stop motor B hold
  lab stop motor C hold
  say "Vector complete: three stations visited, tool head home, all three motors holding."

WHEN I receive "Vector solve":
  IF (((abs of targetX) > 30) or ((abs of targetZ) > 30)) or ((targetY < 175.474088674589) or (targetY > 204.474088674589)) THEN:
    set failed to 1
    say "XYZ target is outside the qualified Vector demonstration envelope."
    stop all
  set phi to 90
  broadcast "Vector leg" and wait
  set thetaA to theta
  set phi to 330
  broadcast "Vector leg" and wait
  set thetaB to theta
  set phi to 210
  broadcast "Vector leg" and wait
  set thetaC to theta
  set targetA to (-3 * (thetaA - 35))
  set targetB to (-3 * (thetaB - 35))
  set targetC to (-3 * (thetaC - 35))

WHEN I receive "Vector leg":
  set radial to ((targetX * (cos of phi)) + (targetZ * (sin of phi)))
  set D to (140 - radial)
  set q2 to (((targetX * targetX) + (targetY * targetY) + (targetZ * targetZ) + 19600) - (280 * radial))
  set rho to (sqrt of ((D * D) + (targetY * targetY)))
  set K to ((14400 + q2 - 19600) / (240 * rho))
  IF (K < -1) or (K > 1) THEN:
    set failed to 1
    say "Inverse-kinematics guard: target is unreachable."
    stop all
  set theta to ((90 - (atan of (D / targetY))) - (acos of K))
  IF (theta < 15) or (theta > 40) THEN:
    set failed to 1
    say "Shoulder-angle guard: target is outside the qualified range."
    stop all

WHEN I receive "Vector schedule":
  set deltaA to (targetA - (lab motor A angle))
  set deltaB to (targetB - (lab motor B angle))
  set deltaC to (targetC - (lab motor C angle))
  set maxDelta to (abs of deltaA)
  IF (abs of deltaB) > maxDelta THEN:
    set maxDelta to (abs of deltaB)
  IF (abs of deltaC) > maxDelta THEN:
    set maxDelta to (abs of deltaC)
  IF maxDelta < 0.1 THEN:
    set maxDelta to 0.1
  set speedA to (15 * ((abs of deltaA) / maxDelta))
  IF speedA < 3 THEN:
    set speedA to 3
  set speedB to (15 * ((abs of deltaB) / maxDelta))
  IF speedB < 3 THEN:
    set speedB to 3
  set speedC to (15 * ((abs of deltaC) / maxDelta))
  IF speedC < 3 THEN:
    set speedC to 3

WHEN I receive "Vector move":
  lab run motor A for deltaA degrees at speedA degrees per second
  lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 1.5 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    lab stop motor C hold
    say "Motor A did not reach its target. Inspect the mechanism, then Reset."
    stop all

WHEN I receive "Vector move":
  lab run motor B for deltaB degrees at speedB degrees per second
  lab stop motor B hold
  IF (abs of (targetB - (lab motor B angle))) > 1.5 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    lab stop motor C hold
    say "Motor B did not reach its target. Inspect the mechanism, then Reset."
    stop all

WHEN I receive "Vector move":
  lab run motor C for deltaC degrees at speedC degrees per second
  lab stop motor C hold
  IF (abs of (targetC - (lab motor C angle))) > 1.5 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    lab stop motor C hold
    say "Motor C did not reach its target. Inspect the mechanism, then Reset."
    stop all

WHEN I receive "Vector measure":
  set measuredX to (((lab part "tool_star" x) - (lab part "hub" x)) - homeX)
  set measuredY to (((lab part "tool_star" y) - (lab part "hub" y)) - homeY)
  set measuredZ to (((lab part "tool_star" z) - (lab part "hub" z)) - homeZ)
  set actualError to (sqrt of (((measuredX - (targetZ * 0.04)) * (measuredX - (targetZ * 0.04))) + ((measuredY + ((targetY - 202.474088674589) * 0.04)) * (measuredY + ((targetY - 202.474088674589) * 0.04))) + ((measuredZ - (targetX * 0.04)) * (measuredZ - (targetX * 0.04)))))
  IF actualError > 0.3 THEN:
    set failed to 1
    lab stop motor A hold
    lab stop motor B hold
    lab stop motor C hold
    say "Tool-position guard: movement differs from the XYZ target. Inspect and Reset."
    stop all

WHEN I receive "Vector watchdog":
  repeat until completed = 1:
    IF timer > 90 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      lab stop motor C hold
      say "90 second watchdog: all three motors stopped and holding. Reset to retry."
      stop all
    wait 0.02 seconds
