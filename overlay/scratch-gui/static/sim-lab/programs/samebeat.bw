# Samebeat — one unchanged compound pendulum, three suspension holes.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Load one matching model and Reset to the saved vertical pose.
# The same bytes excite all three assemblies. Only support motor A is driven.
# A short outward-and-return support pulse is followed by 22 seconds of free swing.
# Motor A holds its original input datum while the pendulum remains passive.
# Relative moves use fresh unwrapped target-minus-current encoder readings.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL dwell = 0
GLOBAL stage = 0
GLOBAL held = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set held to 0
  IF (lab status) = "no-model" THEN:
    say "Import Samebeat or one of its pivot comparisons before starting."
    stop all
  set motor stop action A hold
  lab start
  lab stop motor A hold
  reset timer
  broadcast "Samebeat watchdog"
  wait 1 seconds
  IF (abs of (lab motor A angle)) > 1 THEN:
    broadcast "Samebeat fault" and wait
  set stage to 1
  set targetA to 8
  set dwell to 0.12
  say "A short support pulse starts the free pendulum."
  broadcast "Samebeat move and hold" and wait
  set stage to 2
  set targetA to 0
  set dwell to 22
  say "The support now holds still. Compare the free swing period."
  broadcast "Samebeat move and hold" and wait
  set completed to 1
  say "Complete. The input holds zero; the pendulum can keep swinging freely."

WHEN I receive "Samebeat move and hold":
  set held to 0
  IF (abs of (lab motor A angle)) > 10 THEN:
    broadcast "Samebeat fault" and wait
  IF (abs of (targetA - (lab motor A angle))) > 12 THEN:
    broadcast "Samebeat fault" and wait
  lab run motor A for (targetA - (lab motor A angle)) degrees at 60 degrees per second
  lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "Samebeat fault" and wait
  IF (abs of (lab motor A angle)) > 10 THEN:
    broadcast "Samebeat fault" and wait
  set held to 1
  wait dwell seconds
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "Samebeat fault" and wait

WHEN I receive "Samebeat watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 35 THEN:
      broadcast "Samebeat fault" and wait
    wait 0.02 seconds

WHEN I receive "Samebeat fault":
  set failed to 1
  lab stop motor A hold
  say "Input guard or 35-second watchdog failed. Reset to the saved pose."
  stop all
