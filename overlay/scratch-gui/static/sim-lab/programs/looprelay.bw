# LoopRelay — chain transfer, compounded 8:24 gear reduction and release.
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 CrispStrobe
# Run only from the file's saved encoder-0 pose, on port A.
# Input 0->+180->0 deg; chain stage +2/3, gear stage -1/3,
# reporter ideally -40 deg at peak input. 12 deg/s, no hard stop.
DEVICE SPIKE

WHEN flag clicked:
  lab start
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of (0 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  lab run motor A for (180 - (lab motor A angle)) degrees at 12 degrees per second
  lab stop motor A hold
  IF (abs of (180 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  wait 1 seconds
  lab run motor A for (0 - (lab motor A angle)) degrees at 12 degrees per second
  lab stop motor A hold
  IF (abs of (0 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  wait 0.5 seconds
  lab stop motor A hold
