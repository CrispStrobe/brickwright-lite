DEVICE SPIKE

# A deliberately wrong attempt: it counts every READING of yellow, not every
# marker, so the count is far too high and the rover drives into the wall.
GLOBAL finds
GLOBAL distance

DEFINE quarter turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement

WHEN flag clicked:
  set movement motors A B
  set finds to 0
  set movement speed 30
  start moving steering 0
  REPEAT UNTIL spike color C is red:
    IF spike color C is yellow THEN:
      change finds by 1
  stop movement
  quarter turn right
  set movement speed 30
  set distance to (finds * 15)
  move forward distance cm
