DEVICE SPIKE

# Mapping 1 - count the finds (reference solution).
# Counts a marker when yellow begins: onMarker remembers the last reading.
GLOBAL finds
GLOBAL onMarker
GLOBAL distance

DEFINE quarter turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement

WHEN flag clicked:
  set movement motors A B
  set finds to 0
  set onMarker to 0
  set movement speed 30
  start moving steering 0
  REPEAT UNTIL spike color C is red:
    IF spike color C is yellow THEN:
      IF onMarker = 0 THEN:
        change finds by 1
      set onMarker to 1
    ELSE:
      set onMarker to 0
  stop movement
  quarter turn right
  set movement speed 30
  set distance to (finds * 15)
  move forward distance cm
