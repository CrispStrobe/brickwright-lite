DEVICE SPIKE

# Mapping 3 - replay the route (reference solution).
GLOBAL LIST route
GLOBAL i

DEFINE quarter turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement

DEFINE quarter turn left:
  set movement speed 15
  reset yaw
  start moving steering -100
  wait until spike angle yaw < -87
  stop movement

WHEN flag clicked:
  set movement motors A B
  delete all of route
  set movement speed 30
  REPEAT 3:
    move forward 20 cm
    add (spike color C) to route
  set i to 1
  REPEAT (length of route):
    IF (item i of route) = "red" THEN:
      quarter turn right
    ELSE:
      quarter turn left
    set movement speed 30
    move forward 25 cm
    change i by 1
