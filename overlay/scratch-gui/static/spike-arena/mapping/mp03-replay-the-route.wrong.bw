DEVICE SPIKE

# A deliberately wrong attempt: one variable instead of a list. It only
# remembers the last tile (green), turns left three times and drives out of
# the site into the fence.
GLOBAL tile

DEFINE quarter turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement

DEFINE quarter turn left:
  set movement speed 15
  reset yaw
  start moving steering -100
  wait until spike angle yaw < -87
  stop movement

WHEN flag clicked:
  set movement motors A B
  set movement speed 30
  REPEAT 3:
    move forward 20 cm
    set tile to (spike color C)
  REPEAT 3:
    IF tile = "red" THEN:
      quarter turn right
    ELSE:
      quarter turn left
    set movement speed 30
    move forward 25 cm
