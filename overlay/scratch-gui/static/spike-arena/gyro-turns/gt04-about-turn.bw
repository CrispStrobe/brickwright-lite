DEVICE SPIKE

# Gyro turns 4 - about turn (reference solution).
# The yaw wraps at 180, so compare its absolute value.
WHEN flag clicked:
  set movement motors A B
  set movement speed 40
  move forward 50 cm
  reset yaw
  set movement speed 15
  start moving steering 100
  wait until (abs of spike angle yaw) > 177
  stop movement
  set movement speed 40
  move forward 50 cm
