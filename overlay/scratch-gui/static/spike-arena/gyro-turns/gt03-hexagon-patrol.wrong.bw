DEVICE SPIKE

# A deliberately wrong attempt: it turns by the hexagon's INSIDE angle, 120
# degrees. That draws a triangle, whose third corner is the pond.
GLOBAL turn

DEFINE gyro turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > (turn - 3)
  stop movement

WHEN flag clicked:
  set movement motors A B
  set turn to 120
  REPEAT 6:
    set movement speed 40
    move forward 30 cm
    gyro turn right
