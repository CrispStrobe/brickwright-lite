DEVICE SPIKE

# Gyro turns 3 - hexagon patrol (reference solution).
GLOBAL turn

DEFINE gyro turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > (turn - 3)
  stop movement

WHEN flag clicked:
  set movement motors A B
  set turn to (360 / 6)
  REPEAT 6:
    set movement speed 40
    move forward 30 cm
    gyro turn right
