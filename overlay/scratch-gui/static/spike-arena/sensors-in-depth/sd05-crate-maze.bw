DEVICE SPIKE

# Sensors in depth 5 - feel the way (reference solution).
DEFINE drive until touch:
  set movement speed 30
  start moving steering 0
  wait until spike force sensor E pressed
  stop movement
  set movement speed 30
  move backward 8 cm

DEFINE quarter turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement

DEFINE quarter turn left:
  set movement speed 15
  reset yaw
  start moving steering -100
  wait until spike angle yaw < -87
  stop movement

WHEN flag clicked:
  set movement motors A B
  drive until touch
  quarter turn right
  drive until touch
  quarter turn left
  set movement speed 30
  start moving steering 0
  wait until spike force sensor E pressed
  stop movement
