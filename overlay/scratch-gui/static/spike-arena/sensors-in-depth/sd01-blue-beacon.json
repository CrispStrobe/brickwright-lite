  "intro": {
    "en": "The runway to the hangar is crossed by stripes in several colours. The hangar door opens only when the rover waits on the BLUE stripe. Drive forward and stop on blue - not on the first colour you meet.",
    "de": "Die Rollbahn zum Hangar wird von Streifen in mehreren Farben gekreuzt. Das Hangartor öffnet sich nur, wenn der Rover auf dem BLAUEN Streifen wartet. Fahre los und halte auf Blau - nicht auf der ersten Farbe, die dir begegnet."
  },
  "hints": [
    {
      "en": "The colour sensor reports one colour at a time. Ask it about exactly the colour you want.",
      "de": "Der Farbsensor meldet immer eine Farbe. Frag ihn genau nach der Farbe, die du suchst."
    },
    {
      "en": "Beyond the blue stripe the ice is thin: do not drive past it.",
      "de": "Hinter dem blauen Streifen ist das Eis dünn: fahre nicht darüber hinaus."
    }
  ],
