DEVICE SPIKE

# Sensors in depth 4 - the door in the wall (reference solution).
# The distance sensor looks LEFT here. It sits beside the axle, so once it
# sees the door's first edge, the rover drives half a door further.
WHEN flag clicked:
  set movement motors A B
  set movement speed 30
  start moving steering 0
  wait until spike distance D > 25
  move forward 13 cm
  set movement speed 15
  reset yaw
  start moving steering -100
  wait until spike angle yaw < -87
  stop movement
  set movement speed 30
  move forward 40 cm
