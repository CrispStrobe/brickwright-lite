DEVICE SPIKE

# A deliberately wrong attempt: it turns right where it touched the crate,
# without backing off. The rover's corner jams against the crate and the
# turn never finishes.
DEFINE quarter turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement

WHEN flag clicked:
  set movement motors A B
  set movement speed 30
  start moving steering 0
  wait until spike force sensor E pressed
  stop movement
  quarter turn right
  set movement speed 30
  start moving steering 0
  wait until spike force sensor E pressed
  stop movement
