DEVICE SPIKE

# Capstone - supply run (reference solution).
# The yaw is reset ONCE, facing east; every turn goes to an absolute yaw.
GLOBAL target

DEFINE turn right to target:
  set movement speed 15
  start moving steering 100
  wait until spike angle yaw > (target - 3)
  stop movement

DEFINE turn left to target:
  set movement speed 15
  start moving steering -100
  wait until spike angle yaw < (target + 3)
  stop movement

WHEN flag clicked:
  set movement motors A B
  reset yaw
  # 1: follow the track's left edge to the red end
  REPEAT UNTIL spike color C is red:
    IF spike color C is black THEN:
      start tank 8 30
    ELSE:
      start tank 30 8
  stop movement
  # 2: face north, drive until the button is pressed
  set target to -90
  turn left to target
  set movement speed 30
  start moving steering 0
  wait until spike force sensor E pressed
  stop movement
  # 3: back off, face east, push the crate onto the depot
  move backward 12 cm
  set target to 0
  turn right to target
  set movement speed 30
  move forward 40 cm
  # 4: back off, face south, park 15 cm from the south wall
  move backward 6 cm
  set target to 90
  turn right to target
  set movement speed 30
  start moving steering 0
  wait until spike distance D < 15
  stop movement
