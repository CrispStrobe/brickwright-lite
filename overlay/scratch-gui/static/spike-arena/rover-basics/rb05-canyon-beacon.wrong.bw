DEVICE SPIKE

# A deliberately wrong attempt: the first leg is too long and runs into the wall.
DEFINE quarter turn right:
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement

WHEN flag clicked:
  set movement motors A B
  set movement speed 50
  move forward 100 cm
  quarter turn right
  set movement speed 50
  move forward 50 cm
