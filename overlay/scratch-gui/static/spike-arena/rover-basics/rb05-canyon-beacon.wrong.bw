DEVICE SPIKE

# A deliberately wrong attempt: the first leg is too long and runs into the wall.
DEFINE quarter turn right:
  reset yaw
  set motor speed A 15
  set motor speed B 15
  start motor A counterclockwise
  start motor B counterclockwise
  wait until spike angle yaw > 87
  stop motor A
  stop motor B

WHEN flag clicked:
  set motor speed A 50
  set motor speed B 50
  move forward 100 cm
  wait 3 seconds
  quarter turn right
  move forward 50 cm
