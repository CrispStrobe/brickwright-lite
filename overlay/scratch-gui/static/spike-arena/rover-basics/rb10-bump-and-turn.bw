DEVICE SPIKE

# Rover basics 10 - bump and turn (reference solution).
DEFINE quarter turn left:
  reset yaw
  set motor speed A 15
  set motor speed B 15
  start motor A clockwise
  start motor B clockwise
  wait until spike angle yaw < -87
  stop motor A
  stop motor B

WHEN flag clicked:
  set motor speed A 30
  set motor speed B 30
  start motor A counterclockwise
  start motor B clockwise
  wait until spike force sensor E pressed
  stop motor A
  stop motor B
  # "move" returns before the rover has arrived, so a wait follows it.
  move backward 10 cm
  wait 1 seconds
  quarter turn left
  set motor speed A 50
  set motor speed B 50
  move forward 30 cm
