  "title": {
    "en": "Follow the track",
    "de": "Folge der Spur"
  },
  "intro": {
    "en": "An earlier rover left a black track across the plain to the landing site. Follow its left edge with the colour sensor all the way to the green pad. On black, steer left; off it, steer right.",
    "de": "Ein früherer Rover hat eine schwarze Spur über die Ebene bis zum Landeplatz hinterlassen. Folge mit dem Farbsensor ihrer linken Kante bis zum grünen Feld. Auf Schwarz lenke nach links, daneben nach rechts."
  },
  "hints": [
    {
      "en": "Steer by running one wheel slower than the other, inside a forever loop.",
      "de": "Lenke, indem ein Rad langsamer läuft als das andere - in einer Endlosschleife."
    },
    {
      "en": "The sensor must keep crossing the edge; if it stays on one side for long, it has lost the line.",
      "de": "Der Sensor muss die Kante immer wieder kreuzen; bleibt er lange auf einer Seite, hat er die Linie verloren."
    }
  ],
