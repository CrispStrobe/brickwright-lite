DEVICE SPIKE

# Rover basics 2 - face the ridge (reference solution).
# Steering 100 turns one wheel forward and the other backward: the rover
# spins right on the spot. A slow turn stops precisely.
WHEN flag clicked:
  set movement motors A B
  set movement speed 15
  reset yaw
  start moving steering 100
  wait until spike angle yaw > 87
  stop movement
