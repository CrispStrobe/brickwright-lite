DEVICE SPIKE

# Rover basics 8 - follow the track (reference solution).
# Follows the LEFT edge of the line: on black steer left, off it steer right.
WHEN flag clicked:
  FOREVER:
    IF spike color C is black THEN:
      set motor speed A 8
      set motor speed B 30
    ELSE:
      set motor speed A 30
      set motor speed B 8
    start motor A counterclockwise
    start motor B clockwise
