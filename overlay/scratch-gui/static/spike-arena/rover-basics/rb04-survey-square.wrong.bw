DEVICE SPIKE

# A deliberately wrong attempt: turning LEFT at the corners drives the square
# the other way round and out through the top of the mat.
DEFINE quarter turn left:
  reset yaw
  set motor speed A 15
  set motor speed B 15
  start motor A clockwise
  start motor B clockwise
  wait until spike angle yaw < -87
  stop motor A
  stop motor B

WHEN flag clicked:
  REPEAT 4:
    set motor speed A 50
    set motor speed B 50
    move forward 50 cm
    wait 2 seconds
    quarter turn left
