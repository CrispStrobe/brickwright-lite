{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {"api/handler.mjs": {"maxDuration": 60}},
  "rewrites": [{"source": "/api/v1/:path*", "destination": "/api/handler?route=:path*"}],
  "headers": [{"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]}]
}
