{
  "openapi": "3.1.0",
  "info": {"title": "Brickwright Model Measurement API", "version": "1.0.0", "description": "Bounded, token-protected native simulation measurements. Run completion is separate from model qualification."},
  "servers": [{"url": "/api/v1"}],
  "security": [{"agentToken": []}],
  "components": {"securitySchemes": {"agentToken": {"type": "http", "scheme": "bearer"}}, "schemas": {"File": {"type": "object", "additionalProperties": false, "required": ["name", "text"], "properties": {"name": {"type": "string", "maxLength": 128}, "text": {"type": "string"}}}, "Submission": {"type": "object", "additionalProperties": false, "required": ["model"], "properties": {"model": {"$ref": "#/components/schemas/File"}, "program": {"$ref": "#/components/schemas/File"}, "settings": {"type": "object", "properties": {"programMs": {"type": "integer", "minimum": 250, "maximum": 120000, "multipleOf": 25}, "coldMs": {"type": "integer", "minimum": 0, "maximum": 2000, "multipleOf": 25}, "afterMs": {"type": "integer", "minimum": 0, "maximum": 30000, "multipleOf": 25}, "sampleMs": {"type": "integer", "minimum": 25, "maximum": 5000, "multipleOf": 25}}}, "measurements": {"type": "array", "maxItems": 64, "items": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"type": "string", "maxLength": 128}, "kind": {"enum": ["mass", "weight", "speed", "angularSpeed", "distance", "angle", "jointAngle", "jointSpeed", "travel", "tension", "normalLoad", "pointCoordinate", "signedAngle", "hingeGap", "programVariable"]}}}}}}}},
  "paths": {
    "/capabilities": {"get": {"responses": {"200": {"description": "Supported measurements and bounds"}, "401": {"description": "Authentication required"}}}},
    "/runs": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Submission"}}}}, "responses": {"202": {"description": "Queued; response contains signed job id and status/result URLs"}, "401": {"description": "Authentication required"}, "413": {"description": "Body or compressed dispatch too large"}, "422": {"description": "Invalid typed input"}, "503": {"description": "Worker unavailable"}}}},
    "/runs/{id}": {"parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "get": {"responses": {"200": {"description": "Worker status"}, "404": {"description": "Unknown, expired or foreign-owned job"}}}},
    "/runs/{id}/result": {"parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "get": {"responses": {"200": {"description": "Measurement or failed-run report, with input/runtime identity and units"}, "404": {"description": "Unknown or foreign-owned job"}, "409": {"description": "Result not ready"}, "410": {"description": "Artifact expired or unavailable"}}}}
  }
}
