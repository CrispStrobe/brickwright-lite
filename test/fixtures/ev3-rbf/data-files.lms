// Program-relative binary files, append/truncate, short EOF and shared handle isolation.
DATA32 Size
DATA32 First
DATA32 Second
DATA32 Third
DATA32 Fourth
DATA32 Fifth
DATA32 Terminator
DATA32 Tail
DATA32 NewSize
DATA32 MissingSize
DATA32 ArrayValue

vmthread MAIN
{
  HANDLE file
  HANDLE array
  ARRAY8 Bytes 8
  DATA8 Byte

  ARRAY(CREATE8, 2, array)
  ARRAY(FILL, array, 7)
  WRITE8(72, 0, Bytes)
  WRITE8(0, 1, Bytes)
  WRITE8(73, 2, Bytes)
  FILE(OPEN_WRITE, 'trace.bin', file)
  FILE(WRITE_BYTES, file, 3, Bytes)
  FILE(CLOSE, file)
  FILE(OPEN_APPEND, 'trace.bin', file)
  WRITE8(74, 0, Bytes)
  WRITE8(75, 1, Bytes)
  FILE(WRITE_BYTES, file, 2, Bytes)
  FILE(CLOSE, file)
  FILE(OPEN_READ, 'trace.bin', file, Size)
  WRITE8(99, 0, Bytes)
  WRITE8(99, 1, Bytes)
  WRITE8(99, 2, Bytes)
  WRITE8(99, 3, Bytes)
  WRITE8(99, 4, Bytes)
  WRITE8(99, 5, Bytes)
  FILE(READ_BYTES, file, 2, Bytes)
  READ8(Bytes, 0, Byte)
  MOVE8_32(Byte, First)
  READ8(Bytes, 1, Byte)
  MOVE8_32(Byte, Second)
  FILE(READ_BYTES, file, 5, Bytes)
  READ8(Bytes, 0, Byte)
  MOVE8_32(Byte, Third)
  READ8(Bytes, 1, Byte)
  MOVE8_32(Byte, Fourth)
  READ8(Bytes, 2, Byte)
  MOVE8_32(Byte, Fifth)
  READ8(Bytes, 3, Byte)
  MOVE8_32(Byte, Terminator)
  READ8(Bytes, 4, Byte)
  MOVE8_32(Byte, Tail)
  FILE(CLOSE, file)
  FILE(OPEN_WRITE, 'trace.bin', file)
  FILE(WRITE_BYTES, file, 1, Bytes)
  FILE(CLOSE, file)
  FILE(OPEN_READ, 'trace.bin', file, NewSize)
  FILE(READ_BYTES, file, 0, Bytes)
  FILE(CLOSE, file)
  FILE(OPEN_READ, 'missing.bin', file, MissingSize)
  ARRAY_READ(array, 1, Byte)
  MOVE8_32(Byte, ArrayValue)
  UI_WRITE(VALUE32, Size)
  UI_WRITE(VALUE32, First)
  UI_WRITE(VALUE32, Second)
  UI_WRITE(VALUE32, Third)
  UI_WRITE(VALUE32, Fourth)
  UI_WRITE(VALUE32, Fifth)
  UI_WRITE(VALUE32, Terminator)
  UI_WRITE(VALUE32, Tail)
  UI_WRITE(VALUE32, NewSize)
  UI_WRITE(VALUE32, MissingSize)
  UI_WRITE(VALUE32, ArrayValue)
}
