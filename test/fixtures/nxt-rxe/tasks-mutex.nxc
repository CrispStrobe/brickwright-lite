// Three tasks: main starts two workers (Precedes) that share a counter under a mutex; a reporter
// follows both and shows the total (Brickwright NXT .rxe VM fixture).
mutex lock;
int counter = 0;

task worker1()
{
    repeat (50) {
        Acquire(lock);
        int seen = counter;
        Yield();
        counter = seen + 1;
        Release(lock);
    }
}

task worker2()
{
    repeat (50) {
        Acquire(lock);
        int seen = counter;
        Yield();
        counter = seen + 2;
        Release(lock);
    }
}

task reporter()
{
    Follows(worker1, worker2);
    NumOut(0, LCD_LINE1, counter);
}

task main()
{
    Precedes(worker1, worker2);
}
