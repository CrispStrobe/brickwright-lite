// Stock name-based syscall ABI; tests seed button 1 with one short release and hold it.
task main()
{
    IOMapReadType r;
    IOMapWriteType w;
    byte data[];
    int size;
    r.ModuleName = "Button.mod";
    r.Offset = 33;
    r.Count = 1;
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Result);
    NumOut(0, LCD_LINE1, r.Buffer[0]);
    r.Offset = 10;
    r.Count = 3;
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Result);
    NumOut(0, LCD_LINE1, r.Buffer[0]);
    NumOut(0, LCD_LINE1, r.Buffer[1]);
    NumOut(0, LCD_LINE1, r.Buffer[2]);
    w.ModuleName = "Button.mod";
    w.Offset = 10;
    ArrayInit(data, 0, 3);
    data[0] = 1;
    w.Buffer = data;
    SysIOMapWrite(w);
    NumOut(0, LCD_LINE1, w.Result);
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Buffer[2]);
    data[0] = 0;
    w.Buffer = data;
    SysIOMapWrite(w);
    NumOut(0, LCD_LINE1, w.Result);
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Buffer[0]);
    NumOut(0, LCD_LINE1, r.Buffer[1]);
    NumOut(0, LCD_LINE1, r.Buffer[2]);
    r.Offset = 33;
    r.Count = 1;
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Buffer[0]);
    ArrayInit(data, 99, 1);
    r.Buffer = data;
    r.ModuleName = "Missing.mod";
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Result);
    size = ArrayLen(r.Buffer);
    NumOut(0, LCD_LINE1, size);
    NumOut(0, LCD_LINE1, r.Buffer[0]);
    r.ModuleName = "Button.mod";
    r.Offset = 35;
    r.Count = 2;
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Result);
    NumOut(0, LCD_LINE1, r.Buffer[0]);
    r.Count = 65;
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Result);
    size = ArrayLen(r.Buffer);
    NumOut(0, LCD_LINE1, size);
    ArrayInit(data, 0, 65);
    w.Buffer = data;
    SysIOMapWrite(w);
    NumOut(0, LCD_LINE1, w.Result);
    r.Count = 64;
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Result);
    r.Offset = 36;
    r.Count = 0;
    SysIOMapRead(r);
    NumOut(0, LCD_LINE1, r.Result);
    size = ArrayLen(r.Buffer);
    NumOut(0, LCD_LINE1, size);
    w.Offset = 36;
    w.Buffer = r.Buffer;
    SysIOMapWrite(w);
    NumOut(0, LCD_LINE1, w.Result);
    Wait(100);
    NumOut(0, LCD_LINE1, 999);
}
