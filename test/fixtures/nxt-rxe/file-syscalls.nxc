// Standard file-call ABI: binary extents, append, resolve, rename, list, EOF and retirement.
task main()
{
    FileOpenType opened;
    FileReadWriteType transfer;
    FileCloseType closed;
    FileResolveHandleType resolved;
    FileRenameType renamed;
    FileDeleteType deleted;
    ListFilesType listed;
    byte raw[];
    ArrayInit(raw, 65, 70);
    raw[1] = 0;
    raw[69] = 90;
    opened.Filename = "proof.dat";
    opened.Length = 80;
    SysFileOpenWrite(opened);
    NumOut(0, LCD_LINE1, opened.Result); // 0
    resolved.Filename = "proof.dat";
    SysFileResolveHandle(resolved);
    NumOut(0, LCD_LINE1, resolved.Result); // 0
    NumOut(0, LCD_LINE1, resolved.WriteHandle); // 1
    bool same = resolved.FileHandle == opened.FileHandle;
    NumOut(0, LCD_LINE1, same); // 1
    transfer.FileHandle = opened.FileHandle;
    transfer.Buffer = FlattenVar(raw);
    transfer.Length = 70;
    SysFileWrite(transfer);
    NumOut(0, LCD_LINE1, transfer.Result); // 0
    NumOut(0, LCD_LINE1, transfer.Length); // 70
    closed.FileHandle = opened.FileHandle;
    SysFileClose(closed);
    NumOut(0, LCD_LINE1, closed.Result); // 0
    SysFileOpenAppend(opened);
    NumOut(0, LCD_LINE1, opened.Result); // 0
    NumOut(0, LCD_LINE1, opened.Length); // 10
    transfer.FileHandle = opened.FileHandle;
    transfer.Buffer = "BC";
    transfer.Length = 2;
    SysFileWrite(transfer);
    NumOut(0, LCD_LINE1, transfer.Result); // 0
    closed.FileHandle = opened.FileHandle;
    SysFileClose(closed);
    renamed.OldFilename = "proof.dat";
    renamed.NewFilename = "renamed.dat";
    SysFileRename(renamed);
    NumOut(0, LCD_LINE1, renamed.Result); // 0
    opened.Filename = "renamed.dat";
    SysFileOpenRead(opened);
    NumOut(0, LCD_LINE1, opened.Result); // 0
    NumOut(0, LCD_LINE1, opened.Length); // 72
    SysFileResolveHandle(resolved);
    NumOut(0, LCD_LINE1, resolved.Result); // 34816: old name is no longer open
    renamed.OldFilename = "renamed.dat";
    renamed.NewFilename = "busy.dat";
    SysFileRename(renamed);
    NumOut(0, LCD_LINE1, renamed.Result); // 35584: open source is busy
    transfer.FileHandle = opened.FileHandle;
    transfer.Length = 80;
    SysFileRead(transfer);
    NumOut(0, LCD_LINE1, transfer.Result); // 34048: EOF, not a signed byte
    NumOut(0, LCD_LINE1, transfer.Length); // 72, no telegram 58-byte clamp
    byte value = StrIndex(transfer.Buffer, 0);
    NumOut(0, LCD_LINE1, value); // 65
    value = StrIndex(transfer.Buffer, 1);
    NumOut(0, LCD_LINE1, value); // 0: embedded binary zero
    value = StrIndex(transfer.Buffer, 69);
    NumOut(0, LCD_LINE1, value); // 90
    value = StrIndex(transfer.Buffer, 70);
    NumOut(0, LCD_LINE1, value); // 66
    value = StrIndex(transfer.Buffer, 71);
    NumOut(0, LCD_LINE1, value); // 67
    closed.FileHandle = opened.FileHandle;
    SysFileClose(closed);
    listed.Pattern = "*.dat";
    SysListFiles(listed);
    NumOut(0, LCD_LINE1, listed.Result); // 0
    int count = ArrayLen(listed.FileList);
    NumOut(0, LCD_LINE1, count); // 1
    TextOut(0, LCD_LINE1, listed.FileList[0]); // renamed.dat
    deleted.Filename = "renamed.dat";
    SysFileDelete(deleted);
    NumOut(0, LCD_LINE1, deleted.Result); // 0
    opened.Length = 777;
    SysFileOpenRead(opened);
    NumOut(0, LCD_LINE1, opened.Result); // 34560: missing
    NumOut(0, LCD_LINE1, opened.Length); // 777: failed read-open preserves length
    opened.Filename = "crop.dat";
    opened.Length = 20;
    SysFileOpenWrite(opened);
    transfer.FileHandle = opened.FileHandle;
    transfer.Buffer = "XYZ";
    transfer.Length = 3;
    SysFileWrite(transfer);
    NumOut(0, LCD_LINE1, transfer.Result); // 0
    // Intentionally leave this VM-owned writer open. Stop or normal completion crops it to 3 bytes.
    Wait(1000);
}
