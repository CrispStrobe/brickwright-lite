DEVICE MICROBIT AS Remote:

WHEN flag clicked:
  radio on group 1 power 7

WHEN flag clicked:
  FOREVER:
    IF read button_a THEN:
      radio send number 0
    ELSE:
      radio send number 1
    IF read button_b THEN:
      radio send number 2
    ELSE:
      radio send number 3

DEVICE CALLIOPEMINI AS Car:

WHEN flag clicked:
  radio on group 1 power 7

WHEN radio receives number:
  IF read last radio number = 0 THEN:
    calliope motor A power 50 %
  IF read last radio number = 1 THEN:
    calliope motor A power 0 %
  IF read last radio number = 2 THEN:
    calliope motor B power 50 %
  IF read last radio number = 3 THEN:
    calliope motor B power 0 %
