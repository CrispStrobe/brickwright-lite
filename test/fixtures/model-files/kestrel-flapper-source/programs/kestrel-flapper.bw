# KESTREL — Crank-rocker flapping machine.
# Open kestrel-flapper.ldr in Robot Lab, select Plain, Reset, then Run.
# Motor A turns the crank. The closed four-bar linkage moves the rocker
# and its wing; no output position, angle or motion is scripted.
# Stage1: two forward crank turns. Stage2: hold. Stage3: reverse to the
# original input angle. Stage4: settle. Stage5: complete.
# Reset the complete model before every run. Keep the supplied demo speed.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL stage
GLOBAL inputTurns
GLOBAL moveDegrees

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set inputTurns to 0
  set moveDegrees to 0
  IF ((lab status) = "no-model") or ((lab status) = "not-open") THEN:
    set failed to 1
    say "Open Kestrel in Robot Lab, select Plain, then Reset and Run."
    stop all
  lab start
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of (lab motor A angle)) > 5 THEN:
    set failed to 1
    say "Reset the complete Kestrel model before this demonstration."
    stop all
  reset timer
  broadcast "Kestrel observe"
  broadcast "Kestrel watchdog"
  set stage to 1
  say "FORWARD: two crank turns create two complete wing strokes."
  set moveDegrees to (720 - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 45 degrees per second
  lab stop motor A hold
  set stage to 2
  wait 0.75 seconds
  IF (abs of ((lab motor A angle) - 720)) > 2 THEN:
    set failed to 1
    say "The forward input did not finish. Inspect the model and Reset."
    stop all
  set stage to 3
  say "REVERSE: the same linkage retraces both strokes."
  set moveDegrees to (0 - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 45 degrees per second
  lab stop motor A hold
  set stage to 4
  wait 0.75 seconds
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "The return input did not finish. Inspect the model and Reset."
    stop all
  set stage to 5
  set completed to 1
  say "Kestrel complete: two forward and two reverse wing strokes. Reset to repeat."

WHEN I receive "Kestrel observe":
  repeat until completed = 1:
    set inputTurns to ((lab motor A angle) / 360)
    wait 0.05 seconds

WHEN I receive "Kestrel watchdog":
  repeat until completed = 1:
    IF timer > 50 THEN:
      set failed to 1
      lab stop motor A hold
      say "Kestrel stopped after its time limit. Inspect the model and Reset."
      stop all
    wait 0.05 seconds
