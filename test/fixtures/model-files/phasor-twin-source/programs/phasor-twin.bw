# Phasor Twin — Stirling phase quadrature engine
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Original finite experiment. Load model.ldr and reset it to its saved pose.
# One SPIKE medium motor on A drives the middle 24T idler; the two crank shafts
# follow 1:1 in the same direction through the 24T-24T-24T train. Both pistons,
# both connecting rods and the crank plates are passive.
# Stage 1: +720 deg at 45 deg/s (two full crank turns). Stage 2: back to 0.
# The law is geometric, so a single slow sweep is enough; the second sweep
# checks reversal and repeatability. Holds are the only judged still periods.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL settled = 0
GLOBAL targetA = 0
GLOBAL correctionAttempts = 0

WHEN flag clicked:
  set stage to 0
  set completed to 0
  set failed to 0
  set settled to 0
  set targetA to 0
  set correctionAttempts to 0
  reset timer
  lab start
  lab stop motor A hold
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Load Phasor Twin and reset its saved pose before running."
    stop all
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Phasor Twin: encoder datum is not the saved pose. Reset the model."
    stop all
  broadcast "Phasor Twin watchdog"
  set stage to 1
  set targetA to 720
  broadcast "Phasor Twin move" and wait
  set settled to 1
  wait 1.5 seconds
  set settled to 0
  set stage to 2
  set targetA to 0
  broadcast "Phasor Twin move" and wait
  set settled to 1
  wait 1.5 seconds
  set settled to 0
  lab stop motor A hold
  set stage to 3
  set completed to 1
  say "Phasor Twin complete: compare the two passive piston traces."

WHEN I receive "Phasor Twin move":
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 45 degrees per second
  lab stop motor A hold
  set correctionAttempts to 0
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      change correctionAttempts by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 12 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  broadcast "Phasor Twin arrival guard" and wait

WHEN I receive "Phasor Twin arrival guard":
  IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "Phasor Twin missed its encoder target. Inspect and reset."
    stop all

WHEN I receive "Phasor Twin watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 120 THEN:
      lab stop motor A hold
      set failed to 1
      say "Phasor Twin: 120 second watchdog stopped the experiment."
      stop all
    wait 0.1 seconds
