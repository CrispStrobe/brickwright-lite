# EQUINOX — Differential lab.
# Open equinox-differential.ldr in Robot Lab, select Plain, Reset, then Run.
# A drives the 28T carrier through a 12T pinion. B brakes the right output;
# C brakes the left output. Both use only coast or hold, never drive commands.
# Stages: both free, right held, left held, both free in reverse.
# Matching output motors make the free phase visually balanced. Friction can
# still change the split: the signed output mean tracks the carrier speed.
# Each input move targets an absolute A-encoder checkpoint so arrival
# tolerance does not accumulate. No output angle is commanded.
# Reset the complete model before every run. Keep the supplied demo speed.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL stage
GLOBAL inputTurns
GLOBAL rightBrakeTurns
GLOBAL leftBrakeTurns
GLOBAL moveDegrees

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set inputTurns to 0
  set rightBrakeTurns to 0
  set leftBrakeTurns to 0
  set moveDegrees to 0
  IF ((lab status) = "no-model") or ((lab status) = "not-open") THEN:
    set failed to 1
    say "Open Equinox in Robot Lab, select Plain, then Reset and Run."
    stop all
  lab start
  lab stop motor A hold
  lab stop motor B coast
  lab stop motor C coast
  wait 0.5 seconds
  IF ((abs of (lab motor A angle)) > 5) or (((abs of (lab motor B angle)) > 5) or ((abs of (lab motor C angle)) > 5)) THEN:
    set failed to 1
    lab stop motor B hold
    lab stop motor C hold
    say "Reset the complete Equinox model before this demonstration."
    stop all
  reset timer
  broadcast "Equinox observe"
  broadcast "Equinox watchdog"
  set stage to 0
  lab stop motor B coast
  lab stop motor C coast
  wait 0.5 seconds
  set stage to 1
  say "FREE: watch both outputs share the carrier motion."
  set moveDegrees to (840 - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 105 degrees per second
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of ((lab motor A angle) - 840)) > 2 THEN:
    set failed to 1
    lab stop motor B hold
    lab stop motor C hold
    say "Input stage 1 did not finish. Inspect the model and Reset."
    stop all
  set stage to 0
  lab stop motor B hold
  lab stop motor C coast
  wait 0.5 seconds
  set stage to 2
  say "RIGHT HELD: the left output turns twice per carrier turn."
  set moveDegrees to (1680 - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 105 degrees per second
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of ((lab motor A angle) - 1680)) > 2 THEN:
    set failed to 1
    lab stop motor B hold
    lab stop motor C hold
    say "Input stage 2 did not finish. Inspect the model and Reset."
    stop all
  set stage to 0
  lab stop motor B coast
  lab stop motor C hold
  wait 0.5 seconds
  set stage to 3
  say "LEFT HELD: the right output now takes both shares."
  set moveDegrees to (2520 - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 105 degrees per second
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of ((lab motor A angle) - 2520)) > 2 THEN:
    set failed to 1
    lab stop motor B hold
    lab stop motor C hold
    say "Input stage 3 did not finish. Inspect the model and Reset."
    stop all
  set stage to 0
  lab stop motor B coast
  lab stop motor C coast
  wait 0.5 seconds
  set stage to 4
  say "FREE REVERSE: both output wheels turn the other way."
  set moveDegrees to (0 - (lab motor A angle))
  lab run motor A for moveDegrees degrees at 105 degrees per second
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of ((lab motor A angle) - 0)) > 2 THEN:
    set failed to 1
    lab stop motor B hold
    lab stop motor C hold
    say "Input stage 4 did not finish. Inspect the model and Reset."
    stop all
  lab stop motor B hold
  lab stop motor C hold
  wait 0.5 seconds
  set stage to 5
  set completed to 1
  say "Equinox complete: free, right held, left held, and reverse. Reset to repeat."

WHEN I receive "Equinox observe":
  repeat until completed = 1:
    set inputTurns to ((lab motor A angle) / 360)
    set rightBrakeTurns to ((lab motor B angle) / 360)
    set leftBrakeTurns to ((lab motor C angle) / 360)
    wait 0.05 seconds

WHEN I receive "Equinox watchdog":
  repeat until completed = 1:
    IF timer > 68 THEN:
      set failed to 1
      lab stop motor A hold
      lab stop motor B hold
      lab stop motor C hold
      say "Equinox stopped after its time limit. Inspect the model and Reset."
      stop all
    wait 0.05 seconds
