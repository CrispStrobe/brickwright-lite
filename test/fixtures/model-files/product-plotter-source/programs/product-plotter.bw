DEVICE SPIKE
# Product Plotter: a real two-input geometric multiplier.
# A tilts the straight guide. B translates the green readout rail.
# The blue input a and orange output y remain passive intersections.
# Targets cover a = -24, 0, +24 mm and b = 32, 40, 48 mm; L = 88 mm.
# The B conversion comes from the actual 12T/rack coupling: 6 mm per radian.
# Only input encoders are read here. Output coordinates are measured separately.
WHEN flag clicked:
  set complete to 0
  set fault to 0
  set phase to 0
  set moving to 0
  set targetA to 0
  set targetB to 0
  reset timer
  broadcast "Product Plotter watchdog"
  lab reset
  lab start
  wait 5 seconds
  if (abs of (lab motor A angle)) > 0.5 then:
    set fault to 1
    stop all
  if (abs of (lab motor B angle)) > 0.5 then:
    set fault to 1
    stop all
  lab stop motor A hold
  lab stop motor B hold
  wait 0.25 seconds
  # Cell 1: a=24 mm; b=32 mm.
  set moving to 1
  set phase to 1
  set targetA to -15.255118703058
  set targetB to -76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 2: a=24 mm; b=40 mm.
  set moving to 1
  set phase to 2
  set targetA to -15.255118703058
  set targetB to 0
  broadcast "Position Plotter inputs" and wait
  # Cell 3: a=24 mm; b=48 mm.
  set moving to 1
  set phase to 3
  set targetA to -15.255118703058
  set targetB to 76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 4: a=0 mm; b=48 mm.
  set moving to 1
  set phase to 4
  set targetA to 0
  set targetB to 76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 5: a=0 mm; b=40 mm.
  set moving to 1
  set phase to 5
  set targetA to 0
  set targetB to 0
  broadcast "Position Plotter inputs" and wait
  # Cell 6: a=0 mm; b=32 mm.
  set moving to 1
  set phase to 6
  set targetA to 0
  set targetB to -76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 7: a=-24 mm; b=32 mm.
  set moving to 1
  set phase to 7
  set targetA to 15.255118703058
  set targetB to -76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 8: a=-24 mm; b=40 mm.
  set moving to 1
  set phase to 8
  set targetA to 15.255118703058
  set targetB to 0
  broadcast "Position Plotter inputs" and wait
  # Cell 9: a=-24 mm; b=48 mm.
  set moving to 1
  set phase to 9
  set targetA to 15.255118703058
  set targetB to 76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 10: a=-24 mm; b=32 mm.
  set moving to 1
  set phase to 10
  set targetA to 15.255118703058
  set targetB to -76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 11: a=0 mm; b=32 mm.
  set moving to 1
  set phase to 11
  set targetA to 0
  set targetB to -76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 12: a=0 mm; b=48 mm.
  set moving to 1
  set phase to 12
  set targetA to 0
  set targetB to 76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 13: a=24 mm; b=48 mm.
  set moving to 1
  set phase to 13
  set targetA to -15.255118703058
  set targetB to 76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 14: a=24 mm; b=32 mm.
  set moving to 1
  set phase to 14
  set targetA to -15.255118703058
  set targetB to -76.39437268411
  broadcast "Position Plotter inputs" and wait
  # Cell 15: a=0 mm; b=40 mm.
  set moving to 1
  set phase to 15
  set targetA to 0
  set targetB to 0
  broadcast "Position Plotter inputs" and wait
  set complete to 1

WHEN I receive "Position Plotter inputs":
  set moving to 1
  lab run motor A for (targetA - (lab motor A angle)) degrees at 10 degrees per second
  lab stop motor A hold
  lab run motor B for (targetB - (lab motor B angle)) degrees at 60 degrees per second
  lab stop motor B hold
  wait 0.25 seconds
  if (abs of ((lab motor A angle) - targetA)) > 0.5 then:
    set fault to 1
    stop all
  if (abs of ((lab motor B angle) - targetB)) > 0.5 then:
    set fault to 1
    stop all
  set moving to 0
  wait 0.5 seconds

WHEN I receive "Product Plotter watchdog":
  repeat until complete = 1:
    if timer > 75 then:
      set fault to 1
      lab stop motor A hold
      lab stop motor B hold
      stop all
    wait 0.02 seconds
