# Cascade — excite, hold the support, observe two free links
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Bounded-feedback structure adapted from original WaveMaker/Concertina/SineShuttle/TwinTempo.
# Generated by build/build_program.py from the frozen experiment config.
# Config SHA-256: cd4da27c91e2351133e56010e43de0253e395950ee605fe4a8448b646dcc1691
# Main model SHA-256: 55094cb73bf53ceeff77ada5b1c5a055d1ca944f53663d136e1412db48ec7197
# Control model SHA-256: 5187479ace783db69a10b1548d3d5e50ad2fe5773745f71df1a44ee4d50827df
# One SPIKE hub and motor A; both pendulum joints are passive in the main model.
# Robot Lab simulation code, not SPIKE hardware firmware.
# Load the matching model and manually Reset before each fresh experiment.
# Absolute unwrapped A targets: 0 -> 90 -> 0 degrees.
# Positive speed magnitudes; direction comes from target minus fresh encoder angle.
# Main leg speeds: 180, 180 degrees/s.
# Strict saved-datum admission, no homing move or encoder reset.
# Input envelope: -5 through 95 degrees.
# Stage 0 datum; 1 outward; 2 return; 3 held-support observation; 4 complete.
# supportHeld=1 denotes a guarded motor hold, not passive-link settling.
# observing=1 only in the post-return observation window.
# Passive-link motion at completion is allowed; no passive output return is commanded.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL supportHeld = 0
GLOBAL observing = 0
GLOBAL homed = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL targetA = 0
GLOBAL speedA = 180
GLOBAL correctionAttempts = 0
GLOBAL observationStart = 0

WHEN flag clicked:
  set stage to 0
  set supportHeld to 0
  set observing to 0
  set homed to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set speedA to 180
  set correctionAttempts to 0
  set observationStart to 0
  reset timer
  lab start
  lab stop motor A hold
  broadcast "Cascade startup guard" and wait
  broadcast "Cascade watchdog"
  set supportHeld to 1
  wait 0.5 seconds
  broadcast "Cascade startup guard" and wait
  set homed to 1
  set supportHeld to 0
  set stage to 1
  set targetA to 90
  set speedA to 180
  broadcast "Cascade move" and wait
  set supportHeld to 1
  wait 0.3 seconds
  broadcast "Cascade arrival guard" and wait
  set supportHeld to 0
  set stage to 2
  set targetA to 0
  set speedA to 180
  broadcast "Cascade move" and wait
  broadcast "Cascade arrival guard" and wait
  set stage to 3
  set supportHeld to 1
  set observationStart to (timer)
  set observing to 1
  REPEAT UNTIL ((timer) - observationStart) > 12:
    broadcast "Cascade arrival guard" and wait
    wait 0.1 seconds
  broadcast "Cascade arrival guard" and wait
  set observing to 0
  set stage to 4
  set completed to 1
  say "Cascade complete: the support remains held; the passive links may still move."

WHEN I receive "Cascade startup guard":
  IF (abs of (lab motor A angle)) > 1 THEN:
    set supportHeld to 0
    lab stop motor A hold
    set failed to 1
    say "Cascade is outside its saved-start allowance. Reset before running."
    stop all

WHEN I receive "Cascade move":
  set supportHeld to 0
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at (speedA) degrees per second
  lab stop motor A hold
  set correctionAttempts to 0
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.2 THEN:
      change correctionAttempts by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 30 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  broadcast "Cascade arrival guard" and wait

WHEN I receive "Cascade arrival guard":
  IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
    set supportHeld to 0
    set observing to 0
    lab stop motor A hold
    set failed to 1
    say "Cascade missed or drifted from its support-motor target. Inspect and reset."
    stop all

WHEN I receive "Cascade watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 30 THEN:
      set supportHeld to 0
      set observing to 0
      lab stop motor A hold
      set failed to 1
      say "Cascade: watchdog stopped the experiment. Reset before retrying."
      stop all
    wait 0.1 seconds
