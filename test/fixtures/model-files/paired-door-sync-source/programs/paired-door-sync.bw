# PairedDoorSync: one 16T pinion drives two opposed 64781 racks.
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 CrispStrobe
# Finite four-hold experiment: 0 -> +150 -> 0 -> -150 -> 0 encoder degrees.
# The two racks and the door leaves are passive; no output pose is prescribed.
# Each move is target minus a fresh encoder reading; at most two 5 deg/s trims.
# Reload/reset the model to its saved zero pose before Run.
# The motor is held at every judged hold; the rack markers are the evidence.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL settled = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL targetA = 0
GLOBAL speedA = 15
GLOBAL correctionAttempts = 0

WHEN flag clicked:
  set stage to 0
  set settled to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set speedA to 15
  set correctionAttempts to 0
  reset timer
  lab start
  lab stop motor A hold
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Load the paired-door model and reset its saved pose before running."
    stop all
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Paired-door datum is not zero. Reset the saved pose before running."
    stop all
  broadcast "PairedDoorSync watchdog"

  set stage to 1
  set targetA to 150
  set speedA to 15
  broadcast "PairedDoorSync move" and wait
  set settled to 1
  wait 0.8 seconds
  set settled to 0

  set stage to 2
  set targetA to 0
  set speedA to 15
  broadcast "PairedDoorSync move" and wait
  set settled to 1
  wait 0.8 seconds
  set settled to 0

  set stage to 3
  set targetA to -150
  set speedA to 15
  broadcast "PairedDoorSync move" and wait
  set settled to 1
  wait 0.8 seconds
  set settled to 0

  set stage to 4
  set targetA to 0
  set speedA to 15
  broadcast "PairedDoorSync move" and wait
  set settled to 1
  wait 0.8 seconds
  set settled to 0

  lab stop motor A hold
  set stage to 5
  set completed to 1
  say "Paired-door run complete: compare both passive rack markers and the sum law."

WHEN I receive "PairedDoorSync move":
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at (speedA) degrees per second
  lab stop motor A hold
  set correctionAttempts to 0
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      change correctionAttempts by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 5 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "Paired-door motor missed its target. Inspect the rack meshes and guides before retrying."
    stop all

WHEN I receive "PairedDoorSync watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 55 THEN:
      lab stop motor A hold
      set failed to 1
      say "Paired-door watchdog stopped the experiment after 55 seconds."
      stop all
    wait 0.1 seconds
