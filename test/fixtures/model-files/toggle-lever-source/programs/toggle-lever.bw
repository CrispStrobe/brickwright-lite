# Toggle Lever — crank-driven link folding toward dead centre
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 CrispStrobe
# One SPIKE hub, one medium angular motor on A; the lever and link are passive.
# Moves at 30 deg/s; the passive lever follows the closure within 0.02 deg up to 60 deg.
# Saved datum: crank pin at +X, lever input arm at +36.87 deg.
# Absolute targets: 0 -> 85 -> 0 degrees (the link folds over the pivot at 90,
# where the lever's branch is undefined, so the program stops 5 degrees short).
# The lever angle is a passive reading of the link closure, not a commanded value.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL settled = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL targetA = 0
GLOBAL speedA = 90
GLOBAL correctionAttempts = 0
GLOBAL a1 = 0
GLOBAL a2 = 0

WHEN flag clicked:
  set stage to 0
  set settled to 0
  set completed to 0
  set failed to 0
  set targetA to 0
  set speedA to 30
  set correctionAttempts to 0
  set a1 to 0
  set a2 to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Load ToggleLever and reset its saved pose before running."
    stop all
  lab start
  reset timer
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    say "Reset ToggleLever to its saved pose before running."
    stop all
  broadcast "ToggleLever watchdog"
  set stage to 1
  set targetA to 85
  set speedA to 30
  broadcast "ToggleLever move" and wait
  wait 0.5 seconds
  broadcast "ToggleLever arrival" and wait
  set stage to 2
  set settled to 1
  wait 1 seconds
  broadcast "ToggleLever speed guard" and wait
  set settled to 0
  set stage to 3
  set targetA to 0
  set speedA to 30
  broadcast "ToggleLever move" and wait
  wait 0.5 seconds
  broadcast "ToggleLever arrival" and wait
  set stage to 4
  set settled to 1
  wait 1 seconds
  broadcast "ToggleLever speed guard" and wait
  lab stop motor A hold
  set completed to 1
  say "ToggleLever complete: compare the passive lever arc with the link closure."

WHEN I receive "ToggleLever move":
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at (speedA) degrees per second
  lab stop motor A hold
  set correctionAttempts to 0
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      change correctionAttempts by 1
      lab run motor A for (targetA - (lab motor A angle)) degrees at 5 degrees per second
      lab stop motor A hold
      wait 0.1 seconds
  broadcast "ToggleLever arrival" and wait

WHEN I receive "ToggleLever arrival":
  IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
    lab stop motor A hold
    set failed to 1
    say "ToggleLever missed its encoder target. Inspect and reset."
    stop all

WHEN I receive "ToggleLever speed guard":
  set a1 to (lab motor A angle)
  wait 0.2 seconds
  set a2 to (lab motor A angle)
  IF (abs of (a2 - a1)) > 0.15 THEN:
    lab stop motor A hold
    set failed to 1
    say "ToggleLever did not hold still. Inspect and reset."
    stop all

WHEN I receive "ToggleLever watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 90 THEN:
      lab stop motor A hold
      set failed to 1
      say "ToggleLever: 90 second watchdog stopped the experiment. Reset before retrying."
      stop all
    wait 0.1 seconds
