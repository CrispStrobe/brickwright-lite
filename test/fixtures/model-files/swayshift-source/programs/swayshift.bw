# SwayShift — two finite trolley moves and a freely swinging pendulum.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Reload the saved model before every comparison. No encoder reset or homing move.
# The comparison program changes only start_gap. All speeds are degrees/second.
# Timing was fixed from a separate full-scene free-period calibration.
# T/2 is rounded once to the native 5 ms step; the comparison doubles that gap.
DEVICE SPIKE
GLOBAL start_gap = 0.380
GLOBAL natural_period = 0.7570673940694227
GLOBAL half_angle = -35.01408748021698
GLOBAL targetA = 0
GLOBAL fresh_angle = 0
GLOBAL command_degrees = 0
GLOBAL stage = 0
GLOBAL completed = 0
GLOBAL failed = 0
GLOBAL arrivals = 0
GLOBAL first_start = 0
GLOBAL first_end = 0
GLOBAL second_start = 0
GLOBAL second_end = 0
GLOBAL observe_start = 0
GLOBAL observe_end = 0
GLOBAL return_start = 0
GLOBAL return_end = 0

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set stage to 0
  set arrivals to 0
  IF (lab status) = "no-model" THEN:
    set failed to 1
    say "Load SwayShift before running. Reload it before each comparison."
    stop all
  lab start
  set motor stop action A hold
  lab stop motor A hold
  reset timer
  broadcast "SwayShift watchdog"
  IF (abs of (lab motor A angle)) > 0.5 THEN:
    broadcast "SwayShift fault" and wait
  wait until (timer) > 1
  set stage to 1
  set targetA to half_angle
  set fresh_angle to (lab motor A angle)
  set command_degrees to (targetA - fresh_angle)
  set first_start to (timer)
  lab run motor A for command_degrees degrees at 900 degrees per second
  set first_end to (timer)
  change arrivals by 1
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "SwayShift fault" and wait
  IF (timer) > (first_start + start_gap) THEN:
    broadcast "SwayShift fault" and wait
  wait until (timer) > (first_start + start_gap)
  set stage to 2
  set targetA to (2 * half_angle)
  set fresh_angle to (lab motor A angle)
  set command_degrees to (targetA - fresh_angle)
  set second_start to (timer)
  lab run motor A for command_degrees degrees at 900 degrees per second
  set second_end to (timer)
  change arrivals by 1
  IF (abs of (targetA - (lab motor A angle))) > 1 THEN:
    broadcast "SwayShift fault" and wait
  IF (timer) > (first_start + (2 * natural_period)) THEN:
    broadcast "SwayShift fault" and wait
  wait until (timer) > (first_start + (2 * natural_period))
  set stage to 3
  set observe_start to (timer)
  say "The trolley holds its target. Watch the remaining free pendulum swing."
  wait until (timer) > (first_start + (6 * natural_period))
  set observe_end to (timer)
  wait until (timer) > (first_start + (7 * natural_period))
  set stage to 4
  set targetA to 0
  set fresh_angle to (lab motor A angle)
  set command_degrees to (targetA - fresh_angle)
  set return_start to (timer)
  lab run motor A for command_degrees degrees at 20 degrees per second
  set return_end to (timer)
  change arrivals by 1
  wait (2 * natural_period) seconds
  IF (abs of (lab motor A angle)) > 1 THEN:
    broadcast "SwayShift fault" and wait
  lab stop motor A hold
  set stage to 5
  set completed to 1
  say "Transfer and return complete. Reload the model before trying the other timing."

WHEN I receive "SwayShift watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 20 THEN:
      broadcast "SwayShift fault" and wait
    IF (lab motor A angle) > 2 THEN:
      broadcast "SwayShift fault" and wait
    IF (lab motor A angle) < -78 THEN:
      broadcast "SwayShift fault" and wait
    wait 0.02 seconds

WHEN I receive "SwayShift fault":
  set failed to 1
  lab stop motor A hold
  say "Input guard or watchdog failed. Reload the saved SwayShift model."
  stop all
