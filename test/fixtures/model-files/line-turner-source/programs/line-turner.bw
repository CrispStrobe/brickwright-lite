# Line Turner - one horizontal guide, a circular midpoint and a vertical free tip.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Robot Lab: import the matching LDR; Mat > Plain (DE: Matte > Einfach).
# Code > Pseudocode: paste all text, To blocks; Robot Lab Reset, then Run.
# Reset/reload after manual movement or a fault. No encoder reset here.
# Simulation program, not hardware firmware. Speeds are motor degrees/second.
# The motor commands only the rack. The passive B tip has no vertical guide.
# sliderTargetMm is the horizontal A coordinate measured from fixed pivot O.
# Ideal AB=64mm, OM=32mm, B height=sqrt(64^2-A.x^2). Predictions are not observations.
# Three hats: a finite route, a joined move receiver and an independent watchdog.
DEVICE SPIKE
GLOBAL directionA = 1
GLOBAL targetA = 0
GLOBAL sliderTargetMm = 57.6
GLOBAL stage = 0
GLOBAL leg = 0
GLOBAL arrived = 0
GLOBAL correctionsA = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set directionA to 1
  set sliderTargetMm to 57.6
  set targetA to 0
  set stage to 0
  set leg to 0
  set arrived to 0
  set correctionsA to 0
  set completed to 0
  set failed to 0
  reset timer
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "Saved encoder datum mismatch. Reset Line Turner before retrying."
    stop all
  broadcast "Line Turner watchdog"
  # Stage 0: inward, slider x 57.6 mm; free-tip ideal height 27.896953238660306 mm.
  set arrived to 0
  set stage to 0
  set leg to 0
  set sliderTargetMm to 57.6
  set targetA to (directionA * 0)
  broadcast "Line Turner move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor did not report measured arrival."
    stop all
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor drifted outside its arrival bound during the dwell."
    stop all
  # Stage 1: inward, slider x 51.2 mm; free-tip ideal height 38.39999999999999 mm.
  set arrived to 0
  set stage to 1
  set leg to 0
  set sliderTargetMm to 51.2
  set targetA to (directionA * 61.1154981472878)
  broadcast "Line Turner move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor did not report measured arrival."
    stop all
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor drifted outside its arrival bound during the dwell."
    stop all
  # Stage 2: inward, slider x 44.800000000000004 mm; free-tip ideal height 45.70514194267424 mm.
  set arrived to 0
  set stage to 2
  set leg to 0
  set sliderTargetMm to 44.800000000000004
  set targetA to (directionA * 122.2309962945756)
  broadcast "Line Turner move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor did not report measured arrival."
    stop all
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor drifted outside its arrival bound during the dwell."
    stop all
  # Stage 3: inward, slider x 38.400000000000006 mm; free-tip ideal height 51.199999999999996 mm.
  set arrived to 0
  set stage to 3
  set leg to 0
  set sliderTargetMm to 38.400000000000006
  set targetA to (directionA * 183.3464944418634)
  broadcast "Line Turner move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor did not report measured arrival."
    stop all
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor drifted outside its arrival bound during the dwell."
    stop all
  # Stage 4: outward, slider x 44.800000000000004 mm; free-tip ideal height 45.70514194267424 mm.
  set arrived to 0
  set stage to 4
  set leg to 1
  set sliderTargetMm to 44.800000000000004
  set targetA to (directionA * 122.2309962945756)
  broadcast "Line Turner move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor did not report measured arrival."
    stop all
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor drifted outside its arrival bound during the dwell."
    stop all
  # Stage 5: outward, slider x 51.2 mm; free-tip ideal height 38.39999999999999 mm.
  set arrived to 0
  set stage to 5
  set leg to 1
  set sliderTargetMm to 51.2
  set targetA to (directionA * 61.1154981472878)
  broadcast "Line Turner move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor did not report measured arrival."
    stop all
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor drifted outside its arrival bound during the dwell."
    stop all
  # Stage 6: outward, slider x 57.6 mm; free-tip ideal height 27.896953238660306 mm.
  set arrived to 0
  set stage to 6
  set leg to 1
  set sliderTargetMm to 57.6
  set targetA to (directionA * 0)
  broadcast "Line Turner move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor did not report measured arrival."
    stop all
  wait 2 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The rack motor drifted outside its arrival bound during the dwell."
    stop all
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "Return encoder check failed. Reset and inspect the rack and linkage."
    stop all
  lab stop motor A hold
  set arrived to 0
  set stage to 7
  set completed to 1
  say "Complete: one guide made a perpendicular free-tip line. Home held."

WHEN I receive "Line Turner move":
  set arrived to 0
  set correctionsA to 0
  IF (targetA * directionA) < -0.01 THEN:
    set failed to 1
    lab stop motor A hold
    say "Input target is outside the declared rack route."
    stop all
  IF (targetA * directionA) > 183.3564944418634 THEN:
    set failed to 1
    lab stop motor A hold
    say "Input target is outside the declared rack route."
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 76.39437268410984 THEN:
    set failed to 1
    lab stop motor A hold
    say "Unexpected fresh encoder displacement. Reset before retrying."
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 90 degrees per second
    lab stop motor A hold
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      set correctionsA to (correctionsA + 1)
      lab run motor A for (targetA - (lab motor A angle)) degrees at 45 degrees per second
      lab stop motor A hold
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "Measured rack motor arrival failed. Inspect the linkage and reset."
    stop all
  set arrived to 1

WHEN I receive "Line Turner watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 60 THEN:
      set failed to 1
      lab stop motor A hold
      say "Finite watchdog expired. Input held; reset before retrying."
      stop all
    IF ((lab motor A angle) * directionA) < -7.639437268411018 THEN:
      set failed to 1
      lab stop motor A hold
      say "The measured rack input left the software envelope. Reset and inspect."
      stop all
    IF ((lab motor A angle) * directionA) > 190.98593171027443 THEN:
      set failed to 1
      lab stop motor A hold
      say "The measured rack input left the software envelope. Reset and inspect."
      stop all
    wait 0.02 seconds
