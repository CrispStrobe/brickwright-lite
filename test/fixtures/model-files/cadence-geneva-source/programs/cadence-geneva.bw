# CADENCE — Geneva clockwork, twelve mechanically produced dial steps.
# Open cadence-geneva.ldr in Robot Lab, select Plain, Reset, then Run.
# The motor drives the crank continuously. The real roller and four open
# slots produce intermittent motion; an 8T:24T output train gives a 12-position dial.
# The dial drives an 8T:24T brake branch. Its stock torque-limiting clutch
# turns on a fixed hub to retain the dwell positions.
# The program controls only input motor A; it never sets output part poses.
# Motor-paced clockwork demonstrator, with a finite twelve-step demonstration.
# Reset the complete model before every run. Keep the supplied speed for this run.
DEVICE SPIKE
GLOBAL completed
GLOBAL failed
GLOBAL dialSweep
GLOBAL lastHeading
GLOBAL currentHeading
GLOBAL headingDelta
GLOBAL crankTurns
GLOBAL ticks

WHEN flag clicked:
  set completed to 0
  set failed to 0
  set dialSweep to 0
  set crankTurns to 0
  set ticks to 0
  IF ((lab status) = "no-model") or ((lab status) = "not-open") THEN:
    set failed to 1
    say "Open Cadence in Robot Lab, select Plain, then Reset and Run."
    stop all
  lab start
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of (lab motor A angle)) > 5 THEN:
    set failed to 1
    say "Reset the complete Cadence model before running this demonstration."
    stop all
  set lastHeading to ((lab part "dial_hand_tip" heading) - (lab part "hub" heading))
  reset timer
  broadcast "Cadence observe"
  broadcast "Cadence watchdog"
  lab run motor A for 4320 degrees at 30 degrees per second
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of ((lab motor A angle) - 4320)) > 1.5 THEN:
    set failed to 1
    say "The crank did not complete its twelve revolutions. Inspect and Reset."
    stop all
  IF (abs of (dialSweep - 360)) > 3 THEN:
    set failed to 1
    say "The observed dial did not complete one revolution. Inspect and Reset."
    stop all
  set completed to 1
  set ticks to 12
  say "Cadence complete: twelve mechanical dial steps, one full dial revolution."

WHEN I receive "Cadence observe":
  repeat until completed = 1:
    set currentHeading to ((lab part "dial_hand_tip" heading) - (lab part "hub" heading))
    set headingDelta to (currentHeading - lastHeading)
    IF headingDelta > 180 THEN:
      change headingDelta by -360
    IF headingDelta < -180 THEN:
      change headingDelta by 360
    change dialSweep by headingDelta
    set lastHeading to currentHeading
    set crankTurns to ((lab motor A angle) / 360)
    set ticks to (round ((abs of dialSweep) / 30))
    wait 0.02 seconds

WHEN I receive "Cadence watchdog":
  repeat until completed = 1:
    IF timer > 174 THEN:
      set failed to 1
      lab stop motor A hold
      say "Cadence watchdog stopped the input motor. Inspect and Reset."
      stop all
    wait 0.02 seconds
