# Rod Ratio - one common crank shaft, two passive sliders, two rod lengths.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Robot Lab: import matching LDR; Mat > Plain (DE: Matte > Einfach).
# Code > Pseudocode: paste all text, To blocks; Robot Lab Reset, then Run.
# Reset/reload after manual movement or a fault. No encoder reset here.
# Simulation program, not hardware firmware. Speeds are motor degrees/second.
# OUTPUT crank phases are 0..360..0 degrees; motor targets are signed phase * 24.
# The 24:1 worm drives both 24 mm cranks in the same phase.
# Connecting rods are 40 and 80 mm between actual pivots.
# Motor sign is measured; consult program-parameters and native evidence.
# Two passive body-carried markers must be observed independently of this prediction.
# One move receiver joins before each measured-arrival dwell; watchdog runs independently.
DEVICE SPIKE
GLOBAL directionA = 1
GLOBAL targetA = 0
GLOBAL phaseTarget = 0
GLOBAL stage = 0
GLOBAL leg = 0
GLOBAL arrived = 0
GLOBAL correctionsA = 0
GLOBAL completed = 0
GLOBAL failed = 0

WHEN flag clicked:
  set directionA to 1
  set targetA to 0
  set phaseTarget to 0
  set stage to 0
  set leg to 0
  set arrived to 0
  set correctionsA to 0
  set completed to 0
  set failed to 0
  reset timer
  lab stop motor A hold
  IF (abs of (lab motor A angle)) > 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "Saved encoder datum mismatch. Reset Rod Ratio before retrying."
    stop all
  broadcast "Rod Ratio watchdog"
  # Stage 0: forward, output crank phase 0 degrees.
  set arrived to 0
  set stage to 0
  set leg to 0
  set phaseTarget to 0
  set targetA to (directionA * 0)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 1: forward, output crank phase 45 degrees.
  set arrived to 0
  set stage to 1
  set leg to 0
  set phaseTarget to 45
  set targetA to (directionA * 1080)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 2: forward, output crank phase 90 degrees.
  set arrived to 0
  set stage to 2
  set leg to 0
  set phaseTarget to 90
  set targetA to (directionA * 2160)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 3: forward, output crank phase 135 degrees.
  set arrived to 0
  set stage to 3
  set leg to 0
  set phaseTarget to 135
  set targetA to (directionA * 3240)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 4: forward, output crank phase 180 degrees.
  set arrived to 0
  set stage to 4
  set leg to 0
  set phaseTarget to 180
  set targetA to (directionA * 4320)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 5: forward, output crank phase 225 degrees.
  set arrived to 0
  set stage to 5
  set leg to 0
  set phaseTarget to 225
  set targetA to (directionA * 5400)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 6: forward, output crank phase 270 degrees.
  set arrived to 0
  set stage to 6
  set leg to 0
  set phaseTarget to 270
  set targetA to (directionA * 6480)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 7: forward, output crank phase 315 degrees.
  set arrived to 0
  set stage to 7
  set leg to 0
  set phaseTarget to 315
  set targetA to (directionA * 7560)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 8: forward, output crank phase 360 degrees.
  set arrived to 0
  set stage to 8
  set leg to 0
  set phaseTarget to 360
  set targetA to (directionA * 8640)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 9: reverse, output crank phase 315 degrees.
  set arrived to 0
  set stage to 9
  set leg to 1
  set phaseTarget to 315
  set targetA to (directionA * 7560)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 10: reverse, output crank phase 270 degrees.
  set arrived to 0
  set stage to 10
  set leg to 1
  set phaseTarget to 270
  set targetA to (directionA * 6480)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 11: reverse, output crank phase 225 degrees.
  set arrived to 0
  set stage to 11
  set leg to 1
  set phaseTarget to 225
  set targetA to (directionA * 5400)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 12: reverse, output crank phase 180 degrees.
  set arrived to 0
  set stage to 12
  set leg to 1
  set phaseTarget to 180
  set targetA to (directionA * 4320)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 13: reverse, output crank phase 135 degrees.
  set arrived to 0
  set stage to 13
  set leg to 1
  set phaseTarget to 135
  set targetA to (directionA * 3240)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 14: reverse, output crank phase 90 degrees.
  set arrived to 0
  set stage to 14
  set leg to 1
  set phaseTarget to 90
  set targetA to (directionA * 2160)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 15: reverse, output crank phase 45 degrees.
  set arrived to 0
  set stage to 15
  set leg to 1
  set phaseTarget to 45
  set targetA to (directionA * 1080)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  # Stage 16: reverse, output crank phase 0 degrees.
  set arrived to 0
  set stage to 16
  set leg to 1
  set phaseTarget to 0
  set targetA to (directionA * 0)
  broadcast "Rod Ratio move" and wait
  IF arrived < 1 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input motor did not report measured arrival."
    stop all
  wait 1 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "The input drifted outside its arrival bound during the dwell."
    stop all
  IF (abs of (lab motor A angle)) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "Return encoder check failed. Reset and inspect the linkage."
    stop all
  lab stop motor A hold
  set arrived to 0
  set stage to 17
  set completed to 1
  say "Complete: compare equal full strokes and unequal quarter-turn travel. Home held."

WHEN I receive "Rod Ratio move":
  set arrived to 0
  set correctionsA to 0
  IF (targetA * directionA) < -0.01 THEN:
    set failed to 1
    lab stop motor A hold
    say "Input target is outside the declared forward/reverse route."
    stop all
  IF (targetA * directionA) > 8640.01 THEN:
    set failed to 1
    lab stop motor A hold
    say "Input target is outside the declared forward/reverse route."
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 1176 THEN:
    set failed to 1
    lab stop motor A hold
    say "Unexpected fresh encoder displacement. Reset before retrying."
    stop all
  IF (abs of (targetA - (lab motor A angle))) > 0.1 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 720 degrees per second
    lab stop motor A hold
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.5 THEN:
      set correctionsA to (correctionsA + 1)
      lab run motor A for (targetA - (lab motor A angle)) degrees at 120 degrees per second
      lab stop motor A hold
  wait 0.3 seconds
  IF (abs of (targetA - (lab motor A angle))) > 2 THEN:
    set failed to 1
    lab stop motor A hold
    say "Measured input arrival failed. Inspect both slider-cranks and reset."
    stop all
  set arrived to 1

WHEN I receive "Rod Ratio watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 120 THEN:
      set failed to 1
      lab stop motor A hold
      say "Finite watchdog expired. Input held; reset before retrying."
      stop all
    IF ((lab motor A angle) * directionA) < -48 THEN:
      set failed to 1
      lab stop motor A hold
      say "Measured input left the declared phase guard. Reset and inspect."
      stop all
    IF ((lab motor A angle) * directionA) > 8688 THEN:
      set failed to 1
      lab stop motor A hold
      say "Measured input left the declared phase guard. Reset and inspect."
      stop all
    wait 0.02 seconds
