DEVICE SPIKE
# REMOTE PIVOT — a passive output turns about a point with no bearing.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Open the matching remote-pivot.ldr, choose Mat > Plain, Reset, then Run.
# Only motor A is controlled. The source-defined centre C and output Q/E are not commands.
# Physical theta begins at 90 degrees; motor encoder targets are relative to the fresh saved scene.
# Compiler, native motion, construction, browser and hardware have separate evidence.
GLOBAL LIST motorATargets = [0, -30, -15, 0, 15, 30, -30, 0]
GLOBAL LIST motorACaps = [0, 8, 8, 8, 8, 8, 8, 8]
GLOBAL LIST inputAngleTargets = [90, 60, 75, 90, 105, 120, 60, 90]
GLOBAL LIST movingMasks = [0, 1, 1, 1, 1, 1, 1, 1]
WHEN flag clicked:
  set directionA to 1
  set routeIndex to 1
  set stage to 0
  set arrived to 0
  set arrivedA to 0
  set inputReady to 0
  set completed to 0
  set failed to 0
  set movingMask to 0
  set targetA to 0
  set capA to 0
  set inputTargetAngleDeg to 90
  set correctionsA to 0
  set distanceA to 0
  set profilePeakA to 0
  set profileDurationA to 0
  set profileBrakeDistanceA to 0
  set profileRemainingA to 0
  set profileBrakeSpeedA to 0
  set profileDeadlineA to 0
  set profileStartedA to 0
  set profileElapsedA to 0
  set profileSpeedA to 0
  set trimStartedA to 0
  set profileDirectionA to 1
  set trimDirectionA to 1
  lab stop motor A hold
  if (lab status) = "no-model" or (lab status) = "not-open" then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    say "Open the matching Remote Pivot model and Reset before Run."
    stop all
  if (abs of (lab motor A angle)) > 1 then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    say "Fresh datum guard: Reset the matching model before retrying."
    stop all
  if not (length of motorATargets) = 8 or not (length of motorACaps) = 8 or not (length of inputAngleTargets) = 8 or not (length of movingMasks) = 8 then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    say "The finite route lists must each contain eight values. Reload the matching program."
    stop all
  reset timer
  broadcast "Remote Pivot watchdog"
  repeat 8:
    set arrived to 0
    set arrivedA to 0
    set inputReady to 0
    set stage to (routeIndex - 1)
    set targetA to (item routeIndex of motorATargets)
    set capA to (item routeIndex of motorACaps)
    set inputTargetAngleDeg to (item routeIndex of inputAngleTargets)
    set movingMask to (item routeIndex of movingMasks)
    broadcast "Remote Pivot move" and wait
    if failed = 1 or arrivedA = 0 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      say "The joined A move did not establish input arrival. Reset."
      stop all
    if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      say "Input A is outside its measured angle or speed arrival guard. Reset."
      stop all
    set inputReady to 1
    set movingMask to 0
    set arrived to 1
    wait 2.5 seconds
    if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      say "Input A moved outside the observed hold window. Reset."
      stop all
    set arrived to 0
    set inputReady to 0
    change routeIndex by 1
  set arrived to 0
  set inputReady to 0
  set stage to 8
  set movingMask to 0
  set completed to 1
  say "Complete: compare the output link with the empty remote centre. Input A holds at its saved datum."

WHEN I receive "Remote Pivot move":
  set arrivedA to 0
  set correctionsA to 0
  if capA > 0 and (abs of (targetA - (lab motor A angle))) > 0.15 then:
    set distanceA to (abs of (targetA - (lab motor A angle)))
    set profileDirectionA to 1
    if targetA < (lab motor A angle) then:
      set profileDirectionA to -1
    set profilePeakA to capA
    if (profilePeakA * 2) > distanceA then:
      set profilePeakA to (distanceA / 2)
    set profileDurationA to ((distanceA / profilePeakA) + 2)
    set profileBrakeDistanceA to ((profilePeakA * 2) / 2)
    set profileDeadlineA to ((2 * profileDurationA) + (2 * 2))
    set profileStartedA to timer
    repeat until ((targetA - (lab motor A angle)) * profileDirectionA) <= 0.15 or (timer - profileStartedA) >= profileDeadlineA:
      set profileElapsedA to (timer - profileStartedA)
      if profileElapsedA < 0 then:
        set profileElapsedA to 0
      if profileElapsedA > profileDeadlineA then:
        set profileElapsedA to profileDeadlineA
      set profileRemainingA to ((targetA - (lab motor A angle)) * profileDirectionA)
      if profileRemainingA < 0 then:
        set profileRemainingA to 0
      set profileSpeedA to profilePeakA
      if profileElapsedA < 2 then:
        set profileSpeedA to ((profilePeakA * (1 - (cos of ((180 * profileElapsedA) / 2)))) / 2)
      set profileBrakeSpeedA to (profilePeakA * (sqrt of (profileRemainingA / profileBrakeDistanceA)))
      if profileBrakeSpeedA < profileSpeedA then:
        set profileSpeedA to profileBrakeSpeedA
      lab run motor A at (profileDirectionA * profileSpeedA) degrees per second
      wait 0.05 seconds
    lab stop motor A hold
    if (timer - profileStartedA) >= profileDeadlineA and ((targetA - (lab motor A angle)) * profileDirectionA) > 0.15 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      say "Motor A exceeded its finite main capture deadline. Reset."
      stop all
  wait 1 seconds
  repeat 3:
    if (abs of (targetA - (lab motor A angle))) > 0.2 then:
      change correctionsA by 1
      set trimDirectionA to 1
      if targetA < (lab motor A angle) then:
        set trimDirectionA to -1
      set trimStartedA to timer
      lab run motor A at (trimDirectionA * 0.5) degrees per second
      repeat until ((targetA - (lab motor A angle)) * trimDirectionA) <= 0.15 or (timer - trimStartedA) >= 3:
        wait 0.05 seconds
      lab stop motor A hold
      if (timer - trimStartedA) >= 3 and ((targetA - (lab motor A angle)) * trimDirectionA) > 0.15 then:
        set failed to 1
        set arrived to 0
        set inputReady to 0
        lab stop motor A hold
        say "Motor A exceeded its bounded correction time. Reset."
        stop all
      wait 1 seconds
  if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    say "Motor A failed the measured arrival guard. Reset."
    stop all
  set arrivedA to 1

WHEN I receive "Remote Pivot watchdog":
  repeat until completed = 1 or failed = 1:
    if timer > 300 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      say "300 second watchdog: input A held. Reset before retrying."
      stop all
    if ((lab motor A angle) * directionA * 1) < -31 or ((lab motor A angle) * directionA * 1) > 31 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      say "Input A exceeded its declared software envelope. Reset."
      stop all
    if inputReady = 1 then:
      if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 then:
        set failed to 1
        set arrived to 0
        set inputReady to 0
        lab stop motor A hold
        say "The held input left its measured angle or speed guard. Reset."
        stop all
    wait 0.05 seconds
