# VectorSum — two-input differential mixer and geared output dial
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 CrispStrobe
# Finite one-cycle experiment for models/vectorsum.ldr.
# Reload/reset the model to its saved pose before Run. Motors A and B must both begin within 3 degrees of zero.
# Positive motor encoder signs are defined by the saved motor matrices; the analytical common-axis coordinates are sideA=-A and sideB=+B.
# Programmed checkpoints: (A,B) = (0,0) -> (180,0) -> (180,-180) -> (180,180) -> (0,180) -> (0,0).
# Speeds are degrees per second. Encoder targets are absolute fresh unwrapped angles.
# Manual guidance is -190 to 190 degrees on each motor; these software bounds are not physical stops.
DEVICE SPIKE
GLOBAL targetA = 0
GLOBAL targetB = 0
GLOBAL speedA = 36
GLOBAL speedB = 36
GLOBAL phase = 0
GLOBAL done = 0
GLOBAL fault = 0
WHEN flag clicked:
  set targetA to 0
  set targetB to 0
  set speedA to 36
  set speedB to 36
  set phase to 0
  set done to 0
  set fault to 0
  IF (lab status) = "no-model" THEN:
    set fault to 1
    say "Load VectorSum and reset its saved pose before running."
    stop all
  lab start
  IF (abs of (lab motor A angle)) > 3 THEN:
    set fault to 1
    broadcast "VectorSum fault" and wait
    stop all
  IF (abs of (lab motor B angle)) > 3 THEN:
    set fault to 1
    broadcast "VectorSum fault" and wait
    stop all
  lab stop motor A hold
  lab stop motor B hold
  reset timer
  broadcast "VectorSum watchdog"
  wait 0.25 seconds
  set phase to 1
  set targetA to 180
  broadcast "VectorSum move A" and wait
  wait 0.6 seconds
  set phase to 2
  set targetB to -180
  broadcast "VectorSum move B" and wait
  wait 0.6 seconds
  set phase to 3
  set targetB to 180
  broadcast "VectorSum move B" and wait
  wait 0.6 seconds
  set phase to 4
  set targetA to 0
  broadcast "VectorSum move A" and wait
  wait 0.6 seconds
  set phase to 5
  set targetB to 0
  broadcast "VectorSum move B" and wait
  lab stop motor A hold
  lab stop motor B hold
  wait 0.25 seconds
  IF (abs of (targetA - (lab motor A angle))) > 3 THEN:
    set fault to 1
    broadcast "VectorSum fault" and wait
    stop all
  IF (abs of (targetB - (lab motor B angle))) > 3 THEN:
    set fault to 1
    broadcast "VectorSum fault" and wait
    stop all
  set phase to 99
  set done to 1
  say "VectorSum cycle complete. Compare the red carrier and orange pointer, then reset before repeating."
WHEN I receive "VectorSum move A":
  lab run motor A for (targetA - (lab motor A angle)) degrees at speedA degrees per second
  lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 3 THEN:
    lab run motor A for (targetA - (lab motor A angle)) degrees at 12 degrees per second
    lab stop motor A hold
  IF (abs of (targetA - (lab motor A angle))) > 3 THEN:
    set fault to 1
    broadcast "VectorSum fault" and wait
    stop all
WHEN I receive "VectorSum move B":
  lab run motor B for (targetB - (lab motor B angle)) degrees at speedB degrees per second
  lab stop motor B hold
  IF (abs of (targetB - (lab motor B angle))) > 3 THEN:
    lab run motor B for (targetB - (lab motor B angle)) degrees at 12 degrees per second
    lab stop motor B hold
  IF (abs of (targetB - (lab motor B angle))) > 3 THEN:
    set fault to 1
    broadcast "VectorSum fault" and wait
    stop all
WHEN I receive "VectorSum fault":
  lab stop motor A brake
  lab stop motor B brake
  say "A motor missed its permitted pose or time. Inspect both side axles and the differential, then reload the saved model."
WHEN I receive "VectorSum watchdog":
  REPEAT UNTIL (done = 1):
    IF (timer) > 55 THEN:
      set fault to 1
      broadcast "VectorSum fault" and wait
      stop all
    wait 0.05 seconds
