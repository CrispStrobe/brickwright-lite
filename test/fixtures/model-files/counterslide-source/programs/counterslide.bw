# CounterSlide — approach, dwell, release and verify home.
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 CrispStrobe
# Model: counterslide.ldr. Load/reset to the saved open-jaw datum first.
# A is the only motor. Negative A closes both jaws simultaneously.
# The two 8T-to-rack couplings each have magnitude 4 mm/radian; the
# opposite rack axes make negative encoder A close both jaws.
# Commands use fresh unwrapped motor feedback; speeds are degrees/second.
# Intended lane A=-100..0 deg; hold/release is not a physical hard stop.
DEVICE SPIKE

WHEN flag clicked:
  lab start
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of (0 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  lab run motor A for (-100 - (lab motor A angle)) degrees at 15 degrees per second
  lab stop motor A hold
  IF (abs of (-100 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  wait 1 seconds
  IF (abs of (-100 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  lab run motor A for (0 - (lab motor A angle)) degrees at 15 degrees per second
  lab stop motor A hold
  IF (abs of (0 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  wait 1 seconds
  lab stop motor A hold
