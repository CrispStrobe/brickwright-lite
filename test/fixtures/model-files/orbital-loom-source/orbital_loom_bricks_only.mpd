0 FILE orbital_loom.ldr
0 ORBITAL LOOM / two-motor epicycle drawing machine / v1.0
0 Name: orbital_loom.ldr
0 Author: OpenAI
0 !LDRAW_ORG Unofficial_Model
0 !LICENSE Licensed under CC BY 4.0 : see README.txt
0 // Original digital prototype; not physically built or tested.
0 // One SPIKE Prime hub, two medium angular motors, no sensors.
0 // See README.txt before assembly and first operation.
0 // Decorative non-LEGO references are the final assembly step.
0 // Plate is half a stud offset in X and Z for legal stud-pin alignment.
0 // Platter is parked +3 degrees to mesh the gears with a zero-phase drive axle.
0 // Build the bearing base.
1 16 0 0 0 1 0 0 0 1 0 0 0 1 01_base.ldr
0 STEP
0 // Add motor A and gear reduction.
1 16 0 0 0 1 0 0 0 1 0 0 0 1 02_table_drive.ldr
0 STEP
0 // Build and brace the gantry.
1 16 0 0 0 1 0 0 0 1 0 0 0 1 03_gantry.ldr
0 STEP
0 // Fit motor B.
1 16 0 0 0 1 0 0 0 1 0 0 0 1 04_pen_motor.ldr
0 STEP
0 // Attach the hub and route leads.
1 16 0 0 0 1 0 0 0 1 0 0 0 1 05_hub.ldr
0 STEP
1 16 0 -70 0 0.99862953 0 0.05233596 0 1 0 -0.05233596 0 0.99862953 06_platter.ldr
0 STEP
1 16 80 -460 0 0 0 1 0 1 0 -1 0 0 07_pen_holder.ldr
0 STEP
0 // NON-LEGO references: paper, 120 mm x 8 mm marker, two elastic loops.
