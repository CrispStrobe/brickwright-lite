DEVICE SPIKE
# BEND RIPPLE — vary one Cardan bend and observe the passive shaft phase.
# Copyright (c) 2026 CrispStrobe. SPDX-License-Identifier: BSD-3-Clause.
# Open the matching bend-ripple.ldr, choose Mat > Plain, Reset, then Run.
# A turns the input shaft. B bends the real output carrier. The output shaft is passive.
# An arrived flag marks a held comparison interval; passive output is observed independently.
# Construction, compiler, native, browser and hardware outcomes have separate receipts.
GLOBAL LIST motorATargets = [0, 360, 405, 405, 765, 405, 405, 0]
GLOBAL LIST motorBTargets = [0, 0, 0, 20, 20, 20, 0, 0]
GLOBAL LIST motorACaps = [0, 24, 24, 0, 24, 24, 0, 24]
GLOBAL LIST motorBCaps = [0, 0, 0, 4, 0, 0, 4, 0]
GLOBAL LIST inputAngleTargets = [0, 360, 405, 405, 765, 405, 405, 0]
GLOBAL LIST bendTargets = [10, 10, 10, 30, 30, 30, 10, 10]
GLOBAL LIST movingMasks = [0, 1, 1, 2, 1, 1, 2, 1]
WHEN flag clicked:
  set directionA to 1
  set directionB to 1
  set routeIndex to 1
  set stage to 0
  set arrived to 0
  set arrivedA to 0
  set arrivedB to 0
  set inputReady to 0
  set completed to 0
  set failed to 0
  set movingMask to 0
  set targetA to 0
  set targetB to 0
  set capA to 0
  set capB to 0
  set inputTargetAngleDeg to 0
  set bendTargetDeg to 10
  set correctionsA to 0
  set distanceA to 0
  set profilePeakA to 0
  set profileDurationA to 0
  set profileBrakeDistanceA to 0
  set profileRemainingA to 0
  set profileBrakeSpeedA to 0
  set profileDeadlineA to 0
  set profileStartedA to 0
  set profileElapsedA to 0
  set profileSpeedA to 0
  set trimStartedA to 0
  set correctionsB to 0
  set distanceB to 0
  set profilePeakB to 0
  set profileDurationB to 0
  set profileBrakeDistanceB to 0
  set profileRemainingB to 0
  set profileBrakeSpeedB to 0
  set profileDeadlineB to 0
  set profileStartedB to 0
  set profileElapsedB to 0
  set profileSpeedB to 0
  set trimStartedB to 0
  set profileDirectionA to 1
  set trimDirectionA to 1
  set profileDirectionB to 1
  set trimDirectionB to 1
  lab stop motor A hold
  lab stop motor B hold
  if (lab status) = "no-model" or (lab status) = "not-open" then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    lab stop motor B hold
    say "Open the matching Bend Ripple model and Reset before Run."
    stop all
  if (abs of (lab motor A angle)) > 1 or (abs of (lab motor B angle)) > 1 then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    lab stop motor B hold
    say "Fresh datum guard: Reset the matching model before retrying."
    stop all
  if not (length of motorATargets) = 8 or not (length of motorBTargets) = 8 or not (length of motorACaps) = 8 or not (length of motorBCaps) = 8 or not (length of inputAngleTargets) = 8 or not (length of bendTargets) = 8 or not (length of movingMasks) = 8 then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    lab stop motor B hold
    say "The finite route lists must each contain eight values. Reload the matching program."
    stop all
  reset timer
  broadcast "Bend Ripple watchdog"
  repeat 8:
    set arrived to 0
    set arrivedA to 0
    set arrivedB to 0
    set inputReady to 0
    set stage to (routeIndex - 1)
    set targetA to (item routeIndex of motorATargets)
    set targetB to (item routeIndex of motorBTargets)
    set capA to (item routeIndex of motorACaps)
    set capB to (item routeIndex of motorBCaps)
    set inputTargetAngleDeg to (item routeIndex of inputAngleTargets)
    set bendTargetDeg to (item routeIndex of bendTargets)
    set movingMask to (item routeIndex of movingMasks)
    broadcast "Bend Ripple move" and wait
    if failed = 1 or arrivedA = 0 or arrivedB = 0 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      lab stop motor B hold
      say "A joined move did not establish both input arrivals. Reset."
      stop all
    if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 or (abs of ((lab motor B angle) - targetB)) > 0.5 or (abs of (lab motor B speed)) > 0.5 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      lab stop motor B hold
      say "An input is outside its measured angle or speed arrival guard. Reset."
      stop all
    set inputReady to 1
    set movingMask to 0
    set arrived to 1
    wait 2 seconds
    if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 or (abs of ((lab motor B angle) - targetB)) > 0.5 or (abs of (lab motor B speed)) > 0.5 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      lab stop motor B hold
      say "An input moved outside the comparison window. Reset."
      stop all
    set arrived to 0
    set inputReady to 0
    change routeIndex by 1
  set stage to 8
  set movingMask to 0
  set completed to 1
  say "Complete: compare low and high bend ripple, then output motion while the input shaft held. Both inputs hold."

WHEN I receive "Bend Ripple move":
  set arrivedA to 0
  set correctionsA to 0
  if capA > 0 and (abs of (targetA - (lab motor A angle))) > 0.15 then:
    set distanceA to (abs of (targetA - (lab motor A angle)))
    set profileDirectionA to 1
    if targetA < (lab motor A angle) then:
      set profileDirectionA to -1
    set profilePeakA to capA
    if (profilePeakA * 2) > distanceA then:
      set profilePeakA to (distanceA / 2)
    set profileDurationA to ((distanceA / profilePeakA) + 2)
    set profileBrakeDistanceA to ((profilePeakA * 2) / 2)
    set profileDeadlineA to ((2 * profileDurationA) + (2 * 2))
    set profileStartedA to timer
    repeat until ((targetA - (lab motor A angle)) * profileDirectionA) <= 0.15 or (timer - profileStartedA) >= profileDeadlineA:
      set profileElapsedA to (timer - profileStartedA)
      if profileElapsedA < 0 then:
        set profileElapsedA to 0
      if profileElapsedA > profileDeadlineA then:
        set profileElapsedA to profileDeadlineA
      set profileRemainingA to ((targetA - (lab motor A angle)) * profileDirectionA)
      if profileRemainingA < 0 then:
        set profileRemainingA to 0
      set profileSpeedA to profilePeakA
      if profileElapsedA < 2 then:
        set profileSpeedA to ((profilePeakA * (1 - (cos of ((180 * profileElapsedA) / 2)))) / 2)
      set profileBrakeSpeedA to (profilePeakA * (sqrt of (profileRemainingA / profileBrakeDistanceA)))
      if profileBrakeSpeedA < profileSpeedA then:
        set profileSpeedA to profileBrakeSpeedA
      lab run motor A at (profileDirectionA * profileSpeedA) degrees per second
      wait 0.05 seconds
    lab stop motor A hold
    if (timer - profileStartedA) >= profileDeadlineA and ((targetA - (lab motor A angle)) * profileDirectionA) > 0.15 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      lab stop motor B hold
      say "Motor A exceeded its finite main capture deadline. Reset."
      stop all
  else:
    lab stop motor A hold
  wait 1 seconds
  repeat 3:
    if (abs of (targetA - (lab motor A angle))) > 0.2 then:
      change correctionsA by 1
      set trimDirectionA to 1
      if targetA < (lab motor A angle) then:
        set trimDirectionA to -1
      set trimStartedA to timer
      lab run motor A at (trimDirectionA * 0.5) degrees per second
      repeat until ((targetA - (lab motor A angle)) * trimDirectionA) <= 0.15 or (timer - trimStartedA) >= 3:
        wait 0.05 seconds
      lab stop motor A hold
      if (timer - trimStartedA) >= 3 and ((targetA - (lab motor A angle)) * trimDirectionA) > 0.15 then:
        set failed to 1
        set arrived to 0
        set inputReady to 0
        lab stop motor A hold
        lab stop motor B hold
        say "Motor A exceeded its bounded correction time. Reset."
        stop all
      wait 1 seconds
  if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    lab stop motor B hold
    say "Motor A failed the measured arrival guard. Reset."
    stop all
  set arrivedA to 1

WHEN I receive "Bend Ripple move":
  set arrivedB to 0
  set correctionsB to 0
  if capB > 0 and (abs of (targetB - (lab motor B angle))) > 0.15 then:
    set distanceB to (abs of (targetB - (lab motor B angle)))
    set profileDirectionB to 1
    if targetB < (lab motor B angle) then:
      set profileDirectionB to -1
    set profilePeakB to capB
    if (profilePeakB * 2) > distanceB then:
      set profilePeakB to (distanceB / 2)
    set profileDurationB to ((distanceB / profilePeakB) + 2)
    set profileBrakeDistanceB to ((profilePeakB * 2) / 2)
    set profileDeadlineB to ((2 * profileDurationB) + (2 * 2))
    set profileStartedB to timer
    repeat until ((targetB - (lab motor B angle)) * profileDirectionB) <= 0.15 or (timer - profileStartedB) >= profileDeadlineB:
      set profileElapsedB to (timer - profileStartedB)
      if profileElapsedB < 0 then:
        set profileElapsedB to 0
      if profileElapsedB > profileDeadlineB then:
        set profileElapsedB to profileDeadlineB
      set profileRemainingB to ((targetB - (lab motor B angle)) * profileDirectionB)
      if profileRemainingB < 0 then:
        set profileRemainingB to 0
      set profileSpeedB to profilePeakB
      if profileElapsedB < 2 then:
        set profileSpeedB to ((profilePeakB * (1 - (cos of ((180 * profileElapsedB) / 2)))) / 2)
      set profileBrakeSpeedB to (profilePeakB * (sqrt of (profileRemainingB / profileBrakeDistanceB)))
      if profileBrakeSpeedB < profileSpeedB then:
        set profileSpeedB to profileBrakeSpeedB
      lab run motor B at (profileDirectionB * profileSpeedB) degrees per second
      wait 0.05 seconds
    lab stop motor B hold
    if (timer - profileStartedB) >= profileDeadlineB and ((targetB - (lab motor B angle)) * profileDirectionB) > 0.15 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      lab stop motor B hold
      say "Motor B exceeded its finite main capture deadline. Reset."
      stop all
  else:
    lab stop motor B hold
  wait 1 seconds
  repeat 3:
    if (abs of (targetB - (lab motor B angle))) > 0.2 then:
      change correctionsB by 1
      set trimDirectionB to 1
      if targetB < (lab motor B angle) then:
        set trimDirectionB to -1
      set trimStartedB to timer
      lab run motor B at (trimDirectionB * 0.5) degrees per second
      repeat until ((targetB - (lab motor B angle)) * trimDirectionB) <= 0.15 or (timer - trimStartedB) >= 3:
        wait 0.05 seconds
      lab stop motor B hold
      if (timer - trimStartedB) >= 3 and ((targetB - (lab motor B angle)) * trimDirectionB) > 0.15 then:
        set failed to 1
        set arrived to 0
        set inputReady to 0
        lab stop motor A hold
        lab stop motor B hold
        say "Motor B exceeded its bounded correction time. Reset."
        stop all
      wait 1 seconds
  if (abs of ((lab motor B angle) - targetB)) > 0.5 or (abs of (lab motor B speed)) > 0.5 then:
    set failed to 1
    set arrived to 0
    set inputReady to 0
    lab stop motor A hold
    lab stop motor B hold
    say "Motor B failed the measured arrival guard. Reset."
    stop all
  set arrivedB to 1

WHEN I receive "Bend Ripple watchdog":
  repeat until completed = 1 or failed = 1:
    if timer > 360 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      lab stop motor B hold
      say "360 second watchdog: both inputs held. Reset before retrying."
      stop all
    if (((lab motor A angle) * directionA * 1) + 0) < -1 or (((lab motor A angle) * directionA * 1) + 0) > 766 or (((lab motor B angle) * directionB * 1) + 10) < 9 or (((lab motor B angle) * directionB * 1) + 10) > 31 then:
      set failed to 1
      set arrived to 0
      set inputReady to 0
      lab stop motor A hold
      lab stop motor B hold
      say "An input exceeded its declared software envelope. Reset."
      stop all
    if inputReady = 1 then:
      if (abs of ((lab motor A angle) - targetA)) > 0.5 or (abs of (lab motor A speed)) > 0.5 or (abs of ((lab motor B angle) - targetB)) > 0.5 or (abs of (lab motor B speed)) > 0.5 then:
        set failed to 1
        set arrived to 0
        set inputReady to 0
        lab stop motor A hold
        lab stop motor B hold
        say "A held comparison input left its measured angle or speed guard. Reset."
        stop all
    wait 0.05 seconds
