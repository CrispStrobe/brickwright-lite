# Final Squeeze — one motor, equal-link knee, passive guided platen and stock shock load.
# Copyright (c) 2026 Christian Ströbele (CrispStrobe). SPDX-License-Identifier: BSD-3-Clause.
# Load the matching saved model before every run. The input encoder is not reset.
# Input angle sweeps 40 to 15 degrees and returns; it never approaches or crosses zero.
# Encoder feedback sets a bounded speed and captures hold before a finite-move brake handoff.
# Angles below are motor input targets. No passive output position or force is assigned.
# The output spring must be installed with the saved preload before starting.
# Stage 1–11 are finite waypoints; stage 12 is completed; -1 is a fault.
DEVICE SPIKE
GLOBAL stage = 0
GLOBAL controlSpeed = 0
GLOBAL targetA = 0
GLOBAL settled = 0
GLOBAL completed = 0
GLOBAL fault = 0
GLOBAL trims = 0

WHEN flag clicked:
  set stage to 0
  set settled to 0
  set completed to 0
  set fault to 0
  reset timer
  lab stop motor A hold
  lab start
  # Unpowered, the preloaded shock back-drives the input about 1.4 degrees; stage 1 drives to 0.
  IF (abs of (lab motor A angle)) > 2 THEN:
    broadcast "Final Squeeze fault" and wait
    say "Load Final Squeeze at its saved starting pose before running."
    stop all
  broadcast "Final Squeeze watchdog"
  wait 0.2 seconds
  # press-40deg: physical knee angle 40 degrees.
  set settled to 0
  set stage to 1
  set targetA to 0
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # press-35deg: physical knee angle 35 degrees.
  set settled to 0
  set stage to 2
  set targetA to 5
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # press-30deg: physical knee angle 30 degrees.
  set settled to 0
  set stage to 3
  set targetA to 10
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # press-25deg: physical knee angle 25 degrees.
  set settled to 0
  set stage to 4
  set targetA to 15
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # press-20deg: physical knee angle 20 degrees.
  set settled to 0
  set stage to 5
  set targetA to 20
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # press-15deg: physical knee angle 15 degrees.
  set settled to 0
  set stage to 6
  set targetA to 25
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # return-20deg: physical knee angle 20 degrees.
  set settled to 0
  set stage to 7
  set targetA to 20
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # return-25deg: physical knee angle 25 degrees.
  set settled to 0
  set stage to 8
  set targetA to 15
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # return-30deg: physical knee angle 30 degrees.
  set settled to 0
  set stage to 9
  set targetA to 10
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # return-35deg: physical knee angle 35 degrees.
  set settled to 0
  set stage to 10
  set targetA to 5
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  # return-40deg: physical knee angle 40 degrees.
  set settled to 0
  set stage to 11
  set targetA to 0
  broadcast "Final Squeeze move" and wait
  wait 0.6 seconds
  broadcast "Final Squeeze arrival" and wait
  set settled to 1
  wait 0.5 seconds
  set settled to 0
  lab stop motor A hold
  wait 1 seconds
  broadcast "Final Squeeze arrival" and wait
  set stage to 12
  set completed to 1
  say "Final Squeeze complete: the platen pressed, released and returned home."

WHEN I receive "Final Squeeze move":
  set trims to 0
  broadcast "Final Squeeze approach" and wait
  REPEAT 2:
    IF (abs of (targetA - (lab motor A angle))) > 0.15 THEN:
      change trims by 1
      broadcast "Final Squeeze approach" and wait
  broadcast "Final Squeeze arrival" and wait

WHEN I receive "Final Squeeze approach":
  REPEAT UNTIL (abs of (targetA - (lab motor A angle))) < 0.15:
    set controlSpeed to (4 * (targetA - (lab motor A angle)))
    IF (controlSpeed) > 8 THEN:
      set controlSpeed to 8
    IF (controlSpeed) < -8 THEN:
      set controlSpeed to -8
    lab run motor A at controlSpeed degrees per second
    wait 0.01 seconds
  lab stop motor A hold
  wait 0.2 seconds

WHEN I receive "Final Squeeze arrival":
  IF (abs of (targetA - (lab motor A angle))) > 0.4 THEN:
    broadcast "Final Squeeze fault" and wait
    say "Input missed its target. Inspect the mechanism and reload the saved model."
    stop all

WHEN I receive "Final Squeeze fault":
  set fault to 1
  set stage to -1
  set settled to 0
  lab stop motor A hold

WHEN I receive "Final Squeeze watchdog":
  REPEAT UNTIL (completed = 1):
    IF (timer) > 60 THEN:
      broadcast "Final Squeeze fault" and wait
      say "Final Squeeze timed out. Inspect and reload the saved model."
      stop all
    wait 0.1 seconds
