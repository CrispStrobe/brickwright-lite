# ParityDial — one motor, two clock hands with opposite directions.
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 CrispStrobe
# Reset model to the delivered encoder-0 datum before starting.
# The +90, -90, 0 degree route is finite and uses fresh angle feedback.
# No physical hard stop is asserted; use port A and the Plain mat.
DEVICE SPIKE

WHEN flag clicked:
  lab start
  lab stop motor A hold
  wait 0.5 seconds
  IF (abs of (0 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  lab run motor A for (90 - (lab motor A angle)) degrees at 15 degrees per second
  lab stop motor A hold
  IF (abs of (90 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  wait 0.8 seconds
  lab run motor A for (-90 - (lab motor A angle)) degrees at 15 degrees per second
  lab stop motor A hold
  IF (abs of (-90 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  wait 0.8 seconds
  lab run motor A for (0 - (lab motor A angle)) degrees at 15 degrees per second
  lab stop motor A hold
  IF (abs of (0 - (lab motor A angle))) > 2 THEN:
    lab stop motor A hold
    stop all
  wait 0.5 seconds
  lab stop motor A hold
