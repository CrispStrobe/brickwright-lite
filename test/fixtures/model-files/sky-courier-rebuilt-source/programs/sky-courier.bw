# Sky Courier — two-winch suspended gondola demonstration
# Author: CrispStrobe
# SPDX-License-Identifier: BSD-3-Clause
# Requires sky-courier-native.ldr open in Robot Lab, then reset the simulation.
# Native drum radius 7 LDU; 24:1 worm drives; A = left, B = right.
# This uses Robot Lab words; real cord radius and winding must be calibrated separately.

WHEN flag clicked:
  set stage to "startup"
  set done to 0
  set fault to 0
  set targetA to 0
  set targetB to 0
  lab stop motor A coast
  lab stop motor B coast
  wait 2 seconds
  IF abs of ((lab motor A angle) - targetA) > 2 THEN:
    set fault to 1
    say "Motor A encoder missed target"
    stop all
  IF abs of ((lab motor B angle) - targetB) > 2 THEN:
    set fault to 1
    say "Motor B encoder missed target"
    stop all
  set stage to "top:move"
  set targetA to 8926.661253
  set targetB to 8926.661253
  broadcast "move both winches" and wait
  set stage to "top:settle"
  wait 2.5 seconds
  IF abs of ((lab motor A angle) - targetA) > 2 THEN:
    set fault to 1
    say "Motor A encoder missed target"
    stop all
  IF abs of ((lab motor B angle) - targetB) > 2 THEN:
    set fault to 1
    say "Motor B encoder missed target"
    stop all
  set stage to "left:move"
  set targetA to 10415.040696
  set targetB to -2248.920907
  broadcast "move both winches" and wait
  set stage to "left:settle"
  wait 2.5 seconds
  IF abs of ((lab motor A angle) - targetA) > 2 THEN:
    set fault to 1
    say "Motor A encoder missed target"
    stop all
  IF abs of ((lab motor B angle) - targetB) > 2 THEN:
    set fault to 1
    say "Motor B encoder missed target"
    stop all
  set stage to "right:move"
  set targetA to -2248.920907
  set targetB to 10415.040696
  broadcast "move both winches" and wait
  set stage to "right:settle"
  wait 2.5 seconds
  IF abs of ((lab motor A angle) - targetA) > 2 THEN:
    set fault to 1
    say "Motor A encoder missed target"
    stop all
  IF abs of ((lab motor B angle) - targetB) > 2 THEN:
    set fault to 1
    say "Motor B encoder missed target"
    stop all
  set stage to "home:move"
  set targetA to 0
  set targetB to 0
  broadcast "move both winches" and wait
  set stage to "home:settle"
  wait 2.5 seconds
  IF abs of ((lab motor A angle) - targetA) > 2 THEN:
    set fault to 1
    say "Motor A encoder missed target"
    stop all
  IF abs of ((lab motor B angle) - targetB) > 2 THEN:
    set fault to 1
    say "Motor B encoder missed target"
    stop all
  set stage to "complete"
  set done to 1
  say "Sky Courier complete"
  stop all

WHEN I receive "move both winches":
  lab run motor A for (targetA - (lab motor A angle)) degrees at 360 degrees per second
  lab stop motor A coast
  IF abs of ((lab motor A angle) - targetA) > 2 THEN:
    set fault to 1
    say "Motor A encoder missed target"
    stop all

WHEN I receive "move both winches":
  lab run motor B for (targetB - (lab motor B angle)) degrees at 360 degrees per second
  lab stop motor B coast
  IF abs of ((lab motor B angle) - targetB) > 2 THEN:
    set fault to 1
    say "Motor B encoder missed target"
    stop all

# Independent finite watchdog: a stalled encoder wait cannot run forever.
WHEN flag clicked:
  wait 180 seconds
  IF done = 0 THEN:
    lab stop motor A coast
    lab stop motor B coast
    set fault to 1
    say "Sky Courier timeout"
    stop all
